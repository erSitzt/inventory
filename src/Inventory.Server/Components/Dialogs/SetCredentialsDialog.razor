@inject IStringLocalizer<SharedResource> L

@* Zugangsdaten für mehrere Rechner auf einmal; leer = wieder die Standard-Zugangsdaten. *@
<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudSelect T="int?" @bind-Value="_credentialId" Label="@L["Credentials"]" Variant="Variant.Outlined" Clearable="true"
                       Placeholder="@(Default is { } fallback ? L["Default: {0} ({1})", fallback.Name, fallback.Username] : L["Default"])">
                @foreach (var credential in Credentials)
                {
                    <MudSelectItem T="int?" Value="@credential.Id">@credential.Name (@credential.Username)</MudSelectItem>
                }
            </MudSelect>
            <MudText Typo="Typo.body2">
                @L["Applies to {0} computers for scans, deployments and commands. Empty = the default credentials.", Count]
                @if (WithOwn > 0)
                {
                    @(" " + L["{0} of them have their own credentials so far.", WithOwn])
                }
            </MudText>
            @if (Credentials.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true">
                    @L["No credentials stored yet."] <MudLink Href="credentials">@L["Edit credentials"]</MudLink>
                </MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => MudDialog.Close(DialogResult.Ok(_credentialId)))">@L["Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public List<Credential> Credentials { get; set; } = [];
    /// <summary>Anzahl der gewählten Rechner.</summary>
    [Parameter] public int Count { get; set; }
    /// <summary>So viele davon haben bisher eigene Zugangsdaten.</summary>
    [Parameter] public int WithOwn { get; set; }

    private Credential? Default => Credentials.FirstOrDefault(c => c.IsDefault);
    private int? _credentialId;
}
