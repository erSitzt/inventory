@inject CatalogService Catalog
@inject IStringLocalizer<SharedResource> L

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.body2">
                <b>@Entry.Name</b> @L["by {0}", Entry.Publisher ?? L["unknown publisher"]]
                @if (!string.IsNullOrWhiteSpace(Entry.License))
                {
                    <span> · @L["License: {0}", Entry.License]</span>
                }
            </MudText>
            @if (Catalog.VersionsAvailable)
            {
                <MudSelect T="string" Label="@L["Version"]" Value="_selected.Version" ValueChanged="Select" Variant="Variant.Outlined" Margin="Margin.Dense"
                           Disabled="_loading" HelperText="@(_loading ? L["Loading versions …"].Value : _versionError)">
                    @foreach (var version in _versions)
                    {
                        <MudSelectItem Value="version.Version" Disabled="@(OlderOnly && version.Version == Entry.Version)">
                            @version.Version@(version.Version == Entry.Version ? $" ({L["current"]})" : "")@(version.ReleaseDate is null ? "" : $" – {version.ReleaseDate}")
                        </MudSelectItem>
                    }
                </MudSelect>
            }
            else
            {
                <MudText Typo="Typo.body2">@L["Version"] @Entry.Version</MudText>
            }
            <MudText Typo="Typo.caption" Style="word-break: break-all">Download: @_selected.Url</MudText>
            <MudText Typo="Typo.caption">@L["Installation:"] @(_selected.InstallerType is "wix" or "msi" ? L["MSI, silently via /qn /norestart"] : L["Setup"]) @_selected.Arguments</MudText>
            @if (Pinned)
            {
                <MudAlert Severity="Severity.Info" Dense="true">
                    @L["Fixed version: a separate package \"{0}\" is created that is never updated automatically. Vendors sometimes remove older setups from their servers; then the download fails. Older versions usually also contain known security vulnerabilities.", $"{_selected.Name} {_selected.Version}"]
                </MudAlert>
            }
            @if (_selected.Scope == "user")
            {
                <MudAlert Severity="Severity.Info" Dense="true">
                    @L["This setup installs into the user profile only. The step therefore runs in the context of the logged-on user and needs a logged-on session on the target computer."]
                </MudAlert>
            }
            @if (!Curated)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">
                    @L["Entry from the winget search, not from the base selection: test the silent parameters on a single computer before deploying."]
                </MudAlert>
            }
            @if (!Pinned)
            {
                <MudCheckBox T="bool" @bind-Value="_autoUpdate" Dense="true" Label="@L["Adopt new versions automatically"]" />
            }
            <MudCheckBox T="bool" @bind-Value="_createCollection" Dense="true"
                         Label="@L["Create dynamic collection \"{0} outdated\" (computers with an older version)", PackageName]" />
            <MudText Typo="Typo.caption">
                @L["Please observe the vendor's license terms; the library only refers to the vendor's download."]
            </MudText>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(OlderOnly && !Pinned)"
                   OnClick="@(() => MudDialog.Close(DialogResult.Ok(new Choice(!Pinned && _autoUpdate, _createCollection, Pinned ? _selected.Version : null))))">@L["Import"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <param name="Version">Die gewählte ältere Version; null = die aktuelle.</param>
    public sealed record Choice(bool AutoUpdate, bool CreateCollection, string? Version);

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public Inventory.Core.Abstractions.CatalogEntry Entry { get; set; } = default!;
    [Parameter] public bool Curated { get; set; } = true;

    /// <summary>true, wenn die aktuelle Version schon importiert ist und nur noch eine ältere dazukommen kann.</summary>
    [Parameter] public bool OlderOnly { get; set; }

    private List<Inventory.Core.Abstractions.CatalogEntry> _versions = [];
    private Inventory.Core.Abstractions.CatalogEntry _selected = default!;
    private bool _loading;
    private string? _versionError;
    private bool _autoUpdate = true;
    private bool _createCollection = true;

    private bool Pinned => _selected.Version != Entry.Version;
    private string PackageName => Pinned ? $"{_selected.Name} {_selected.Version}" : Entry.Name;

    protected override async Task OnInitializedAsync()
    {
        _selected = Entry;
        _versions = [Entry];
        _createCollection = !OlderOnly;
        if (!Catalog.VersionsAvailable)
            return;
        _loading = true;
        try
        {
            _versions = await Catalog.VersionsAsync(Entry.Id);
            if (_versions.Count == 1)
                _versionError = L["The winget repository only lists the current version."];
        }
        catch (Exception ex) when (ex is Inventory.Core.Abstractions.RemoteException or InvalidOperationException)
        {
            _versionError = L["Older versions could not be retrieved."];
        }
        finally
        {
            _loading = false;
        }
    }

    private void Select(string version) => _selected = _versions.FirstOrDefault(v => v.Version == version) ?? Entry;
}
