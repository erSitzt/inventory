@inject CredentialService CredentialService

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_valid">
            <MudStack Spacing="3">
                <MudTextField @bind-Value="_name" Label="Name" Variant="Variant.Outlined" Required="true" RequiredError="Name fehlt" AutoFocus="true" Immediate="true" />
                <MudTextField @bind-Value="_username" Label="Benutzer" Variant="Variant.Outlined" Required="true" RequiredError="Benutzer fehlt" Immediate="true"
                              HelperText="DOMÄNE\benutzer, benutzer@domäne oder .\benutzer für lokale Konten" />
                <MudTextField @bind-Value="_password" Label="Passwort" Variant="Variant.Outlined" InputType="InputType.Password" Immediate="true"
                              Required="@(Credential is null)" RequiredError="Passwort fehlt"
                              HelperText="@(Credential is null ? null : "Leer lassen, um das gespeicherte Passwort zu behalten")" />
                <MudTextField @bind-Value="_description" Label="Beschreibung" Variant="Variant.Outlined" />
                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error">@_error</MudAlert>
                }
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Abbrechen</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(!_valid)" OnClick="SaveAsync">Speichern</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    /// <summary>null = neue Zugangsdaten anlegen.</summary>
    [Parameter] public Credential? Credential { get; set; }

    private MudForm _form = default!;
    private bool _valid;
    private string _name = "";
    private string _username = "";
    private string _password = "";
    private string? _description;
    private string? _error;

    protected override void OnInitialized()
    {
        if (Credential is null)
            return;
        _name = Credential.Name;
        _username = Credential.Username;
        _description = Credential.Description;
        _valid = true;
    }

    private async Task SaveAsync()
    {
        try
        {
            await CredentialService.SaveAsync(Credential?.Id, _name, _username, _password, _description);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateException)
        {
            _error = $"Es gibt bereits Zugangsdaten mit dem Namen „{_name.Trim()}“.";
        }
    }
}
