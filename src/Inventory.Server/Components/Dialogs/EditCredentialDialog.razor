@inject CredentialService CredentialService
@inject Auditor Audit
@inject IStringLocalizer<SharedResource> L
@inject Access Access

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_valid">
            <MudStack Spacing="3">
                <MudTextField @bind-Value="_name" Label="@L["Name"]" Variant="Variant.Outlined" Required="true" RequiredError="@L["Name is missing"]" AutoFocus="true" Immediate="true" />
                <MudTextField @bind-Value="_username" Label="@L["User"]" Variant="Variant.Outlined" Required="true" RequiredError="@L["User is missing"]" Immediate="true"
                              HelperText="@L["DOMAIN\\user, user@domain or .\\user for local accounts"]" />
                <MudTextField @bind-Value="_password" Label="@L["Password"]" Variant="Variant.Outlined" InputType="InputType.Password" Immediate="true"
                              Required="@(Credential is null)" RequiredError="@L["Password is missing"]"
                              HelperText="@(Credential is null ? null : L["Leave empty to keep the stored password"].Value)" />
                <MudTextField @bind-Value="_description" Label="@L["Description"]" Variant="Variant.Outlined" />
                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error">@_error</MudAlert>
                }
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(!_valid)" OnClick="SaveAsync">@L["Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    /// <summary>null = neue Zugangsdaten anlegen.</summary>
    [Parameter] public Credential? Credential { get; set; }

    private MudForm _form = default!;
    private bool _valid;
    private string _name = "";
    private string _username = "";
    private string _password = "";
    private string? _description;
    private string? _error;

    protected override void OnInitialized()
    {
        if (Credential is null)
            return;
        _name = Credential.Name;
        _username = Credential.Username;
        _description = Credential.Description;
        _valid = true;
    }

    private async Task SaveAsync()
    {
        if (!await Access.DemandAdminAsync())
            return;
        try
        {
            await CredentialService.SaveAsync(Credential?.Id, _name, _username, _password, _description);
            await Audit.LogAsync(Credential is null ? L["Credentials created"] : L["Credentials changed"],
                $"{_name.Trim()} ({_username.Trim()})" + (Credential is not null && _password.Length > 0 ? ", " + L["password reset"] : ""));
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateException)
        {
            _error = L["Credentials named \"{0}\" already exist.", _name.Trim()];
        }
    }
}
