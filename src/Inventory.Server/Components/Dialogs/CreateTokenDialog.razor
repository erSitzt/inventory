<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_name" Label="Name" Variant="Variant.Outlined" AutoFocus="true" Immediate="true"
                          HelperText="Wofür das Token gedacht ist, z. B. „Monitoring“ oder „Paket-Upload“" />
            <MudSelect T="int?" @bind-Value="_days" Label="Gültigkeit" Variant="Variant.Outlined">
                <MudSelectItem T="int?" Value="30">30 Tage</MudSelectItem>
                <MudSelectItem T="int?" Value="90">90 Tage</MudSelectItem>
                <MudSelectItem T="int?" Value="365">1 Jahr</MudSelectItem>
                <MudSelectItem T="int?" Value="@((int?)null)">unbegrenzt</MudSelectItem>
            </MudSelect>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Abbrechen</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@string.IsNullOrWhiteSpace(_name)"
                   OnClick="@(() => MudDialog.Close(DialogResult.Ok(new Request(_name.Trim(), _days))))">Anlegen</MudButton>
    </DialogActions>
</MudDialog>

@code {
    public sealed record Request(string Name, int? Days);

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private string _name = "";
    private int? _days = 90;
}
