@inject PackageService PackageService
@inject Auditor Audit
@inject Display Display
@inject IStringLocalizer<SharedResource> L
@inject Access Access

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_step.Name" Label="@L["Step name"]" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" AutoFocus="true" />

            @if (Nested)
            {
                <MudSelect T="int?" @bind-Value="_nestedPackageId" Label="@L["Package"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                           HelperText="@L["The steps of the selected package run at this point; its files are copied along."]">
                    @foreach (var package in _packages)
                    {
                        <MudSelectItem T="int?" Value="@package.Id">@package.Name @package.Version</MudSelectItem>
                    }
                </MudSelect>
            }
            else
            {
                @switch (Type)
                {
                    case StepType.Command:
                        <MudTextField @bind-Value="_step.Script" Label="@L["Command"]" Variant="Variant.Outlined" Lines="3" Style="font-family: monospace" Immediate="true"
                                      HelperText="@CommandHelp" />
                        break;
                    case StepType.PowerShell:
                        <MudTextField @bind-Value="_step.Script" Label="@L["Script"]" Variant="Variant.Outlined" Lines="10" Style="font-family: monospace" Immediate="true"
                                      HelperText="@L["Windows PowerShell 5.1, 64 bit. The script's exit code (exit N) decides about success."]" />
                        break;
                    case StepType.Install:
                        <MudSelect T="string" Value="_step.File" ValueChanged="SelectInstallerAsync" Label="@L["Installer file"]" HelperText="@L["msi, msp, msu, exe, cmd/bat or ps1 from the package's files"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var option in FileOptions)
                            {
                                <MudSelectItem T="string" Value="option">@option@(Files.Contains(option) || Folders.Contains(option) ? "" : $" ({L["no longer present"]})")</MudSelectItem>
                            }
                        </MudSelect>
                        @if (FileOptions.Count == 0)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true">@L["The package has no files yet. Please upload under \"Files\" first."]</MudAlert>
                        }
                        @if (_suggestion is not null)
                        {
                            <MudAlert Severity="@(_suggestion.Known ? Severity.Info : Severity.Warning)" Dense="true">
                                <b>@L[_suggestion.Installer].</b> @L[_suggestion.Note]
                                @if (_suggestion.Arguments.Length > 0)
                                {
                                    <span> @L["Recommended silent parameters:"] <code>@_suggestion.Arguments</code></span>
                                    @if (_step.Arguments != _suggestion.Arguments)
                                    {
                                        <MudButton Size="Size.Small" Class="ml-2" OnClick="@(() => _step.Arguments = _suggestion.Arguments)">@L["Apply"]</MudButton>
                                    }
                                }
                            </MudAlert>
                        }
                        <MudTextField @bind-Value="_step.Arguments" Label="@L["Parameters"]" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                                      HelperText="@L["Passed to the installer. For recognized installers the silent parameters are already filled in."]" />
                        break;
                    case StepType.Uninstall:
                        <MudTextField @bind-Value="_step.SoftwareName" Label="@L["Program (name)"]" Placeholder="7-Zip" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                                      Disabled="@(!string.IsNullOrWhiteSpace(_step.ProductCode))"
                                      HelperText="@L["Name as shown in \"Programs and Features\". Without * it must occur as whole words, with * it is a pattern for the whole name."]" />
                        <MudTextField @bind-Value="_step.ProductCode" Label="@L["or MSI product code"]" Placeholder="{00000000-0000-0000-0000-000000000000}" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                        <MudTextField @bind-Value="_step.Arguments" Label="@L["Parameters"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      HelperText="@L["Usually empty: MSI, Inno Setup and NSIS setups and programs with a registered silent command are removed silently on their own. For other setups enter the parameters for a silent uninstall here."]" />
                        <MudAlert Severity="Severity.Info" Dense="true">@L["If the program is not installed, the step counts as done. If the name matches more than three programs, nothing is uninstalled and the step fails."]</MudAlert>
                        break;
                    case StepType.FileCopy:
                        <MudSwitch T="bool" Value="_externalSource" ValueChanged="SetExternalSource" Color="Color.Primary" Label="@L["Source outside the package (share or path on the computer)"]" />
                        @if (_externalSource)
                        {
                            <MudTextField @bind-Value="_step.SourcePath" Label="@L["Source path"]" Placeholder="\\\\fileserver\\software\\Product" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                                          HelperText="@L["File or folder. For very large payloads that should not pass through the server. The step reads with the account it runs under: via SMB + service or agent that is the computer account, which needs read access to the share."]" />
                        }
                        else
                        {
                            <MudSelect T="string" @bind-Value="_step.File" Label="@L["Source"]" HelperText="@L["File or folder from the package's files"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var option in FileOptions)
                                {
                                    <MudSelectItem T="string" Value="option">@option@(Files.Contains(option) || Folders.Contains(option) ? "" : $" ({L["no longer present"]})")</MudSelectItem>
                                }
                            </MudSelect>
                            @if (FileOptions.Count == 0)
                            {
                                <MudAlert Severity="Severity.Warning" Dense="true">@L["The package has no files yet. Please upload under \"Files\" first."]</MudAlert>
                            }
                        }
                        <MudTextField @bind-Value="_step.Destination" Label="@L["Destination on the computer"]" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                                      HelperText="@L["E.g. %ProgramData%\\Company\\ – a trailing \\ means folder. Existing files are overwritten."]" />
                        break;
                    case StepType.Registry:
                        <MudSelect T="RegistryAction" @bind-Value="_step.RegistryAction" Label="@L["Action"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var action in Enum.GetValues<RegistryAction>())
                            {
                                <MudSelectItem T="RegistryAction" Value="action">@Display.RegistryActionName(action)</MudSelectItem>
                            }
                        </MudSelect>
                        <MudTextField @bind-Value="_step.RegistryKey" Label="@L["Key"]" Placeholder="HKLM\\SOFTWARE\\Company\\Product" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                                      HelperText="@L["Starts with HKLM, HKCU, HKU or HKCR. HKCU needs \"Run as: Logged-on user\" and then means that user's settings. Missing keys are created."]" />
                        @if (_step.RegistryAction != RegistryAction.DeleteKey)
                        {
                            <MudTextField @bind-Value="_step.RegistryValueName" Label="@L["Value name"]" Variant="Variant.Outlined" Margin="Margin.Dense" HelperText="@L["Empty = the key's default value"]" />
                        }
                        @if (_step.RegistryAction == RegistryAction.SetValue)
                        {
                            <MudSelect T="RegistryDataType" @bind-Value="_step.RegistryDataType" Label="@L["Type"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var type in Enum.GetValues<RegistryDataType>())
                                {
                                    <MudSelectItem T="RegistryDataType" Value="type">@Display.RegistryTypeName(type)</MudSelectItem>
                                }
                            </MudSelect>
                            <MudTextField @bind-Value="_step.RegistryData" Label="@L["Data"]" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="@(_step.RegistryDataType == RegistryDataType.MultiString ? 3 : 1)"
                                          HelperText="@(_step.RegistryDataType switch
                                          {
                                              RegistryDataType.DWord or RegistryDataType.QWord => L["Decimal, or hexadecimal with 0x"],
                                              RegistryDataType.MultiString => L["One entry per line"],
                                              RegistryDataType.Binary => L["Hexadecimal, e.g. 01 0A FF"],
                                              _ => "",
                                          })" />
                        }
                        <MudCheckBox T="bool" @bind-Value="_step.Registry32Bit" Label="@L["32-bit view (WOW6432Node)"]" Dense="true" />
                        @if (_step.RegistryAction == RegistryAction.DeleteKey)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true">@L["Deletes the key with everything below it. Top-level branches such as HKCU\\Software or HKLM\\SOFTWARE\\Microsoft are refused."]</MudAlert>
                        }
                        break;
                    case StepType.RemoveApp:
                        <MudTextField @bind-Value="_step.AppName" Label="@L["Package name"]" Placeholder="Microsoft.BingWeather" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                                      HelperText="@L["Name as the computer's \"Apps\" tab shows it. * stands for any text, e.g. Microsoft.Xbox*."]" />
                        <MudSwitch T="bool" @bind-Value="_step.AppKeepProvisioned" Color="Color.Primary" Label="@L["Keep it provisioned for new users"]" />
                        <MudAlert Severity="Severity.Info" Dense="true">
                            @L["Removes the app for all users of the computer and, unless kept, also for users who log on later. Parts of Windows and runtime libraries are left alone. If the name matches more than {0} different apps, nothing is removed.", AppNames.MaxMatches]
                        </MudAlert>
                        break;
                    case StepType.WindowsFeature:
                        <MudTextField @bind-Value="_featureNames" Label="@L["Features"]" Placeholder="NetFx3, TelnetClient" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                                      HelperText="@L["Names as DISM lists them (dism /online /get-features), separated by commas."]" />
                        <MudSwitch T="bool" @bind-Value="_step.FeatureDisable" Color="Color.Primary" Label="@L["Turn the features off instead of on"]" />
                        <MudAlert Severity="Severity.Info" Dense="true">
                            @L["Turning on includes the features a feature depends on. Files Windows does not have locally come from the update source configured on the computer. The step does not restart the computer: add a \"Reboot\" step with the condition \"only if a restart is pending\" after it."]
                        </MudAlert>
                        break;
                    case StepType.Service:
                        <MudTextField @bind-Value="_step.ServiceName" Label="@L["Service name"]" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" HelperText="@L["Short name of the service, e.g. Spooler"]" />
                        <MudSelect T="ServiceAction" @bind-Value="_step.ServiceAction" Label="@L["Action"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var action in Enum.GetValues<ServiceAction>())
                            {
                                <MudSelectItem T="ServiceAction" Value="action">@Display.ServiceActionName(action)</MudSelectItem>
                            }
                        </MudSelect>
                        break;
                    case StepType.Sleep:
                        <MudNumericField T="int" @bind-Value="_step.Seconds" Label="@L["Wait time (seconds)"]" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="86400" />
                        break;
                    case StepType.Reboot:
                        <MudNumericField T="int" @bind-Value="_step.Seconds" Label="@L["Delay (seconds)"]" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="86400"
                                         HelperText="@L["At least 15 seconds, so that the result is stored before Windows shuts down."]" />
                        <MudTextField @bind-Value="_step.Script" Label="@L["Message for logged-on users"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudAlert Severity="Severity.Info" Dense="true">@L["Steps after the restart continue automatically once the computer is reachable again (within the wait time from the settings); the final inventory scan runs then as well. On computers with the agent, the agent continues by itself, also without a connection to the server."]</MudAlert>
                        break;
                    case StepType.WindowsUpdate:
                        <MudCheckBox T="bool" @bind-Value="_step.UpdateSecurityOnly" Label="@L["Only security and critical updates"]" Dense="true" Disabled="@(!string.IsNullOrWhiteSpace(_updateKbIds))" />
                        <MudCheckBox T="bool" @bind-Value="_step.UpdateIncludeDrivers" Label="@L["Also drivers offered by Windows Update"]" Dense="true" />
                        <MudTextField @bind-Value="_updateKbIds" Label="@L["Only these KB numbers"]" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Placeholder="KB5066835, KB5044284"
                                      HelperText="@L["Empty = everything the settings above allow. With KB numbers, only these updates are installed."]" />
                        <MudNumericField T="int" @bind-Value="_step.UpdateMaxCount" Label="@L["At most this many updates per run"]" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="500" HelperText="@L["0 = all"]" />
                        <MudAlert Severity="Severity.Info" Dense="true">
                            @L["Updates come from the source configured on the computer (WSUS or Microsoft Update). The step does not restart the computer: add a \"Reboot\" step with the condition \"only if a restart is pending\" after it. Works via SMB + service or agent, not over WinRM."]
                        </MudAlert>
                        break;
                    case StepType.InventoryScan:
                        <MudText Typo="Typo.body2">@L["Re-captures the computer's hardware and software, e.g. after an installation."]</MudText>
                        break;
                }

                @if (Display.SupportsRunAs(Type))
                {
                    <MudSelect T="StepRunAs" @bind-Value="_step.RunAs" Label="@L["Run as"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                               HelperText="@(_step.RunAs == StepRunAs.LoggedOnUser && Type == StepType.Registry
                                   ? L["Makes HKCU mean the settings of the logged-on user. The change itself is still written by the system account. If nobody is logged on, the step is skipped."]
                                   : _step.RunAs == StepRunAs.LoggedOnUser
                                   ? L["Runs in the logged-on user's session with their rights (HKCU, profile, network drives). If nobody is logged on, the step is skipped. Only via SMB + service or agent."]
                                   : L["Full rights on the computer, but no access to a user's profile and settings."])">
                        <MudSelectItem T="StepRunAs" Value="StepRunAs.System">@Display.RunAs(StepRunAs.System)</MudSelectItem>
                        <MudSelectItem T="StepRunAs" Value="StepRunAs.LoggedOnUser">@Display.RunAs(StepRunAs.LoggedOnUser)</MudSelectItem>
                    </MudSelect>
                }
                @if (Type is StepType.Command or StepType.PowerShell or StepType.Install or StepType.Uninstall)
                {
                    <MudStack Row="true" Spacing="3">
                        <MudTextField @bind-Value="_successCodes" Label="@L["Success exit codes"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Placeholder="@(Type is StepType.Install or StepType.Uninstall ? "0, 3010, 1641" : "0")" HelperText="@L["Comma-separated; empty = default"]" />
                        <MudNumericField T="int" @bind-Value="_step.TimeoutSeconds" Label="@L["Timeout (seconds)"]" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="86400" />
                    </MudStack>
                }
                <MudCheckBox T="bool" @bind-Value="_step.ContinueOnError" Label="@L["Continue with the next step on error"]" Dense="true" />

                <MudExpansionPanels Elevation="0" Outlined="true">
                    <MudExpansionPanel Text="@(_conditions.IsEmpty ? L["Conditions (none)"] : L["Conditions (active)"])">
                        <MudText Typo="Typo.body2" Class="mb-3">@L["The step only runs if all filled-in conditions apply. Otherwise it is skipped without counting as an error."]</MudText>
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="4">
                                <MudTextField @bind-Value="_conditions.MinOsVersion" Label="@L["Windows from version"]" Placeholder="10.0.22000" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudTextField @bind-Value="_conditions.BelowOsVersion" Label="@L["Windows below version"]" Placeholder="10.0.22000" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudSelect T="string" @bind-Value="_conditions.Architecture" Label="@L["Architecture"]" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Placeholder="@L["any"]">
                                    <MudSelectItem T="string" Value="@("x64")">64 Bit</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("x86")">32 Bit</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="_conditions.FileExists" Label="@L["File/folder exists"]" Placeholder="%ProgramFiles%\App\app.exe" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="_conditions.FileMissing" Label="@L["File/folder missing"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="_conditions.RegistryKeyExists" Label="@L["Registry key exists"]" Placeholder="HKLM\SOFTWARE\Company\Product" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="_conditions.RegistryKeyMissing" Label="@L["Registry key missing"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="_conditions.SoftwareInstalled" Label="@L["Program installed"]" Placeholder="7-Zip" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="_conditions.SoftwareMinVersion" Label="@L["Minimum version"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                              Disabled="@string.IsNullOrWhiteSpace(_conditions.SoftwareInstalled)" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="_conditions.SoftwareMissing" Label="@L["Program not installed"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="_conditions.MsiProductCode" Label="@L["MSI product code"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudSelect T="bool?" @bind-Value="_conditions.UserLoggedOn" Label="@L["User logged on"]" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Placeholder="@L["any"]">
                                    <MudSelectItem T="bool?" Value="true">@L["only if someone is logged on"]</MudSelectItem>
                                    <MudSelectItem T="bool?" Value="false">@L["only if nobody is logged on"]</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudSelect T="bool?" @bind-Value="_conditions.RebootPending" Label="@L["Restart pending"]" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Placeholder="@L["any"]">
                                    <MudSelectItem T="bool?" Value="true">@L["only if a restart is pending"]</MudSelectItem>
                                    <MudSelectItem T="bool?" Value="false">@L["only if no restart is pending"]</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                        </MudGrid>
                    </MudExpansionPanel>
                    @if (Type is not (StepType.Sleep or StepType.Reboot or StepType.InventoryScan))
                    {
                        <MudExpansionPanel Text="@(HasRobustness ? L["Retries and preparation (active)"] : L["Retries and preparation"])">
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6">
                                    <MudNumericField T="int" @bind-Value="_step.Retries" Label="@L["Retries on failure"]" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="20"
                                                     HelperText="@(Type is StepType.Install or StepType.Uninstall ? L["If another installation is running (exit code 1618), the step is retried up to three times anyway."] : L["Not retried: too little disk space or a program that cannot be closed."])" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudNumericField T="int" @bind-Value="_step.RetryDelaySeconds" Label="@L["Pause before a retry (seconds)"]" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="3600" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudNumericField T="int" @bind-Value="_step.MinFreeDiskMb" Label="@L["Required free disk space (MB)"]" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="1000000"
                                                     HelperText="@(Type == StepType.Install ? L["On the system drive. 0 = twice the size of the installer file."] : L["On the system drive. 0 = no check."])" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="_closeProcesses" Label="@L["Close programs first"]" Placeholder="outlook, winword" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                                                  HelperText="@L["Process names, comma-separated. They are terminated before the step; unsaved work is lost."]" />
                                </MudItem>
                                @if (!string.IsNullOrWhiteSpace(_closeProcesses))
                                {
                                    <MudItem xs="12" sm="4">
                                        <MudNumericField T="int" @bind-Value="_step.CloseProcessesWarnSeconds" Label="@L["Warn users before (seconds)"]" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="3600"
                                                         HelperText="@L["0 = close immediately"]" />
                                    </MudItem>
                                    <MudItem xs="12" sm="8">
                                        <MudTextField @bind-Value="_step.CloseProcessesMessage" Label="@L["Message for logged-on users"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                      Disabled="@(_step.CloseProcessesWarnSeconds <= 0)" Placeholder="@L["Outlook will be closed in two minutes for an update. Please save your work."]" />
                                    </MudItem>
                                }
                            </MudGrid>
                        </MudExpansionPanel>
                    }
                </MudExpansionPanels>
            }

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error">@_error</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(!CanSave)" OnClick="SaveAsync">@L["Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public int PackageId { get; set; }
    /// <summary>null = neuer Schritt.</summary>
    [Parameter] public PackageStep? Step { get; set; }
    [Parameter] public StepType Type { get; set; }
    [Parameter] public bool Nested { get; set; }
    [Parameter] public List<string> Files { get; set; } = [];

    private string CommandHelp => L["Executed with cmd.exe /c. The files of this package are in the working directory under p{0}\\.", PackageId];

    private JobStep _step = new();
    private StepConditions _conditions = new();
    private string _successCodes = "";
    private string _closeProcesses = "";
    private string _updateKbIds = "";
    private string _featureNames = "";
    private bool _externalSource;

    private void SetExternalSource(bool external)
    {
        _externalSource = external;
        // Nur eine der beiden Quellen bleibt stehen, damit der Schritt eindeutig ist.
        if (external)
            _step.File = null;
        else
            _step.SourcePath = null;
    }

    private static List<string> Features(string text) =>
        [.. text.Split([',', ';', ' ', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Distinct(StringComparer.OrdinalIgnoreCase)];

    private bool HasRobustness => _step.Retries > 0 || _step.MinFreeDiskMb > 0 || !string.IsNullOrWhiteSpace(_closeProcesses);
    private int? _nestedPackageId;
    private List<Package> _packages = [];
    private string? _error;

    private bool CanSave => !string.IsNullOrWhiteSpace(_step.Name) && (Nested
        ? _nestedPackageId is not null
        : Type switch
        {
            StepType.Command or StepType.PowerShell => !string.IsNullOrWhiteSpace(_step.Script),
            StepType.Install => !string.IsNullOrWhiteSpace(_step.File),
            StepType.FileCopy => !string.IsNullOrWhiteSpace(_externalSource ? _step.SourcePath : _step.File) && !string.IsNullOrWhiteSpace(_step.Destination),
            StepType.Registry => !string.IsNullOrWhiteSpace(_step.RegistryKey),
            StepType.WindowsFeature => Features(_featureNames).Count > 0,
            StepType.RemoveApp => !string.IsNullOrWhiteSpace(_step.AppName),
            StepType.Service => !string.IsNullOrWhiteSpace(_step.ServiceName),
            StepType.Uninstall => !string.IsNullOrWhiteSpace(_step.SoftwareName) || !string.IsNullOrWhiteSpace(_step.ProductCode),
            _ => true,
        });

    protected override async Task OnInitializedAsync()
    {
        if (Step is not null)
        {
            // Kopie bearbeiten, damit "Abbrechen" nichts an der angezeigten Liste verändert.
            _step = JobJson.Deserialize<JobStep>(JobJson.Serialize(Step.Definition))!;
            _nestedPackageId = Step.NestedPackageId;
        }
        else
        {
            _step = new JobStep
            {
                Type = Type,
                Name = Nested ? "" : Display.Step(Type),
                Seconds = Type switch { StepType.Sleep => 30, StepType.Reboot => 60, _ => 0 },
                TimeoutSeconds = Type switch { StepType.WindowsUpdate => 7200, StepType.Install or StepType.Uninstall => 3600, _ => 600 },
            };
        }
        _conditions = _step.Conditions ?? new StepConditions();
        _successCodes = string.Join(", ", _step.SuccessCodes);
        _closeProcesses = string.Join(", ", _step.CloseProcesses);
        _updateKbIds = string.Join(", ", _step.UpdateKbIds);
        _featureNames = string.Join(", ", _step.FeatureNames);
        _externalSource = !string.IsNullOrWhiteSpace(_step.SourcePath);
        if (Nested)
            _packages = (await PackageService.ListAsync()).Where(p => p.Id != PackageId).ToList();
        await DetectAsync();
    }

    private Inventory.Core.SilentSuggestion? _suggestion;

    /// <summary>Erkennt den Installer-Typ der gewählten Datei und trägt die Silent-Parameter ein, solange dort nichts Eigenes steht.</summary>
    private async Task SelectInstallerAsync(string? file)
    {
        var previous = _suggestion?.Arguments;
        _step.File = file;
        await DetectAsync();
        if (_suggestion is not null && (string.IsNullOrWhiteSpace(_step.Arguments) || _step.Arguments == previous))
            _step.Arguments = _suggestion.Arguments;
    }

    private async Task DetectAsync()
    {
        _suggestion = null;
        if (Type != StepType.Install || string.IsNullOrWhiteSpace(_step.File))
            return;
        try
        {
            var path = PackageService.Repository.Resolve(PackageId, _step.File);
            if (File.Exists(path))
                _suggestion = await Task.Run(() => Inventory.Core.SilentOptions.Detect(path));
        }
        catch (Exception ex) when (ex is IOException or ArgumentException or UnauthorizedAccessException)
        {
            // Ohne lesbare Datei gibt es keinen Vorschlag; der Schritt lässt sich trotzdem speichern.
        }
    }

    /// <summary>Ordner, die sich aus den Dateipfaden ergeben; nur beim Kopieren wählbar.</summary>
    private List<string> Folders => Files
        .SelectMany(f => { var parts = f.Split('\\'); return Enumerable.Range(1, parts.Length - 1).Select(n => string.Join('\\', parts.Take(n))); })
        .Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase).ToList();

    private List<string> FileOptions
    {
        get
        {
            var options = Type == StepType.FileCopy ? Folders.Concat(Files).ToList() : Files.ToList();
            // Eine inzwischen gelöschte Datei bleibt sichtbar, statt stillschweigend zu verschwinden.
            if (!string.IsNullOrWhiteSpace(_step.File) && !options.Contains(_step.File))
                options.Insert(0, _step.File);
            return options;
        }
    }

    private async Task SaveAsync()
    {
        if (!await Access.DemandAdminAsync())
            return;
        var codes = new List<int>();
        _step.CloseProcesses = [.. _closeProcesses.Split([',', ';'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)];
        foreach (var part in _successCodes.Split([',', ';', ' '], StringSplitOptions.RemoveEmptyEntries))
        {
            if (!int.TryParse(part, out var code))
            {
                _error = L["\"{0}\" is not a valid exit code.", part];
                return;
            }
            codes.Add(code);
        }
        _step.SuccessCodes = codes;
        _step.UpdateKbIds = PendingUpdates.NormalizeKbIds(_updateKbIds);
        if (_step.UpdateKbIds.Count == 0 && !string.IsNullOrWhiteSpace(_updateKbIds))
        {
            _error = L["\"{0}\" contains no KB number.", _updateKbIds.Trim()];
            return;
        }
        if (Type == StepType.RemoveApp)
        {
            _step.AppName = _step.AppName!.Trim();
            if (!AppNames.IsRemovalPattern(_step.AppName))
            {
                _error = L["\"{0}\" is not usable as a package name: letters, digits, dot and hyphen, with * only next to enough of the name (not just the vendor).", _step.AppName];
                return;
            }
        }
        _step.FeatureNames = Type == StepType.WindowsFeature ? Features(_featureNames) : [];
        if (_step.FeatureNames.FirstOrDefault(f => !RegistryData.IsFeatureName(f)) is { } invalid)
        {
            _error = L["\"{0}\" is not a feature name (letters, digits, dot, hyphen and underscore only).", invalid];
            return;
        }
        if (Type == StepType.Registry)
        {
            try
            {
                var hive = RegistryData.Split(_step.RegistryKey, out var path);
                if (path.Length == 0)
                    throw new InvalidDataException();
                if (_step.RegistryAction == RegistryAction.DeleteKey && !RegistryData.CanDeleteKey(hive, path))
                {
                    _error = L["This key cannot be deleted: it is a top-level branch of the registry or holds Windows or all programs of a vendor."];
                    return;
                }
                if (hive == RegistryData.Hive.CurrentUser && _step.RunAs != StepRunAs.LoggedOnUser)
                {
                    _error = L["HKCU needs \"Run as: Logged-on user\". As Local System the step would change the settings of the system account."];
                    return;
                }
                if (hive != RegistryData.Hive.CurrentUser && _step.RunAs == StepRunAs.LoggedOnUser)
                {
                    _error = L["\"Run as: Logged-on user\" only applies to HKCU. Other keys are changed by the system account."];
                    return;
                }
            }
            catch (InvalidDataException)
            {
                _error = L["The key must start with HKLM, HKCU, HKU or HKCR and name a path below it."];
                return;
            }
            if (_step.RegistryAction == RegistryAction.SetValue)
            {
                try
                {
                    RegistryData.Convert(_step.RegistryDataType, _step.RegistryData);
                }
                catch (InvalidDataException)
                {
                    _error = L["The data does not fit the type {0}.", Display.RegistryTypeName(_step.RegistryDataType)];
                    return;
                }
            }
            _step.RegistryKey = _step.RegistryKey!.Trim();
        }
        _step.Conditions = _conditions.IsEmpty ? null : _conditions;
        _step.Name = _step.Name.Trim();

        try
        {
            await PackageService.SaveStepAsync(PackageId, Step?.Id, _step, Nested ? _nestedPackageId : null);
            await Audit.LogAsync(Step is null ? L["Package step created"] : L["Package step changed"], $"{L["Package"]} {PackageId}: {_step.Name} – {Display.StepSummary(_step)}");
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
    }
}
