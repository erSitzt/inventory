<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_names" Label="Rechnernamen" Lines="8" Variant="Variant.Outlined" AutoFocus="true" Immediate="true"
                      HelperText="Ein Name je Zeile; Komma, Semikolon oder Leerzeichen gehen auch. Bereits vorhandene Namen werden übersprungen." />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Abbrechen</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@string.IsNullOrWhiteSpace(_names)"
                   OnClick="@(() => MudDialog.Close(DialogResult.Ok(_names)))">Hinzufügen</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private string _names = "";
}
