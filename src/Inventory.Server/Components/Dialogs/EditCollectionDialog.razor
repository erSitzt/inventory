@inject CollectionService CollectionService
@inject MaintenanceService Maintenance
@inject Display Display
@inject IStringLocalizer<SharedResource> L
@inject Access Access
@inject Auditor Audit

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_name" Label="@L["Name"]" Variant="Variant.Outlined" Required="true" AutoFocus="true" Immediate="true" />
            <MudTextField @bind-Value="_description" Label="@L["Description"]" Variant="Variant.Outlined" />

            @if (IsDynamic)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudText>@L["A computer belongs to it if"]</MudText>
                    <MudSelect T="bool" @bind-Value="_matchAll" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 200px" aria-label="@L["Combination"]">
                        <MudSelectItem T="bool" Value="true">@L["all rules"]</MudSelectItem>
                        <MudSelectItem T="bool" Value="false">@L["at least one rule"]</MudSelectItem>
                    </MudSelect>
                    <MudText>@(_matchAll ? L["apply."] : L["applies."])</MudText>
                </MudStack>

                @foreach (var rule in _rules)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        @* Die Listen dürfen breiter werden als ihr Feld (Adaptive), sonst brechen lange Einträge um; das Feld selbst bekommt den meisten Platz. *@
                        <MudSelect RelativeWidth="DropdownWidth.Adaptive" PopoverClass="rule-select" Style="flex: 2 1 0; min-width: 240px" T="RuleField" Value="rule.Field" ValueChanged="@(f => SetField(rule, f))" Label="@L["Field"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var field in Fields)
                            {
                                <MudSelectItem T="RuleField" Value="field">@Display.Field(field)</MudSelectItem>
                            }
                        </MudSelect>
                        <MudSelect RelativeWidth="DropdownWidth.Adaptive" PopoverClass="rule-select" T="RuleOperator" Value="rule.Operator" ValueChanged="@(op => SetOperator(rule, op))" Label="@L["Condition"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var op in Display.OperatorsFor(rule.Field))
                            {
                                <MudSelectItem T="RuleOperator" Value="op">@Display.Operator(op)</MudSelectItem>
                            }
                        </MudSelect>
                        @if (Display.IsFlag(rule.Field))
                        {
                            <MudSelect RelativeWidth="DropdownWidth.Adaptive" PopoverClass="rule-select" T="string" @bind-Value="rule.Value" Label="@L["Value"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                                <MudSelectItem T="string" Value="@("true")">@L["yes"]</MudSelectItem>
                                <MudSelectItem T="string" Value="@("false")">@L["no"]</MudSelectItem>
                            </MudSelect>
                        }
                        else if (rule.Field == RuleField.InCollection)
                        {
                            <MudSelect RelativeWidth="DropdownWidth.Adaptive" PopoverClass="rule-select" T="string" @bind-Value="rule.Value" Label="@L["Collection"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var other in _others)
                                {
                                    <MudSelectItem T="string" Value="@other.Id.ToString()">@other.Name</MudSelectItem>
                                }
                            </MudSelect>
                        }
                        else if (rule.Field == RuleField.DeviceType)
                        {
                            <MudSelect RelativeWidth="DropdownWidth.Adaptive" PopoverClass="rule-select" T="string" @bind-Value="rule.Value" Label="@L["Value"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var kind in Enum.GetValues<ChassisKind>().Where(k => k != ChassisKind.Unknown))
                                {
                                    <MudSelectItem T="string" Value="@kind.ToString()">@L[Chassis.Label(kind)]</MudSelectItem>
                                }
                            </MudSelect>
                        }
                        else
                        {
                            <MudTextField @bind-Value="rule.Value" Label="@(rule.Field switch { RuleField.Software => L["Program name"], RuleField.Service => L["Service name"], _ => L["Value"] })" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                        }
                        @if (rule.Field == RuleField.Service && rule.Operator is not RuleOperator.NotEquals)
                        {
                            <MudSelect RelativeWidth="DropdownWidth.Adaptive" PopoverClass="rule-select" T="string" @bind-Value="rule.Value2" Label="@L["State"]" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Placeholder="@L["any"]">
                                <MudSelectItem T="string" Value="@("Running")">@Display.ServiceState("Running")</MudSelectItem>
                                <MudSelectItem T="string" Value="@("Stopped")">@Display.ServiceState("Stopped")</MudSelectItem>
                            </MudSelect>
                        }
                        @if (rule.Field == RuleField.Software && rule.Operator is not (RuleOperator.NotContains or RuleOperator.NotEquals))
                        {
                            <MudTextField @bind-Value="rule.Value2" Label="@L["Version less than (optional)"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        }
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" aria-label="@L["Remove rule"]" OnClick="@(() => _rules.Remove(rule))" />
                    </MudStack>
                }
                <div>
                    <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => _rules.Add(new CollectionRule()))">@L["Add rule"]</MudButton>
                </div>
                <MudText Typo="Typo.caption">@L["With \"equals\", a * in the value stands for any characters, e.g. PC-*-01. \"Member of collection\" lets you combine collections, up to {0} levels deep.", RuleContext.MaxDepth]</MudText>
            }
            <MaintenanceWindowEditor @bind-Value="_window" Label="@L["Maintenance window"]" />
            <MudText Typo="Typo.caption">@L["Deployments that respect maintenance windows run on the members only during this period. A computer in several collections may run as soon as one of their windows is open."]</MudText>
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error">@_error</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(!CanSave)" OnClick="SaveAsync">@L["Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    /// <summary>null = neue Sammlung anlegen.</summary>
    [Parameter] public Collection? Collection { get; set; }
    [Parameter] public bool IsDynamic { get; set; }

    private string _name = "";
    private string? _description;
    private bool _matchAll = true;
    private List<CollectionRule> _rules = [];
    private string? _error;
    private MaintenanceWindow? _window;
    private List<Collection> _others = [];

    /// <summary>Nach Bezeichnung geordnet: bei dieser Zahl von Feldern findet man sie sonst nicht.</summary>
    private IEnumerable<RuleField> Fields => Enum.GetValues<RuleField>().OrderBy(f => Display.Field(f), StringComparer.CurrentCultureIgnoreCase);

    protected override async Task OnInitializedAsync() =>
        _others = (await CollectionService.ListAsync()).Select(s => s.Collection).Where(c => c.Id != Collection?.Id).ToList();

    private bool CanSave => !string.IsNullOrWhiteSpace(_name) && (!IsDynamic || _rules.Any(r => !string.IsNullOrWhiteSpace(r.Value)));

    protected override void OnInitialized()
    {
        if (Collection is not null)
        {
            _name = Collection.Name;
            _description = Collection.Description;
            _matchAll = Collection.MatchAll;
            _window = Collection.MaintenanceWindow;
            // Kopien bearbeiten, damit "Abbrechen" nichts an der angezeigten Liste verändert.
            _rules = Collection.Rules.Select(r => new CollectionRule { Field = r.Field, Operator = r.Operator, Value = r.Value, Value2 = r.Value2 }).ToList();
        }
        if (IsDynamic && _rules.Count == 0)
            _rules.Add(new CollectionRule { Field = RuleField.Software });
    }

    private static void SetOperator(CollectionRule rule, RuleOperator op)
    {
        rule.Operator = op;
        // Der Zustand eines Dienstes wird nur bei den bejahenden Bedingungen angeboten und ausgewertet.
        if (rule.Field == RuleField.Service && op == RuleOperator.NotEquals)
            rule.Value2 = null;
    }

    private void SetField(CollectionRule rule, RuleField field)
    {
        rule.Field = field;
        var allowed = Display.OperatorsFor(field);
        if (!allowed.Contains(rule.Operator))
            rule.Operator = allowed[0];
        rule.Value = Display.IsFlag(field) ? "true" : "";
        rule.Value2 = null;
    }

    private async Task SaveAsync()
    {
        if (!await Access.DemandAdminAsync())
            return;
        try
        {
            var saved = await CollectionService.SaveAsync(Collection?.Id, _name, _description, IsDynamic, _matchAll, _rules);
            await Maintenance.SetAsync(saved.Id, _window);
            var kind = IsDynamic ? L["dynamic, {0} rules", _rules.Count(r => !string.IsNullOrWhiteSpace(r.Value))] : L["static"];
            var renamed = Collection is not null && !string.Equals(Collection.Name, saved.Name, StringComparison.Ordinal) ? $"{Collection.Name} → " : "";
            await Audit.LogAsync(Collection is null ? L["Collection created"] : L["Collection changed"],
                $"{renamed}{saved.Name} ({kind}, {L["Maintenance window"]}: {Display.Window(_window)})");
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateException)
        {
            _error = L["A collection named \"{0}\" already exists.", _name.Trim()];
        }
        catch (InvalidOperationException ex)
        {
            // Verweise auf andere Sammlungen: Kreis, zu tief oder nicht mehr vorhanden.
            _error = ex.Message;
        }
    }
}
