@inject ComputerService ComputerService
@inject AgentService Agents
@inject Auditor Audit
@inject Display Display
@inject IStringLocalizer<SharedResource> L
@inject Access Access

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_description" Label="@L["Description"]" Variant="Variant.Outlined" />
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="_owner" Label="@L["Owner"]" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="_location" Label="@L["Location"]" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="_costCenter" Label="@L["Cost center"]" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField @bind-Value="_inventoryNumber" Label="@L["Inventory number"]" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" sm="6"><MudDatePicker @bind-Date="_purchaseDate" Label="@L["Purchase date"]" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Editable="true" /></MudItem>
                <MudItem xs="12" sm="6"><MudDatePicker @bind-Date="_warrantyUntil" Label="@L["Warranty until"]" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Editable="true" /></MudItem>
                <MudItem xs="12"><MudTextField @bind-Value="_tags" Label="@L["Tags"]" Variant="Variant.Outlined" Margin="Margin.Dense" HelperText="@L["Separated by commas, e.g. \"Kiosk, Loan device\""]" /></MudItem>
                <MudItem xs="12"><MudTextField @bind-Value="_notes" Label="@L["Notes"]" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" /></MudItem>
            </MudGrid>
            <MudSelect T="TransportKind?" @bind-Value="_transport" Label="@L["Transport"]" Variant="Variant.Outlined" Clearable="true" Placeholder="@L["Default"]">
                <MudSelectItem T="TransportKind?" Value="@(TransportKind.SmbService)">@Display.Transport(TransportKind.SmbService)</MudSelectItem>
                <MudSelectItem T="TransportKind?" Value="@(TransportKind.WinRm)">@Display.Transport(TransportKind.WinRm)</MudSelectItem>
                @if (Computer.AgentKeyHash is not null)
                {
                    <MudSelectItem T="TransportKind?" Value="@(TransportKind.Agent)">@Display.Transport(TransportKind.Agent)</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="int?" @bind-Value="_credentialId" Label="@L["Credentials"]" Variant="Variant.Outlined" Clearable="true" Placeholder="@L["Default"]">
                @foreach (var credential in Credentials)
                {
                    <MudSelectItem T="int?" Value="@credential.Id">@credential.Name (@credential.Username)</MudSelectItem>
                }
            </MudSelect>
            @if (Computer.AgentKeyHash is not null)
            {
                <MudAlert Severity="Severity.Info" Dense="true">
                    @L["Agent {0}, last contact {1}", Computer.AgentVersion, Display.LocalTime(Computer.AgentLastSeenUtc)]
                    <div class="mt-2">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="ForgetAgentAsync">@L["Forget agent"]</MudButton>
                    </div>
                    <MudText Typo="Typo.caption" Class="mt-1">@L["Removes the agent's key on the server and resets the transport. Uninstall the service on the computer first (sc stop InventoryAgent, sc delete InventoryAgent), otherwise it enrolls again with the enrollment secret."]</MudText>
                </MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">@L["Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public Computer Computer { get; set; } = default!;
    [Parameter, EditorRequired] public List<Credential> Credentials { get; set; } = [];

    private string? _description;
    private string? _owner, _location, _costCenter, _inventoryNumber, _tags, _notes;
    private DateTime? _purchaseDate, _warrantyUntil;
    private TransportKind? _transport;
    private int? _credentialId;

    protected override void OnInitialized()
    {
        _description = Computer.Description;
        (_owner, _location, _costCenter, _inventoryNumber, _tags, _notes) = (Computer.Owner, Computer.Location, Computer.CostCenter, Computer.InventoryNumber, Computer.Tags, Computer.Notes);
        _purchaseDate = Computer.PurchaseDate?.ToDateTime(TimeOnly.MinValue);
        _warrantyUntil = Computer.WarrantyUntil?.ToDateTime(TimeOnly.MinValue);
        _transport = Computer.Transport;
        _credentialId = Computer.CredentialId;
    }

    private async Task ForgetAgentAsync()
    {
        if (!await Access.DemandAdminAsync())
            return;
        await Agents.ForgetAsync(Computer.Id);
        await Audit.LogAsync(L["Agent forgotten"], Computer.Name);
        MudDialog.Close(DialogResult.Ok(true));
    }

    private async Task SaveAsync()
    {
        if (!await Access.DemandAdminAsync())
            return;
        await ComputerService.UpdateAsync(Computer.Id, _description, _transport, _credentialId);
        await ComputerService.UpdateAssetAsync(Computer.Id, new AssetData(_owner, _location, _costCenter, _inventoryNumber,
            _purchaseDate is { } purchase ? DateOnly.FromDateTime(purchase) : null, _warrantyUntil is { } warranty ? DateOnly.FromDateTime(warranty) : null, _tags, _notes));
        await Audit.LogAsync(L["Computer changed"], Computer.Name);
        MudDialog.Close(DialogResult.Ok(true));
    }
}
