@inject IJSRuntime Js
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            @if (Computer.NameMismatch)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">
                    Unter dem Namen @Computer.Name antwortet der Rechner @Computer.ReportedName. Eine Verbindung ginge an den falschen Rechner.
                </MudAlert>
            }

            <MudText Typo="Typo.subtitle1">Starter für den Direktstart</MudText>
            <MudText Typo="Typo.body2">
                Damit sich Remoteunterstützung, Spiegelung und Remotedesktop per Klick öffnen, braucht dein PC einmalig den Starter:
                herunterladen, an einem festen Ort ablegen (z. B. <code>C:\Tools</code>) und einmal doppelklicken. Er trägt sich für dein Benutzerkonto
                als Ziel für <code>inventory://</code>-Links ein; Adminrechte sind dafür nicht nötig. Beim ersten Klick fragt der Browser, ob er den Starter öffnen darf.
            </MudText>
            <div>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download" Href="download/launcher" Target="_blank">InventoryLauncher.exe herunterladen</MudButton>
            </div>
            <MudText Typo="Typo.caption">
                Der Starter öffnet ausschließlich msra.exe und mstsc.exe mit geprüftem Rechnernamen. Auf mehreren Admin-PCs lässt er sich auch über
                „Rechner → Aktionen → Starter für Fernzugriff installieren“ verteilen.
            </MudText>

            <MudDivider />
            <MudText Typo="Typo.subtitle1">Ohne Starter: Befehle zum Kopieren</MudText>
            <MudText Typo="Typo.body2">Auf deinem PC ausführen (Windows-Taste + R, einfügen, Eingabe):</MudText>
            @CommandField("Remoteunterstützung anbieten", RemoteAccessLinks.OfferAssistance(Computer.Name))
            @CommandField(Computer.SessionId is null ? "Sitzung spiegeln (Sitzung 1 angenommen)" : $"Sitzung spiegeln (Sitzung {Computer.SessionId} laut Scan vom {Display.LocalTime(Computer.LastScanUtc)})",
                RemoteAccessLinks.Shadow(Computer.Name, Computer.SessionId ?? 1))
            @CommandField("Sitzungen des Rechners anzeigen", RemoteAccessLinks.ListSessions(Computer.Name))
            <div>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.DesktopWindows" Href="@($"api/computers/{Computer.Id}/rdp")" Target="_blank">Remotedesktop als .rdp-Datei</MudButton>
            </div>

            <MudDivider />
            <MudText Typo="Typo.subtitle1">Voraussetzungen auf den Rechnern</MudText>
            <MudText Typo="Typo.caption">
                <b>Remoteunterstützung:</b> Gruppenrichtlinie „Remoteunterstützung anbieten konfigurieren“ (Computerkonfiguration → Administrative Vorlagen → System →
                Remoteunterstützung) mit deinem Konto oder deiner Gruppe als Helfer; Firewall-Regelgruppe „Remoteunterstützung“. Der Benutzer muss zustimmen.
            </MudText>
            <MudText Typo="Typo.caption">
                <b>Spiegelung:</b> Gruppenrichtlinie „Regeln für Remotesteuerung von Remotedesktopdienste-Benutzersitzungen festlegen“ (… Windows-Komponenten →
                Remotedesktopdienste → Remotedesktopsitzungs-Host → Verbindungen); Firewall-Regeln „Remotedesktop – Schatten“ und „Datei- und Druckerfreigabe (SMB eingehend)“.
            </MudText>
        </MudStack>
    </DialogContent>
</MudDialog>

@code {
    [Parameter, EditorRequired] public Computer Computer { get; set; } = default!;

    private RenderFragment CommandField(string label, string command) => @<MudTextField T="string" Value="@command" Label="@label" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense"
        Style="font-family: monospace" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.ContentCopy" AdornmentAriaLabel="@($"{label} kopieren")"
        OnAdornmentClick="@(() => CopyAsync(command))" />;

    private async Task CopyAsync(string command)
    {
        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", command);
            Snackbar.Add("Befehl kopiert.", Severity.Success);
        }
        catch (JSException)
        {
            // Die Zwischenablage steht Webseiten nur über HTTPS oder localhost zur Verfügung.
            Snackbar.Add("Kopieren ist nur über HTTPS möglich – bitte den Befehl markieren und mit Strg+C kopieren.", Severity.Info);
        }
    }
}
