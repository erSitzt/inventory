@inject IJSRuntime Js
@inject ISnackbar Snackbar
@inject Display Display
@inject IStringLocalizer<SharedResource> L

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            @if (Computer.NameMismatch)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">
                    @L["Under the name {0} the computer {1} responds. A connection would go to the wrong computer.", Computer.Name, Computer.ReportedName]
                </MudAlert>
            }

            <MudText Typo="Typo.subtitle1">@L["Launcher for direct start"]</MudText>
            <MudText Typo="Typo.body2">
                @L["So that Remote Assistance, shadowing and Remote Desktop open with one click, your PC needs the launcher once: download it, put it in a fixed place (e.g. C:\\Tools) and double-click it once. It registers itself for your user account as the handler for inventory:// links; admin rights are not needed. On the first click the browser asks whether it may open the launcher."]
            </MudText>
            <div>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download" Href="download/launcher" Target="_blank">@L["Download InventoryLauncher.exe"]</MudButton>
            </div>
            <MudText Typo="Typo.caption">
                @L["The launcher only ever opens msra.exe and mstsc.exe with a validated computer name. For several admin PCs it can also be rolled out via \"Computers → Actions → Install remote access launcher\"."]
            </MudText>

            <MudDivider />
            <MudText Typo="Typo.subtitle1">@L["Without launcher: commands to copy"]</MudText>
            <MudText Typo="Typo.body2">@L["Run on your PC (Windows key + R, paste, Enter):"]</MudText>
            @CommandField(L["Offer Remote Assistance"], RemoteAccessLinks.OfferAssistance(Computer.Address))
            @CommandField(Computer.SessionId is null ? L["Shadow session (session 1 assumed)"] : L["Shadow session (session {0} according to the scan of {1})", Computer.SessionId, Display.LocalTime(Computer.LastScanUtc)],
                RemoteAccessLinks.Shadow(Computer.Address, Computer.SessionId ?? 1))
            @CommandField(L["Show the computer's sessions"], RemoteAccessLinks.ListSessions(Computer.Address))
            <div>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.DesktopWindows" Href="@($"api/computers/{Computer.Id}/rdp")" Target="_blank">@L["Remote Desktop as .rdp file"]</MudButton>
            </div>

            <MudDivider />
            <MudText Typo="Typo.subtitle1">@L["Prerequisites on the computers"]</MudText>
            <MudText Typo="Typo.caption">
                <b>@L["Remote Assistance:"]</b> @L["Group policy \"Configure Offer Remote Assistance\" (Computer Configuration → Administrative Templates → System → Remote Assistance) with your account or group as helper; firewall rule group \"Remote Assistance\". The user has to consent."]
            </MudText>
            <MudText Typo="Typo.caption">
                <b>@L["Shadowing:"]</b> @L["Group policy \"Set rules for remote control of Remote Desktop Services user sessions\" (… Windows Components → Remote Desktop Services → Remote Desktop Session Host → Connections); firewall rules \"Remote Desktop – Shadow\" and \"File and Printer Sharing (SMB-In)\"."]
            </MudText>
        </MudStack>
    </DialogContent>
</MudDialog>

@code {
    [Parameter, EditorRequired] public Computer Computer { get; set; } = default!;

    private RenderFragment CommandField(string label, string command) => @<MudTextField T="string" Value="@command" Label="@label" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense"
        Style="font-family: monospace" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.ContentCopy" AdornmentAriaLabel="@L["Copy {0}", label]"
        OnAdornmentClick="@(() => CopyAsync(command))" />;

    private async Task CopyAsync(string command)
    {
        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", command);
            Snackbar.Add(L["Command copied."], Severity.Success);
        }
        catch (JSException)
        {
            // Die Zwischenablage steht Webseiten nur über HTTPS oder localhost zur Verfügung.
            Snackbar.Add(L["Copying only works over HTTPS – please select the command and copy it with Ctrl+C."], Severity.Info);
        }
    }
}
