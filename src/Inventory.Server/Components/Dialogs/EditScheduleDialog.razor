@inject ScheduleService ScheduleService
@inject PackageService PackageService
@inject CollectionService CollectionService
@inject SavedReportService SavedReports
@inject NotificationService Channels
@inject Auditor Audit
@inject Display Display
@inject IStringLocalizer<SharedResource> L
@inject Access Access

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_s.Name" Label="@L["Name"]" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" AutoFocus="true" />
            <MudSelect T="ScheduleAction" @bind-Value="_s.Action" Label="@L["Action"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="ScheduleAction" Value="ScheduleAction.Scan">@L["Inventory scan"]</MudSelectItem>
                <MudSelectItem T="ScheduleAction" Value="ScheduleAction.Deploy">@L["Deploy package"]</MudSelectItem>
                <MudSelectItem T="ScheduleAction" Value="ScheduleAction.Report">@L["Send report"]</MudSelectItem>
            </MudSelect>
            @if (_s.Action == ScheduleAction.Report)
            {
                <MudSelect T="int?" @bind-Value="_s.ReportId" Label="@L["Report"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var report in _reports)
                    {
                        <MudSelectItem T="int?" Value="@report.Id">@report.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="int?" @bind-Value="_s.NotificationChannelId" Label="@L["Channel"]" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Placeholder="@L["all enabled channels"]"
                           HelperText="@L["E-mail channels get the report as an Excel attachment, webhooks a note with the number of rows and a link."]">
                    @foreach (var channel in _channels)
                    {
                        <MudSelectItem T="int?" Value="@channel.Id">@channel.Name</MudSelectItem>
                    }
                </MudSelect>
            }
            @if (_s.Action == ScheduleAction.Deploy)
            {
                <MudSelect T="int?" @bind-Value="_s.PackageId" Label="@L["Package"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var package in _packages)
                    {
                        <MudSelectItem T="int?" Value="@package.Id">@package.Name @package.Version</MudSelectItem>
                    }
                </MudSelect>
                <MudCheckBox T="bool" @bind-Value="_s.ScanAfter" Label="@L["Rescan inventory afterwards"]" Dense="true" />
                <MudCheckBox T="bool" @bind-Value="_s.RetryOffline" Label="@L["Retry offline computers (up to 3 days)"]" Dense="true" />
                <MudCheckBox T="bool" @bind-Value="_s.RespectMaintenanceWindow" Label="@L["Only within the maintenance window (computers outside wait until it opens)"]" Dense="true" />
                <DeploymentLimitsEditor @bind-MaxFailures="_s.MaxFailures" @bind-MaxFailurePercent="_s.MaxFailurePercent" @bind-MaxParallel="_s.MaxParallel" />
            }
            @if (_s.Action != ScheduleAction.Report)
            {
                <MudSelect T="int?" @bind-Value="_s.CollectionId" Label="@L["Target"]" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Placeholder="@L["All computers"]"
                           HelperText="@L["Dynamic collections are re-evaluated on every run."]">
                    @foreach (var summary in _collections)
                    {
                        <MudSelectItem T="int?" Value="@summary.Collection.Id">@summary.Collection.Name (@summary.Count)</MudSelectItem>
                    }
                </MudSelect>
            }

            <MudSelect T="ScheduleTrigger" @bind-Value="_s.Trigger" Label="@L["Rhythm"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="ScheduleTrigger" Value="ScheduleTrigger.Daily">@L["Daily"]</MudSelectItem>
                <MudSelectItem T="ScheduleTrigger" Value="ScheduleTrigger.Weekly">@L["Weekly"]</MudSelectItem>
                <MudSelectItem T="ScheduleTrigger" Value="ScheduleTrigger.Monthly">@L["Monthly"]</MudSelectItem>
                <MudSelectItem T="ScheduleTrigger" Value="ScheduleTrigger.Interval">@L["At fixed intervals"]</MudSelectItem>
                <MudSelectItem T="ScheduleTrigger" Value="ScheduleTrigger.Once">@L["Once"]</MudSelectItem>
                @if (_s.Action == ScheduleAction.Deploy)
                {
                    <MudSelectItem T="ScheduleTrigger" Value="ScheduleTrigger.OnMembership">@L["Required: every member of the target gets the package"]</MudSelectItem>
                }
            </MudSelect>
            @switch (_s.Trigger)
            {
                case ScheduleTrigger.Daily:
                    <MudTimePicker @bind-Time="_time" Label="@L["Time of day"]" Variant="Variant.Outlined" Margin="Margin.Dense" Editable="true" />
                    break;
                case ScheduleTrigger.Weekly:
                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                        @foreach (var day in Display.WeekDays)
                        {
                            var bit = 1 << (int)day;
                            <MudChip T="string" Color="@((_s.DaysOfWeek & bit) != 0 ? Color.Primary : Color.Default)" OnClick="@(() => _s.DaysOfWeek ^= bit)">@Display.Day(day)</MudChip>
                        }
                    </MudStack>
                    <MudTimePicker @bind-Time="_time" Label="@L["Time of day"]" Variant="Variant.Outlined" Margin="Margin.Dense" Editable="true" />
                    break;
                case ScheduleTrigger.Monthly:
                    <MudRadioGroup T="bool" @bind-Value="_byWeekday">
                        <MudRadio T="bool" Value="false">@L["On a day of the month"]</MudRadio>
                        <MudRadio T="bool" Value="true">@L["On a weekday of the month"]</MudRadio>
                    </MudRadioGroup>
                    @if (_byWeekday)
                    {
                        <MudStack Row="true">
                            <MudSelect T="int" @bind-Value="_s.MonthWeek" Label="@L["Which"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @for (var week = 1; week <= 4; week++)
                                {
                                    var value = week;
                                    <MudSelectItem T="int" Value="value">@($"{value}.")</MudSelectItem>
                                }
                                <MudSelectItem T="int" Value="5">@L["last"]</MudSelectItem>
                            </MudSelect>
                            <MudSelect T="int" @bind-Value="_s.MonthWeekday" Label="@L["Weekday"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var day in Display.WeekDays)
                                {
                                    <MudSelectItem T="int" Value="@((int)day)">@Display.WeekdayName((int)day)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudStack>
                    }
                    else
                    {
                        <MudNumericField T="int" @bind-Value="_monthDay" Label="@L["Day of the month"]" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="31"
                                         HelperText="@L["In shorter months the last day."]" />
                    }
                    <MudNumericField T="int" @bind-Value="_s.MonthOffsetDays" Label="@L["Days later"]" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="27"
                                     HelperText="@L["E.g. 3 with \"2. Tuesday\": three days after the monthly Microsoft patch day."]" />
                    <MudTimePicker @bind-Time="_time" Label="@L["Time of day"]" Variant="Variant.Outlined" Margin="Margin.Dense" Editable="true" />
                    break;
                case ScheduleTrigger.OnMembership:
                    <MudAlert Severity="Severity.Info" Dense="true">
                        @L["Every {0} minutes the server checks which members of the target have not received the package through this schedule yet and starts it there – also on computers that join the collection later. A computer on which it failed is tried again after a day. Maintenance windows and offline computers are handled as set above.", ScheduleCalculator.MembershipCheckMinutes]
                    </MudAlert>
                    <MudNumericField T="int" @bind-Value="_s.RecheckDays" Label="@L["Run again after (days)"]" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="365"
                                     HelperText="@L["0 = never, otherwise at least {0} days. Useful when the package has a detection: it then only reinstalls where the program has disappeared.", ScheduleService.MinRecheckDays]" />
                    break;
                case ScheduleTrigger.Interval:
                    <MudNumericField T="int" @bind-Value="_s.IntervalMinutes" Label="@L["Interval (minutes)"]" Variant="Variant.Outlined" Margin="Margin.Dense" Min="5" Max="43200" />
                    break;
                case ScheduleTrigger.Once:
                    <MudStack Row="true">
                        <MudDatePicker @bind-Date="_date" Label="@L["Date"]" Variant="Variant.Outlined" Margin="Margin.Dense" Editable="true" />
                        <MudTimePicker @bind-Time="_time" Label="@L["Time of day"]" Variant="Variant.Outlined" Margin="Margin.Dense" Editable="true" />
                    </MudStack>
                    break;
            }
            @if (_s.Trigger is ScheduleTrigger.Daily or ScheduleTrigger.Weekly or ScheduleTrigger.Monthly)
            {
                <MudCheckBox T="bool" @bind-Value="_s.CatchUpMissed" Label="@L["If the server was off at the scheduled time: catch up when it is less than a day late"]" Dense="true" />
            }
            @if (_s.Trigger != ScheduleTrigger.Once)
            {
                <MudDatePicker @bind-Date="_end" Label="@L["Ends on (optional)"]" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Editable="true" />
            }
            <MudSwitch T="bool" @bind-Value="_s.Enabled" Color="Color.Primary" Label="@L["Active"]" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(!CanSave)" OnClick="SaveAsync">@L["Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    /// <summary>null = neuer Zeitplan.</summary>
    [Parameter] public Schedule? Schedule { get; set; }

    private Schedule _s = new() { Name = "", Trigger = ScheduleTrigger.Daily };
    private TimeSpan? _time = new TimeSpan(12, 0, 0);
    private DateTime? _date = DateTime.Today;
    private DateTime? _end;
    private bool _byWeekday;
    private int _monthDay = 1;
    private List<Package> _packages = [];
    private List<Report> _reports = [];
    private List<NotificationChannel> _channels = [];
    private List<CollectionSummary> _collections = [];

    private bool CanSave => !string.IsNullOrWhiteSpace(_s.Name)
        && (_s.Action != ScheduleAction.Deploy || _s.PackageId is not null)
        && (_s.Action != ScheduleAction.Report || _s.ReportId is not null)
        && (_s.Trigger != ScheduleTrigger.Weekly || _s.DaysOfWeek != 0)
        && (_s.Trigger is ScheduleTrigger.Interval or ScheduleTrigger.OnMembership || _time is not null)
        && (_s.Trigger != ScheduleTrigger.OnMembership || _s.Action == ScheduleAction.Deploy)
        && (_s.Trigger != ScheduleTrigger.Once || _date is not null);

    protected override async Task OnInitializedAsync()
    {
        _packages = (await PackageService.ListAsync()).Where(p => p.Steps.Count > 0).ToList();
        _reports = await SavedReports.ListAsync();
        _channels = await Channels.ListAsync();
        _collections = await CollectionService.ListAsync();
        if (Schedule is null)
            return;
        // Kopie bearbeiten, damit "Abbrechen" nichts an der angezeigten Liste verändert.
        _s = new Schedule
        {
            Id = Schedule.Id, Name = Schedule.Name, Enabled = Schedule.Enabled, Action = Schedule.Action, PackageId = Schedule.PackageId,
            ScanAfter = Schedule.ScanAfter, RetryOffline = Schedule.RetryOffline, RespectMaintenanceWindow = Schedule.RespectMaintenanceWindow,
            MaxFailures = Schedule.MaxFailures, MaxFailurePercent = Schedule.MaxFailurePercent, MaxParallel = Schedule.MaxParallel, CollectionId = Schedule.CollectionId, Trigger = Schedule.Trigger,
            StartLocal = Schedule.StartLocal, IntervalMinutes = Schedule.IntervalMinutes, TimeOfDay = Schedule.TimeOfDay, DaysOfWeek = Schedule.DaysOfWeek,
            LastRunUtc = Schedule.LastRunUtc, LastResult = Schedule.LastResult,
            MonthDay = Schedule.MonthDay, MonthWeek = Schedule.MonthWeek, MonthWeekday = Schedule.MonthWeekday, MonthOffsetDays = Schedule.MonthOffsetDays,
            EndLocal = Schedule.EndLocal, CatchUpMissed = Schedule.CatchUpMissed, RecheckDays = Schedule.RecheckDays,
        };
        _byWeekday = Schedule.MonthDay <= 0;
        _monthDay = Math.Max(Schedule.MonthDay, 1);
        _end = Schedule.EndLocal?.Date;
        _time = Schedule.Trigger == ScheduleTrigger.Once ? Schedule.StartLocal?.TimeOfDay : Schedule.TimeOfDay;
        _date = Schedule.StartLocal?.Date ?? DateTime.Today;
    }

    private async Task SaveAsync()
    {
        if (!await Access.DemandAdminAsync())
            return;
        _s.TimeOfDay = _time ?? _s.TimeOfDay;
        _s.MonthDay = _byWeekday ? 0 : _monthDay;
        // Der letzte Tag zählt ganz mit.
        _s.EndLocal = _s.Trigger == ScheduleTrigger.Once ? null : _end?.Date.AddDays(1).AddSeconds(-1);
        if (_s.Trigger == ScheduleTrigger.Once)
        {
            _s.StartLocal = _date!.Value.Date + _time!.Value;
            // Ein geänderter Einmal-Termin soll wieder laufen.
            _s.LastRunUtc = null;
        }
        else if (_s.Trigger != ScheduleTrigger.Interval)
        {
            _s.StartLocal = null;
        }
        // Ein Zeitplan, der neu zur Pflicht-Verteilung wird, soll sofort prüfen statt erst nach dem nächsten Takt.
        if (_s.Trigger == ScheduleTrigger.OnMembership && Schedule?.Trigger != ScheduleTrigger.OnMembership)
            _s.LastRunUtc = null;
        await ScheduleService.SaveAsync(_s);
        await Audit.LogAsync(Schedule is null ? L["Schedule created"] : L["Schedule changed"], $"{_s.Name}: {Display.Trigger(_s)}{(_s.Enabled ? "" : ", " + L["disabled"])}");
        MudDialog.Close(DialogResult.Ok(true));
    }
}
