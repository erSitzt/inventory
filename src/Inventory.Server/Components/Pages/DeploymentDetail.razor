@page "/deployments/{Id:int}"
@implements IDisposable
@inject DeploymentService DeploymentService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject Auditor Audit
@inject Display Display
@inject IStringLocalizer<SharedResource> L
@inject Access Access

<PageTitle>@L["Deployment"] – Inventory</PageTitle>

@if (_deployment is null)
{
    @if (_loaded)
    {
        <MudAlert Severity="Severity.Warning">@L["This deployment does not exist."] <MudLink Href="deployments">@L["Back to the list"]</MudLink></MudAlert>
    }
    return;
}

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Wrap="Wrap.Wrap">
    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="deployments" aria-label="@L["Back to the list"]" />
    <MudText Typo="Typo.h5">@_deployment.PackageName @_deployment.PackageVersion</MudText>
    <MudSpacer />
    @if (Running || Waiting)
    {
        <OperatorOnly>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Stop" OnClick="CancelAsync">@L["Cancel"]</MudButton>
        </OperatorOnly>
    }
    else if (FailedTargets.Count > 0 && _deployment.PackageId is not null)
    {
        <OperatorOnly>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Replay" OnClick="RetryAsync">@L["Retry {0} failed", FailedTargets.Count]</MudButton>
        </OperatorOnly>
    }
</MudStack>

<MudText Typo="Typo.body2" Class="mb-4">
    @L["Started {0}", Display.LocalTime(_deployment.CreatedUtc)]
    @if (_deployment.FinishedUtc is not null)
    {
        <span> · @L["finished {0}", Display.LocalTime(_deployment.FinishedUtc)]</span>
    }
    · @L["{0} of {1} succeeded", _deployment.Targets.Count(t => t.Status.IsSuccess()), _deployment.Targets.Count]
    @if (_deployment.Targets.Any(t => t.Status == TargetStatus.AlreadyInstalled))
    {
        <span> (@L["{0} already installed", _deployment.Targets.Count(t => t.Status == TargetStatus.AlreadyInstalled)])</span>
    }
    @if (_deployment.Targets.Any(t => t.Status == TargetStatus.WaitingOffline))
    {
        <span> · @L["Offline computers are retried until {0}", Display.LocalTime(_deployment.RetryUntilUtc)]</span>
    }
    @if (_deployment.Targets.Any(t => t.Status == TargetStatus.WaitingWindow))
    {
        <span> · @L["{0} computers are waiting for their maintenance window", _deployment.Targets.Count(t => t.Status == TargetStatus.WaitingWindow)]</span>
    }
    @if (_deployment.Targets.Any(t => t.Status == TargetStatus.WaitingReboot))
    {
        <span> · @L["{0} computers are restarting; the remaining steps follow automatically", _deployment.Targets.Count(t => t.Status == TargetStatus.WaitingReboot)]</span>
    }
</MudText>

@if (DeploymentService.Pilot(_deployment) is { } pilot)
{
    <MudAlert Severity="@(pilot.Pending == 0 && !pilot.WithinLimit ? Severity.Warning : Severity.Info)" Dense="true" Class="mb-4">
        @L["Phased rollout: {0} computers wait for the pilot group ({1} computers, {2} failed, at most {3} % allowed).", _deployment.Targets.Count(t => t.Status == TargetStatus.WaitingPilot), pilot.Total, pilot.Failed, pilot.MaxFailurePercent]
        @if (pilot.ReleaseUtc is { } release)
        {
            <span>&nbsp;@(pilot.WithinLimit ? L["They follow {0}.", Display.LocalTime(release)] : L["Too many failed: the deployment stops."])</span>
        }
        else
        {
            <span>&nbsp;@L["{0} computers of the pilot group are not finished yet.", pilot.Pending]</span>
        }
        <OperatorOnly>
            <div class="mt-2">
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="Running" OnClick="ReleaseAsync">@L["Start the remaining computers now"]</MudButton>
            </div>
        </OperatorOnly>
    </MudAlert>
}

@if (_deployment.StopReason is not null)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-4">@_deployment.StopReason – @L["the remaining computers were not started."]</MudAlert>
}

@if (Running)
{
    <MudProgressLinear Color="Color.Info" Value="@(100d * _deployment.Targets.Count(t => t.FinishedUtc is not null) / _deployment.Targets.Count)" Class="mb-4" />
}

<MudExpansionPanels MultiExpansion="true" Outlined="true" Elevation="0">
    @foreach (var target in _deployment.Targets)
    {
        var live = DeploymentService.GetLive(target.Id);
        <MudExpansionPanel @key="target.Id" Expanded="@(_deployment.Targets.Count == 1)">
            <TitleContent>
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudText Style="min-width: 12rem">@target.ComputerName</MudText>
                    <MudChip T="string" Size="Size.Small" Color="@Display.StatusColor(target.Status)">@Display.Status(target.Status)</MudChip>
                    @if (live?.CurrentStep is not null)
                    {
                        <MudText Typo="Typo.caption">@live.CurrentStep</MudText>
                    }
                    else if (target.Error is not null)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error">@target.Error</MudText>
                    }
                </MudStack>
            </TitleContent>
            <ChildContent>
                @if (live is not null)
                {
                    <pre class="run-output">@live.Output</pre>
                }
                else if (target.Steps.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@(target.Status == TargetStatus.Queued ? L["Waiting for a free slot."] : target.Status == TargetStatus.WaitingPilot ? L["Waiting for the pilot group"] : target.Error ?? L["No step was executed."])</MudText>
                }
                else
                {
                    @foreach (var step in target.Steps)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-2">
                            <MudText Typo="Typo.body2">@(step.Index + 1). @step.Name</MudText>
                            <MudChip T="string" Size="Size.Small" Color="@Display.StatusColor(step.Status)">@Display.Status(step.Status)</MudChip>
                            @if (step.ExitCode is { } exitCode)
                            {
                                <MudText Typo="Typo.caption">@L["Exit code {0}", exitCode]</MudText>
                            }
                            @if (step.Status != StepStatus.Skipped)
                            {
                                <MudText Typo="Typo.caption">@step.DurationSeconds.ToString("N1") s</MudText>
                            }
                            @if (step.Error is not null)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Error">@step.Error</MudText>
                            }
                        </MudStack>
                        @if (!string.IsNullOrWhiteSpace(step.Output))
                        {
                            <pre class="run-output">@step.Output</pre>
                        }
                    }
                }
            </ChildContent>
        </MudExpansionPanel>
    }
</MudExpansionPanels>

@code {
    [Parameter] public int Id { get; set; }

    private Deployment? _deployment;
    private bool _loaded;
    private Timer? _liveRefresh;

    private bool Running => DeploymentService.IsRunning(Id);
    private bool Waiting => _deployment!.Targets.Any(t => t.Status.IsWaiting());
    private List<DeploymentTarget> FailedTargets =>
        _deployment!.Targets.Where(t => t.Status is TargetStatus.Failed or TargetStatus.Cancelled && t.ComputerId is not null).ToList();

    protected override void OnInitialized() => DeploymentService.Changed += OnChanged;

    protected override async Task OnParametersSetAsync()
    {
        _deployment = await DeploymentService.GetAsync(Id);
        _loaded = true;
        // Die Live-Ausgabe ändert sich zeilenweise ohne eigenes Ereignis; solange etwas läuft, regelmäßig neu zeichnen.
        _liveRefresh ??= new Timer(_ =>
        {
            if (Running)
                InvokeAsync(StateHasChanged);
        }, null, 500, 500);
    }

    private void OnChanged(int deploymentId)
    {
        if (deploymentId != Id)
            return;
        InvokeAsync(async () =>
        {
            _deployment = await DeploymentService.GetAsync(Id);
            StateHasChanged();
        });
    }

    private async Task CancelAsync()
    {
        if (!await Access.DemandOperatorAsync())
            return;
        await Audit.LogAsync(L["Deployment cancelled"], $"#{Id} {_deployment!.PackageName}");
        await DeploymentService.CancelAsync(Id);
    }

    private async Task ReleaseAsync()
    {
        if (!await Access.DemandOperatorAsync())
            return;
        var started = await DeploymentService.ReleasePilotAsync(Id, force: true);
        if (started > 0)
            await Audit.LogAsync(L["Deployment released after the pilot group"], $"#{Id} {_deployment!.PackageName}: {started}");
        else
            Snackbar.Add(L["Nothing was started: computers of this deployment are still running."], Severity.Warning);
    }

    private async Task RetryAsync()
    {
        if (!await Access.DemandOperatorAsync())
            return;
        try
        {
            var retry = await DeploymentService.StartAsync(_deployment!.PackageId!.Value, FailedTargets.Select(t => t.ComputerId!.Value), new DeploymentOptions(_deployment.ScanAfter, _deployment.RetryOffline, _deployment.RespectMaintenanceWindow,
                    _deployment.MaxFailures, _deployment.MaxFailurePercent, _deployment.MaxParallel) { RequireApproved = !await Access.IsAdminAsync(), Wake = _deployment.WakeTargets });
            await Audit.LogAsync(L["Deployment retried"], L["#{0} {1} on {2}", retry.Id, retry.PackageName, string.Join(", ", retry.Targets.Select(t => t.ComputerName))]);
            Navigation.NavigateTo($"deployments/{retry.Id}");
        }
        catch (Exception ex) when (ex is InvalidOperationException or KeyNotFoundException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    public void Dispose()
    {
        DeploymentService.Changed -= OnChanged;
        _liveRefresh?.Dispose();
    }
}
