@page "/updates"
@inject ReportService Reports
@inject UpdatePolicyService PolicyOverview
@inject IStringLocalizer<SharedResource> L
@inject Display Display
@inject PackageService PackageService
@inject IDialogService Dialogs
@inject Auditor Audit
@inject Access Access
@inject ISnackbar Snackbar

<PageTitle>@L["Updates"] – Inventory</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
    <MudText Typo="Typo.h5">@L["Updates"]</MudText>
    <MudSpacer />
    <MudTextField @bind-Value="_search" Placeholder="@L["Search KB number, title or computer"]" Adornment="Adornment.Start" Immediate="true"
                  AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 320px" />
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" Href="api/reports/updates.csv" Target="_blank">@L["Pending updates (CSV)"]</MudButton>
</MudStack>

@if (_report is not null)
{
    <MudText Typo="Typo.body2" Class="mb-4">
        @L["{0} of {1} computers have no pending security updates.", _report.Compliant, _report.Computers.Count]
        @L["The numbers reflect each computer's last own update search at the time of its last scan; a scan does not trigger a search."]
    </MudText>

    <MudTabs Outlined="true" Border="true" TabPanelsClass="pt-4" ApplyEffectsToContainer="true">
        <MudTabPanel Text="@($"{L["By update"]} ({_report.Updates.Count})")">
            <MudGrid>
                <MudItem xs="12" lg="@(_selected is null ? 12 : 8)">
                    <MudDataGrid T="PendingUpdateSummary" Items="_report.Updates" Dense="true" Hover="true" SortMode="SortMode.Single" RowsPerPage="50"
                                 QuickFilter="@(u => Matches([u.KbIds, u.Title, .. u.ComputerNames]))">
                        <Columns>
                            <TemplateColumn Sortable="true" Title="KB" SortBy="u => u.KbIds" CellStyle="white-space: nowrap">
                                <CellTemplate>@(context.Item.KbIds ?? "–")</CellTemplate>
                            </TemplateColumn>
                            <PropertyColumn Property="u => u.Title" Title="@L["Update title"]" />
                            <TemplateColumn Sortable="true" Title="@L["Classification"]" SortBy="u => u.Classification">
                                <CellTemplate>@(context.Item.Classification is null ? "" : L[context.Item.Classification])</CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Sortable="true" Title="@L["Severity"]" SortBy="u => u.Severity">
                                <CellTemplate>
                                    @if (context.Item.Severity is not null)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="@Display.SeverityColor(context.Item.Severity)">@L[context.Item.Severity]</MudChip>
                                    }
                                    else if (context.Item.IsSecurity)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">@L["Security"]</MudChip>
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Sortable="true" Title="@L["Computers"]" SortBy="u => u.Computers">
                                <CellTemplate><MudLink OnClick="@(() => SelectAsync(context.Item))">@context.Item.Computers</MudLink></CellTemplate>
                            </TemplateColumn>
                        </Columns>
                        <NoRecordsContent>
                            <MudText Class="pa-4">@L["No pending updates recorded. Details are captured with the next scan of each computer."]</MudText>
                        </NoRecordsContent>
                        <PagerContent>
                            <MudDataGridPager T="PendingUpdateSummary" PageSizeOptions="@(new[] { 50, 100, 500 })" RowsPerPageString="@L["Rows per page"]" />
                        </PagerContent>
                    </MudDataGrid>
                </MudItem>
                @if (_selected is not null)
                {
                    <MudItem xs="12" lg="4">
                        <MudPaper Class="pa-4" Outlined="true">
                            <MudStack Row="true" AlignItems="AlignItems.Start">
                                <div style="flex: 1">
                                    <MudText Typo="Typo.h6">@(_selected.KbIds ?? _selected.Title)</MudText>
                                    <MudText Typo="Typo.body2">@_selected.Title</MudText>
                                    <MudText Typo="Typo.body2">@L["Missing on {0} computers", _computers.Count]</MudText>
                                </div>
                                <MudTooltip Text="@L["Close"]"><MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" aria-label="@L["Close"]" OnClick="@(() => _selected = null)" /></MudTooltip>
                            </MudStack>
                            @if (_selected.KbIds is not null)
                            {
                                <AdminOnly>
                                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="mt-2" StartIcon="@Icons.Material.Filled.SystemUpdateAlt" Disabled="@(_computers.Count == 0)" OnClick="InstallAsync">@L["Install …"]</MudButton>
                                </AdminOnly>
                            }
                            <MudList T="string" Dense="true">
                                @foreach (var computer in _computers)
                                {
                                    <MudListItem T="string" Href="@($"computers/{computer.Id}")">@computer.Name</MudListItem>
                                }
                            </MudList>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        </MudTabPanel>
        <MudTabPanel Text="@($"{L["By computer"]} ({_report.Computers.Count})")">
            <MudDataGrid T="Computer" Items="_report.Computers" Dense="true" Hover="true" SortMode="SortMode.Single" RowsPerPage="50"
                         QuickFilter="@(c => Matches(c.Name))">
                <Columns>
                    <TemplateColumn Sortable="true" Title="@L["Computer"]" SortBy="c => c.Name">
                        <CellTemplate><MudLink Href="@($"computers/{context.Item.Id}")">@context.Item.Name</MudLink></CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Sortable="true" Title="@L["Status"]" SortBy="c => c.UpdatePendingSecurityCount">
                        <CellTemplate>
                            <MudChip T="string" Size="Size.Small" Color="@(context.Item.UpdatePendingSecurityCount > 0 ? Color.Warning : context.Item.UpdatePendingSecurityCount == 0 ? Color.Success : Color.Default)">
                                @(context.Item.UpdatePendingSecurityCount switch { null => L["unknown"], 0 => L["up to date"], _ => L["security updates missing"] })
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="c => c.UpdatePendingSecurityCount" Title="@L["Pending security updates"]" />
                    <PropertyColumn Property="c => c.UpdatePendingCount" Title="@L["Pending updates"]" />
                    <TemplateColumn Sortable="true" Title="@L["Reboot pending"]" SortBy="c => c.UpdateRebootRequired">
                        <CellTemplate>@(context.Item.UpdateRebootRequired == true ? L["yes"] : "")</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Sortable="true" Title="@L["Last installation"]" SortBy="c => c.UpdateLastInstallUtc">
                        <CellTemplate>@Display.LocalTime(context.Item.UpdateLastInstallUtc)</CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Sortable="true" Title="@L["Last search"]" SortBy="c => c.UpdateLastSearchUtc">
                        <CellTemplate>@Display.LocalTime(context.Item.UpdateLastSearchUtc)</CellTemplate>
                    </TemplateColumn>
                </Columns>
                <PagerContent>
                    <MudDataGridPager T="Computer" PageSizeOptions="@(new[] { 50, 100, 500 })" RowsPerPageString="@L["Rows per page"]" />
                </PagerContent>
            </MudDataGrid>
        </MudTabPanel>
        @if (_policies is not null)
        {
            <MudTabPanel Text="@($"{L["Policies"]} ({_policies.Policies.Count})")">
                <MudText Typo="Typo.body2" Class="mb-3">
                    @L["Computers with the same Windows Update policy: the same values from the same GPOs or from Intune."]
                    @if (_policies.ComputersWithConflicts > 0)
                    {
                        @(" ")
                        <MudText Typo="Typo.body2" Color="Color.Warning" Inline="true">@L["Computers with conflicting GPOs: {0}.", _policies.ComputersWithConflicts]</MudText>
                    }
                </MudText>
                <MudExpansionPanels MultiExpansion="true" Outlined="true">
                    @foreach (var policy in _policies.Policies.Where(PolicyMatches))
                    {
                        <MudExpansionPanel>
                            <TitleContent>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
                                    <MudText Typo="Typo.subtitle2">@PolicyTitle(policy)</MudText>
                                    <MudChip T="string" Size="Size.Small">@L["{0} computers", policy.Computers.Count]</MudChip>
                                    @if (policy.Computers.Any(c => c.Conflicts))
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">@L["Conflicting GPOs"]</MudChip>
                                    }
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@PolicyLine(policy)</MudText>
                                </MudStack>
                            </TitleContent>
                            <ChildContent>
                                @foreach (var setting in policy.Settings.OrderBy(UpdatePolicies.IsMdm).ThenBy(s => s.Key == UpdatePolicyKeys.AutoUpdate).ThenBy(s => s.Name, StringComparer.OrdinalIgnoreCase))
                                {
                                    <MudText Typo="Typo.body2">
                                        @UpdatePolicies.Label(setting, L): <b>@UpdatePolicies.Display(setting, L)</b>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Inline="true">@(setting.Gpo ?? (UpdatePolicies.IsMdm(setting) ? "Intune" : ""))</MudText>
                                    </MudText>
                                }
                                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-3">
                                    @foreach (var computer in policy.Computers)
                                    {
                                        <MudChip T="string" Size="Size.Small" Href="@($"computers/{computer.Id}")" Color="@(computer.Conflicts ? Color.Warning : Color.Default)">@computer.Name</MudChip>
                                    }
                                </MudStack>
                            </ChildContent>
                        </MudExpansionPanel>
                    }
                    @{
                        // Keine Richtlinie, nach der sich gruppieren ließe: Hier filtert die Suche die Rechner selbst.
                        var notCaptured = _policies.NotCaptured.Where(c => Matches(c.Name)).ToList();
                    }
                    @if (notCaptured.Count > 0)
                    {
                        <MudExpansionPanel>
                            <TitleContent>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
                                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@L["Not captured yet"]</MudText>
                                    <MudChip T="string" Size="Size.Small">@L["{0} computers", notCaptured.Count]</MudChip>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Not scanned since the update of Inventory, or not reachable."]</MudText>
                                </MudStack>
                            </TitleContent>
                            <ChildContent>
                                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                                    @foreach (var computer in notCaptured)
                                    {
                                        <MudChip T="string" Size="Size.Small" Href="@($"computers/{computer.Id}")">@computer.Name</MudChip>
                                    }
                                </MudStack>
                            </ChildContent>
                        </MudExpansionPanel>
                    }
                </MudExpansionPanels>
            </MudTabPanel>
        }
    </MudTabs>
}

@code {
    /// <summary>Vorbelegung der Suche, z. B. aus dem Link einer KB-Nummer auf der Rechnerseite.</summary>
    [SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }

    private PatchCompliance? _report;
    private UpdatePolicyOverview? _policies;
    private PendingUpdateSummary? _selected;
    private List<Computer> _computers = [];
    private string _search = "";

    protected override async Task OnInitializedAsync()
    {
        _report = await Reports.PatchComplianceAsync();
        _policies = await PolicyOverview.OverviewAsync();
        _search = Query ?? "";
        // Führt die Suche auf genau ein Update, zeigt die Seite gleich dessen Rechner.
        if (Query is not null && _report.Updates.FirstOrDefault(u => string.Equals(u.Key, Query, StringComparison.OrdinalIgnoreCase)) is { } match)
            await SelectAsync(match);
    }

    /// <summary>Legt bei Bedarf das Paket für genau dieses Update an und öffnet den Deploy-Dialog mit den betroffenen Rechnern.</summary>
    private async Task InstallAsync()
    {
        if (!await Access.DemandAdminAsync())
            return;
        try
        {
            var (package, created) = await PackageService.EnsureUpdatePackageAsync(_selected!.KbIds!, approvedBy: await Audit.UserNameAsync());
            if (created)
                await Audit.LogAsync(L["Package created"], package.Name);
            var parameters = new DialogParameters<DeployDialog> { { d => d.PackageId, package.Id }, { d => d.ComputerIds, _computers.Select(c => c.Id).ToList() } };
            await Dialogs.ShowAsync<DeployDialog>(L["Deploy \"{0}\"", package.Name], parameters, new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    /// <summary>Die GPOs, sonst woher die Werte kommen.</summary>
    private string PolicyTitle(UpdatePolicyGroup policy) =>
        policy.Summary.Gpos.Count > 0 ? string.Join(", ", policy.Summary.Gpos)
        : policy.NotConfigured ? L["Not configured (Windows defaults)"]
        : policy.Settings.All(UpdatePolicies.IsMdm) ? "Intune"
        : L["Without GPO (preference, script or set by hand)"];

    private string PolicyLine(UpdatePolicyGroup policy) => string.Join(" · ", new[]
    {
        policy.Summary.Source, policy.Summary.TargetGroup is { } group ? L["target group {0}", group].Value : null, policy.Summary.Automatic, policy.Summary.Deferral,
    }.Where(p => p is not null));

    private bool PolicyMatches(UpdatePolicyGroup policy) =>
        Matches(PolicyTitle(policy), policy.Summary.TargetGroup, policy.Summary.Source) || policy.Computers.Any(c => Matches(c.Name));

    private bool Matches(params string?[] values) =>
        string.IsNullOrWhiteSpace(_search) || values.Any(v => v?.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase) == true);

    private async Task SelectAsync(PendingUpdateSummary update)
    {
        _selected = update;
        _computers = await Reports.ComputersMissingUpdateAsync(update.Key);
    }
}
