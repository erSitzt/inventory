@page "/changes"
@inject InventoryStore Store
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Changes"] – Inventory</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h5">@L["Changes"]</MudText>
    <MudSpacer />
    <MudTextField @bind-Value="_search" Placeholder="@L["Computer, program, user …"]" Adornment="Adornment.Start" Immediate="true"
                  AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 320px" />
</MudStack>

<MudText Typo="Typo.body2" Class="mb-4">
    @L["What changed from scan to scan: software, hotfixes, hardware, services, local users and administrators. The last {0} entries are shown; the history is kept for two years. The list refreshes itself.", MaxRows]
</MudText>
<AutoRefresh OnTick="RefreshAsync" />

@if (_changes.Count == 0)
{
    <MudAlert Severity="Severity.Info">@L["No changes recorded yet. The first scan of a computer is the baseline; the history starts with the second."]</MudAlert>
}
else
{
    <ChangeGrid Changes="_changes" Search="@_search" />
}

@code {
    private const int MaxRows = 5000;

    private List<(InventoryChange Change, string Computer)> _changes = [];
    private string _search = "";

    private long _latest;

    protected override async Task OnInitializedAsync()
    {
        _latest = await Store.LatestChangeIdAsync();
        _changes = await Store.ChangesAsync(null, MaxRows);
    }

    private async Task RefreshAsync()
    {
        var latest = await Store.LatestChangeIdAsync();
        if (latest == _latest)
            return;
        _latest = latest;
        _changes = await Store.ChangesAsync(null, MaxRows);
    }
}
