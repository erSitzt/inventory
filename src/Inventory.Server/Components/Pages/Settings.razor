    private async Task LoadHeartbeatAsync()
    {
        var hb = await Heartbeat.GetSettingsAsync();
        (_hbEnabled, _hbIntervalMinutes, _hbLastRunUtc, _hbLastResult) = (hb.Enabled, hb.IntervalMinutes, hb.LastRunUtc, hb.LastResult);
    }

    private async Task SaveHeartbeatAsync()
    {
        await Heartbeat.SaveSettingsAsync(_hbEnabled, _hbIntervalMinutes);
        await Audit.LogAsync(L["Setting changed"], $"Heartbeat: {(_hbEnabled ? L["on, every {0} min", _hbIntervalMinutes] : Display.OnOff(false))}");
        Snackbar.Add(L["Saved."], Severity.Success);
    }

    private async Task RunHeartbeatAsync()
    {
        _hbBusy = true;
        _hbMessage = null;
        try
        {
            await Heartbeat.SaveSettingsAsync(_hbEnabled, _hbIntervalMinutes);
            _hbMessage = await Heartbeat.RunAsync();
        }
        finally
        {
            _hbBusy = false;
            var hb = await Heartbeat.GetSettingsAsync();
            (_hbLastRunUtc, _hbLastResult) = (hb.LastRunUtc, hb.LastResult);
        }
    }

    private async Task LoadAdAsync()
    {
        _credentials = await CredentialService.ListAsync();
        var ad = await AdSync.GetSettingsAsync();
        (_adEnabled, _adServer, _adBaseDns, _adCredentialId, _adIntervalHours, _adLastRunUtc, _adLastResult) =
            (ad.Enabled, ad.Server, ad.BaseDns?.Replace(";", "\n"), ad.CredentialId, ad.IntervalHours, ad.LastRunUtc, ad.LastResult);
        (_adExcludeDisabled, _adMissingAction, _adMissingDays) = (ad.ExcludeDisabled, ad.MissingAction, ad.MissingDays);
    }

    private async Task SaveAdAsync()
    {
        await AdSync.SaveSettingsAsync(_adEnabled, _adServer, _adBaseDns, _adCredentialId, _adIntervalHours, _adExcludeDisabled, _adMissingAction, _adMissingDays);
        await Audit.LogAsync(L["Setting changed"], L["AD synchronization: {0}, server {1}, every {2} h, disabled accounts {3}, missing computers: {4}",
            Display.OnOff(_adEnabled), _adServer ?? L["(domain)"], _adIntervalHours, _adExcludeDisabled ? L["excluded"] : L["included"],
            _adMissingAction == AdMissingAction.Delete ? L["delete after {0} days", _adMissingDays] : L["keep"]]);
        Snackbar.Add(L["Saved."], Severity.Success);
    }

    private async Task PreviewAdAsync()
    {
        await RunAdAsync(async () =>
        {
            var preview = await AdSync.PreviewAsync();
            static string Names(List<string> names) => names.Count == 0 ? "" : ": " + string.Join(", ", names.Take(15)) + (names.Count > 15 ? " …" : "");
            var text = L["{0} computer accounts found ({1} disabled). To be created: {2}{3}. Not in AD: {4}{5}.",
                preview.Total, preview.Disabled, preview.NewNames.Count, Names(preview.NewNames), preview.MissingNames!.Count, Names(preview.MissingNames)].Value;
            if (preview.DeleteNames!.Count > 0)
                text += " " + (preview.DeleteBlocked
                    ? L["{0} would be deleted – conspicuously many at once, so the run would delete nothing.", preview.DeleteNames.Count]
                    : L["The next run deletes {0}{1}.", preview.DeleteNames.Count, Names(preview.DeleteNames)]);
            return text;
        });
    }

    private Task SyncAdAsync() => RunAdAsync(() => AdSync.SyncAsync());

    /// <summary>Speichert zuerst, damit Vorschau und Sync mit den gerade angezeigten Werten laufen.</summary>
    private async Task RunAdAsync(Func<Task<string>> action)
    {
        _adBusy = true;
        _adMessage = null;
        try
        {
            await AdSync.SaveSettingsAsync(_adEnabled, _adServer, _adBaseDns, _adCredentialId, _adIntervalHours, _adExcludeDisabled, _adMissingAction, _adMissingDays);
            _adMessage = await action();
            _adSeverity = _adMessage.StartsWith(L["Error"]) ? Severity.Error : Severity.Success;
        }
        catch (Inventory.Core.Abstractions.RemoteException ex)
        {
            _adMessage = ex.Message;
            _adSeverity = Severity.Error;
        }
        finally
        {
            _adBusy = false;
            var ad = await AdSync.GetSettingsAsync();
            (_adLastRunUtc, _adLastResult) = (ad.LastRunUtc, ad.LastResult);
        }
    }

