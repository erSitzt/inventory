@page "/settings"
@attribute [Authorize(Policy = AccessControl.AdminPolicy)]
@using Microsoft.Extensions.Options
@inject SettingsService SettingsService
@inject AdSyncService AdSync
@inject HeartbeatService Heartbeat
@inject MaintenanceService Maintenance
@inject AgentService Agents
@inject UpdateService Updates
@inject Inventory.Remoting.RunnerPackage Runner
@inject Inventory.Remoting.DefenderClient Defender
@implements IDisposable
@inject CredentialService CredentialService
@inject IOptions<InventoryOptions> Options
@inject ISnackbar Snackbar
@inject Auditor Audit
@inject Access Access
@inject Display Display
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Settings"] – Inventory</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">@L["Settings"]</MudText>

<MudPaper Class="pa-4" Style="max-width: 640px" Outlined="true">
    <MudStack Spacing="4">
        <MudSelect T="TransportKind" Value="_transport" ValueChanged="SetTransportAsync" Label="@L["Default transport"]" Variant="Variant.Outlined"
                   HelperText="@L["Applies to all computers without a transport of their own."]">
            <MudSelectItem T="TransportKind" Value="TransportKind.SmbService">@Display.Transport(TransportKind.SmbService)</MudSelectItem>
            <MudSelectItem T="TransportKind" Value="TransportKind.WinRm">@Display.Transport(TransportKind.WinRm)</MudSelectItem>
        </MudSelect>
        <MudText Typo="Typo.body2">
            @L["Endpoint protection often rates agentless access (a service started remotely, files copied to ADMIN$) as suspicious. Computers with the agent need neither; the README describes how to allow the rest narrowly."]
        </MudText>
        <MudSelect T="AgentlessPolicy" Value="_agentless" ValueChanged="SetAgentlessAsync" Label="@L["Agentless access"]" Variant="Variant.Outlined"
                   HelperText="@L["Restricting it keeps scans, deployments and schedules from reaching computers without an agent; they fail there with a clear message."]">
            @foreach (var policy in Enum.GetValues<AgentlessPolicy>())
            {
                <MudSelectItem T="AgentlessPolicy" Value="policy">@Display.Agentless(policy)</MudSelectItem>
            }
        </MudSelect>
        <MudTextField T="string" Value="@Runner.ExeSha256" ReadOnly="true" Label="@L["SHA-256 of InventoryRunner.exe"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                      HelperText="@L["The value for an allow rule by file hash in your endpoint protection. It changes with every server update."]" />
        <MudSwitch T="bool" Value="_fallback" ValueChanged="SetFallbackAsync" Color="Color.Primary"
                   Label="@L["Try the other transport on delivery errors"]" />
        <MudSwitch T="bool" Value="_verifyName" ValueChanged="SetVerifyNameAsync" Color="Color.Primary"
                   Label="@L["Verify computer name before execution"]" />
        <MudText Typo="Typo.body2">
            @L["Commands and deployments only run if the reached computer has the listed name. This prevents a stale DNS entry from steering an installation to a foreign computer. Scans are exempt: they still run and thus show which computer actually responds. The captured data then belongs to that computer, and the entry does not count as online."]
        </MudText>
        <MudText Typo="Typo.body2">
            @L["SMB + service needs the ADMIN$ share and the Service Control Manager (port 445); the job runs as Local System. WinRM needs PowerShell remoting enabled (port 5985); the job runs with the stored account."]
        </MudText>
        <MudSwitch T="bool" Value="_autoApprove" ValueChanged="SetAutoApproveAsync" Color="Color.Primary"
                   Label="@L["Keep the approval when library packages update automatically"]" />
        <MudText Typo="Typo.body2">
            @L["Operators and schedules only deploy approved packages. If this is off, an automatically updated library package has to be approved again by an administrator before schedules deploy the new version."]
        </MudText>
        <MudNumericField T="int" Value="_maxParallel" ValueChanged="SetMaxParallelAsync" Min="1" Max="128" Label="@L["Computers served at once"]" Variant="Variant.Outlined"
                         HelperText="@L["Across all deployments. A deployment can set a lower limit of its own."]" />
        <MudNumericField T="int" Value="_rebootWait" ValueChanged="SetRebootWaitAsync" Min="5" Max="1440" Label="@L["Wait for restart (minutes)"]" Variant="Variant.Outlined"
                         HelperText="@L["How long a computer may take to come back after a restart step. After that the deployment counts as failed for this computer."]" />
        <MudNumericField T="int" Value="_auditDays" ValueChanged="SetAuditDaysAsync" Min="0" Max="@Inventory.Data.Services.SettingsService.MaxAuditRetentionDays" Label="@L["Keep audit log entries (days)"]" Variant="Variant.Outlined"
                         HelperText="@L["Older entries are removed once a day. 0 keeps everything."]" />
        <MudNumericField T="int" Value="_deploymentDays" ValueChanged="SetDeploymentDaysAsync" Min="0" Max="@Inventory.Data.Services.SettingsService.MaxAuditRetentionDays" Label="@L["Keep finished deployments (days)"]" Variant="Variant.Outlined"
                         HelperText="@L["Older deployments are removed once a day, with their output. 0 keeps everything; otherwise at least 30 days. Deployments of required schedules stay."]" />
        <MudTextField Value="@Options.Value.ResolveDataDirectory()" Label="@L["Data directory"]" Variant="Variant.Outlined" ReadOnly="true"
                      HelperText="@L["Database, keys, package files and daily backups (subfolder backups, 14 copies of database and keys). Package files are not part of the backup – include the folder in the backup of the server if you need them. Configurable via Inventory:DataDirectory."]" />
        <MudText Typo="Typo.body2">
            @L["Sign-in:"]
            @if (!Options.Value.AuthenticationEnabled)
            {
                <span>@L["disabled"]</span>
            }
            @if (Options.Value.ResolveWindowsAuthentication())
            {
                <span>@L["Windows sign-in, allowed for {0}.", RoleLine(Options.Value.DescribeAllowedGroups(), InventoryOptions.Describe(Options.Value.Roles.Operator), InventoryOptions.Describe(Options.Value.Roles.Viewer))] </span>
            }
            @if (Options.Value.OidcEnabled)
            {
                <span>@L["{0} ({1}), allowed for {2}.", Options.Value.Oidc.DisplayName, Options.Value.Oidc.ResolveAuthority(), RoleLine(Options.Value.Oidc.AllowedGroups.Concat(Options.Value.Oidc.Roles.Admin), Options.Value.Oidc.Roles.Operator, Options.Value.Oidc.Roles.Viewer)]</span>
            }
        </MudText>
        @if (!Options.Value.AuthenticationEnabled && !Options.Value.ResolveSimulate())
        {
            <MudAlert Severity="Severity.Error">@L["Sign-in is disabled: anyone who can reach this address can run commands on the target computers with the stored credentials."]</MudAlert>
        }
        @if (Options.Value.ResolveSimulate())
        {
            <MudAlert Severity="Severity.Warning">@L["Simulation mode: no real access to target computers takes place."]</MudAlert>
        }
    </MudStack>
</MudPaper>

<MudPaper Class="pa-4 mt-4" Style="max-width: 640px" Outlined="true">
    <MudStack Spacing="3">
        <MudText Typo="Typo.h6">@L["Maintenance window"]</MudText>
        <MudText Typo="Typo.body2">
            @L["Deployments and schedules with the option \"Only within the maintenance window\" run on a computer only while its window is open; otherwise the computer waits (at most 8 days). Collections can have windows of their own. The default window below applies to all computers that are in no such collection. Remote commands and scans are never held back."]
        </MudText>
        <MaintenanceWindowEditor Value="_defaultWindow" ValueChanged="SetDefaultWindowAsync" Label="@L["Default maintenance window"]" />
    </MudStack>
</MudPaper>

<MudPaper Class="pa-4 mt-4" Style="max-width: 640px" Outlined="true">
    <MudStack Spacing="3">
        <MudText Typo="Typo.h6">Heartbeat</MudText>
        <MudText Typo="Typo.body2">
            @L["Checks the reachability of all computers at fixed intervals so the online status in the computer list and on the overview stays current. Computers with name anomalies – a different computer responds under the name, or reverse DNS names another – are skipped until the discrepancy is resolved."]
        </MudText>
        <MudSwitch T="bool" @bind-Value="_hbEnabled" Color="Color.Primary" Label="@L["Check reachability regularly"]" />
        <MudNumericField T="int" @bind-Value="_hbIntervalMinutes" Label="@L["Interval (minutes)"]" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="1440"
                         HelperText="@L["The check is lightweight (port 445, a few packets per computer); 5 minutes is a good value"]" />
        <MudStack Row="true" Wrap="Wrap.Wrap">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveHeartbeatAsync">@L["Save"]</MudButton>
            <MudButton Variant="Variant.Outlined" Disabled="_hbBusy" OnClick="RunHeartbeatAsync">@L["Check now"]</MudButton>
        </MudStack>
        @if (_hbMessage is not null)
        {
            <MudAlert Severity="Severity.Success" Dense="true">@_hbMessage</MudAlert>
        }
        @if (_hbLastResult is not null)
        {
            <MudText Typo="Typo.caption">@L["Last run {0}: {1}", Display.LocalTime(_hbLastRunUtc), _hbLastResult]</MudText>
        }
    </MudStack>
</MudPaper>

<MudPaper Class="pa-4 mt-4" Style="max-width: 640px" Outlined="true">
    <MudStack Spacing="3">
        <MudText Typo="Typo.h6">Active Directory</MudText>
        <MudText Typo="Typo.body2">
            @L["Creates computers from the directory's computer accounts and marks computers whose account is no longer found there. Manually added computers the directory never knew remain untouched."]
        </MudText>
        <MudSwitch T="bool" @bind-Value="_adEnabled" Color="Color.Primary" Label="@L["Synchronize regularly"]" />
        <MudTextField @bind-Value="_adServer" Label="@L["Domain controller or domain"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                      HelperText="@L["Empty = the domain this server belongs to"]" />
        <MudTextField @bind-Value="_adBaseDns" Label="@L["Search roots (OUs)"]" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3"
                      Placeholder="OU=Clients,DC=example,DC=local" HelperText="@L["One per line; empty = whole domain"]" />
        <MudSelect T="int?" @bind-Value="_adCredentialId" Label="@L["Credentials"]" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                   Placeholder="@L["Account of the server service"]">
            @foreach (var credential in _credentials)
            {
                <MudSelectItem T="int?" Value="@credential.Id">@credential.Name (@credential.Username)</MudSelectItem>
            }
        </MudSelect>
        <MudNumericField T="int" @bind-Value="_adIntervalHours" Label="@L["Interval (hours)"]" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="720" />
        <MudSwitch T="bool" @bind-Value="_adExcludeDisabled" Color="Color.Primary" Label="@L["Exclude disabled computer accounts"]" />
        <MudText Typo="Typo.caption">
            @L["Disabled accounts are not created; if an existing computer is disabled in the directory, it counts as no longer found."]
        </MudText>
        <MudSelect T="AdMissingAction" @bind-Value="_adMissingAction" Label="@L["Computers no longer found in the directory"]" Variant="Variant.Outlined" Margin="Margin.Dense">
            <MudSelectItem Value="AdMissingAction.Keep">@L["Keep and mark as \"not in AD\""]</MudSelectItem>
            <MudSelectItem Value="AdMissingAction.Delete">@L["Mark and delete after a grace period"]</MudSelectItem>
        </MudSelect>
        @if (_adMissingAction == AdMissingAction.Delete)
        {
            <MudNumericField T="int" @bind-Value="_adMissingDays" Label="@L["Grace period (days)"]" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="3650"
                             HelperText="@L["A computer must be missing continuously for this long before it is deleted"]" />
            <MudAlert Severity="Severity.Warning" Dense="true">
                @L["Along with the computer, its inventory data and history are deleted. Narrowing the search roots makes all computers outside them count as missing. If conspicuously many computers were to be deleted at once, the run deletes nothing and reports it."]
            </MudAlert>
        }
        <MudText Typo="Typo.caption">
            @L["Marked computers appear in the computer list under the filter \"Not (anymore) in AD\" and can be used in dynamic collections via the rule field \"Not (anymore) in Active Directory\", e.g. to exclude them from schedules."]
        </MudText>
        <MudStack Row="true" Wrap="Wrap.Wrap">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAdAsync">@L["Save"]</MudButton>
            <MudButton Variant="Variant.Outlined" Disabled="_adBusy" OnClick="PreviewAdAsync">@L["Preview"]</MudButton>
            <MudButton Variant="Variant.Outlined" Disabled="_adBusy" OnClick="SyncAdAsync">@L["Synchronize now"]</MudButton>
        </MudStack>
        @if (_adMessage is not null)
        {
            <MudAlert Severity="@_adSeverity" Dense="true">@_adMessage</MudAlert>
        }
        @if (_adLastResult is not null)
        {
            <MudText Typo="Typo.caption">@L["Last run {0}: {1}", Display.LocalTime(_adLastRunUtc), _adLastResult]</MudText>
        }
    </MudStack>
</MudPaper>

<MudPaper id="defender" Class="pa-4 mt-4" Style="max-width: 640px" Outlined="true">
    <MudStack Spacing="3">
        <MudText Typo="Typo.h6">Microsoft Defender</MudText>
        <MudText Typo="Typo.body2">
            @L["Optional: allows the runner file in Microsoft Defender for Endpoint by its hash, so that it is no longer rated as malware. You sign in at Microsoft with your own account; the server stores neither password nor token. This needs an application registration in your tenant (see docs/defender.md) and has to be repeated after every server update. Alerts about the agentless way itself are tuned in the Defender portal."]
        </MudText>
        <MudTextField @bind-Value="_defenderTenant" Label="@L["Tenant ID"]" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
        <MudTextField @bind-Value="_defenderClient" Label="@L["Application (client) ID"]" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
        <MudSwitch T="bool" @bind-Value="_defenderRemoveOld" Color="Color.Primary" Label="@L["Remove the indicators of earlier runners"]" />
        @if (_defenderAllowed is not null)
        {
            @if (string.Equals(_defenderAllowed, Runner.ExeSha256, StringComparison.OrdinalIgnoreCase))
            {
                <MudAlert Severity="Severity.Success" Dense="true">@L["The current runner has been allowed in Defender."]</MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Warning" Dense="true">@L["The runner has changed since the last allowance (server update). Allow it again."]</MudAlert>
            }
        }
        @if (_defenderCode is not null)
        {
            <MudAlert Severity="Severity.Info">
                @L["Open"] <MudLink Href="@_defenderCode.VerificationUri" Target="_blank" rel="noopener">@_defenderCode.VerificationUri</MudLink>
                @L["and enter this code:"] <b style="font-family: monospace; font-size: 1.2em">@_defenderCode.UserCode</b>
                <MudProgressLinear Indeterminate="true" Class="mt-2" />
            </MudAlert>
        }
        @if (_defenderError is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true">@_defenderError</MudAlert>
        }
        <MudStack Row="true">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_defenderBusy || !Inventory.Remoting.DefenderClient.IsValid(_defenderTenant?.Trim(), _defenderClient?.Trim()))" OnClick="AllowInDefenderAsync">@L["Sign in and allow the runner"]</MudButton>
            @if (_defenderBusy)
            {
                <MudButton Variant="Variant.Outlined" OnClick="@(() => _defenderCancel?.Cancel())">@L["Cancel"]</MudButton>
            }
        </MudStack>
    </MudStack>
</MudPaper>

<MudPaper Class="pa-4 mt-4" Style="max-width: 640px" Outlined="true">
    <MudStack Spacing="3">
        <MudText Typo="Typo.h6">@L["Agents"]</MudText>
        <MudText Typo="Typo.body2">
            @L["Optional: a permanently installed agent fetches jobs over an outbound connection – useful for computers the server cannot reach directly (notebooks on the road, other networks). It is installed via \"Computers → Actions → Install agent\". After a server update the agents update themselves on their next request."]
        </MudText>
        <MudTextField @bind-Value="_agentUrl" Label="@L["Address of this server as seen by the agents"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Placeholder="https://inventory.example.local:5100" HelperText="@L["HTTPS recommended: over this connection the agent receives commands that it runs as Local System."]" />
        <MudTextField Value="_agentToken" Label="@L["Enrollment secret"]" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true"
                      HelperText="@L["Passed along at installation. Renewing only blocks new enrollments; existing agents stay connected."]" />
        <MudStack Row="true">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAgentAsync">@L["Save"]</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="RenewAgentTokenAsync">@L["Renew secret"]</MudButton>
        </MudStack>
        <MudDivider />
        <MudText Typo="Typo.body2">
            @L["To install the agent without the server reaching the computers (no ADMIN$, no remote service), distribute the agent setup yourself: unpack it to a share and run Install-Agent.cmd as a computer startup script of a group policy or through your software distribution. Save the server address first. The setup contains the enrollment secret – make the share readable only for the computers that need it."]
        </MudText>
        <div>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" Href="/download/agent-setup" Target="_blank">@L["Download agent setup"]</MudButton>
        </div>
        <MudDivider />
        <MudText Typo="Typo.subtitle2">@L["Download page without sign-in"]</MudText>
        <MudText Typo="Typo.body2">
            @L["To set up a new computer, open this page in its browser: it offers the agent setup, already configured for this server, and a one-line command for PowerShell. Nobody has to sign in."]
        </MudText>
        <MudAlert Severity="Severity.Warning" Dense="true">
            @L["While the page is open, everyone who can reach this server can download the setup with the enrollment secret and register a computer – also under the name of an existing one, which would then receive that computer's jobs. Open it only as long as you need it, keep an eye on \"Agent enrolled\" in the audit log, and renew the secret afterwards if in doubt."]
        </MudAlert>
        <MudSelect T="string" Value="_publicDownload" ValueChanged="SetPublicDownloadAsync" Label="@L["Download page"]" Variant="Variant.Outlined" Margin="Margin.Dense">
            <MudSelectItem T="string" Value="@("off")">@L["closed"]</MudSelectItem>
            <MudSelectItem T="string" Value="@("1h")">@L["open for one hour"]</MudSelectItem>
            <MudSelectItem T="string" Value="@("1d")">@L["open for one day"]</MudSelectItem>
            <MudSelectItem T="string" Value="@("7d")">@L["open for one week"]</MudSelectItem>
            <MudSelectItem T="string" Value="@("forever")">@L["open permanently"]</MudSelectItem>
            @if (_publicDownload == "open")
            {
                <MudSelectItem T="string" Value="@("open")">@L["open until {0}", Display.LocalTime(_publicDownloadUntil)]</MudSelectItem>
            }
        </MudSelect>
        @if (_publicDownloadUntil is not null)
        {
            var link = string.IsNullOrWhiteSpace(_agentUrl) ? $"/{AgentService.PublicPagePath}" : $"{_agentUrl!.TrimEnd('/')}/{AgentService.PublicPagePath}";
            <MudText Typo="Typo.body2">@L["Address for the new computer:"] <MudLink Href="@link" Target="_blank"><b>@link</b></MudLink></MudText>
        }
    </MudStack>
</MudPaper>

<MudPaper id="updates" Class="pa-4 mt-4" Style="max-width: 640px" Outlined="true">
    <MudStack Spacing="3">
        <MudText Typo="Typo.h6">@L["Updates"]</MudText>
        <MudText Typo="Typo.body2">@L["Installed version:"] <b>@Updates.CurrentVersion</b></MudText>
        <MudText Typo="Typo.caption">
            @(Updates.VerifiesSignature
                ? L["Updates are only installed if the setup carries a valid signature of an accepted certificate: a release certificate shipped with this version, or one allowed in the configuration."]
                : L["Updates are not signature-checked; only the checksum secures the download."])
        </MudText>
        @if (Updates.IsDevelopmentBuild)
        {
            <MudAlert Severity="Severity.Info" Dense="true">@L["Locally built development version – no update check."]</MudAlert>
        }
        else if (!Updates.Enabled)
        {
            <MudAlert Severity="Severity.Info" Dense="true">@L["The update check is disabled in the configuration (Inventory:Update:Enabled)."]</MudAlert>
        }
        else
        {
            @if (Updates.UpdateAvailable)
            {
                <MudAlert Severity="Severity.Success" Dense="true">
                    <b>@L["Version {0} is available", Updates.Latest!.Version]</b>
                    @if (Updates.Latest.PublishedUtc is not null)
                    {
                        <span> (@L["published {0}", Display.LocalTime(Updates.Latest.PublishedUtc)])</span>
                    }
                    <span>. </span><MudLink Href="@Updates.Latest.PageUrl" Target="_blank">@L["Changes and download"]</MudLink>
                </MudAlert>
                @if (!string.IsNullOrWhiteSpace(Updates.Latest!.Notes))
                {
                    <pre class="release-notes">@Updates.Latest!.Notes</pre>
                }
                @if (Updates.CannotInstallReason is not null)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true">@L[Updates.CannotInstallReason]</MudAlert>
                }
            }
            else if (Updates.LastCheckUtc is not null && Updates.LastError is null)
            {
                <MudText Typo="Typo.body2">@L["Inventory is up to date (checked {0}, source: github.com/{1}).", Display.LocalTime(Updates.LastCheckUtc), Updates.Repository]</MudText>
            }
            @if (Updates.LastError is not null)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">@Updates.LastError</MudAlert>
            }
            @if (_updateMessage is not null)
            {
                <MudAlert Severity="@_updateSeverity" Dense="true">@_updateMessage</MudAlert>
            }
            <MudStack Row="true" Wrap="Wrap.Wrap">
                <MudButton Variant="Variant.Outlined" Disabled="_updateBusy" OnClick="CheckUpdateAsync">@L["Check now"]</MudButton>
                @if (Updates.UpdateAvailable && Updates.CannotInstallReason is null)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_updateBusy || Updates.Installing)" OnClick="ApplyUpdateAsync">
                        @(Updates.Installing ? L["Installing …"] : L["Update now"])
                    </MudButton>
                }
            </MudStack>
            @if (Updates.CannotInstallReason is null)
            {
                <MudSwitch T="bool" @bind-Value="_updateAuto" Color="Color.Primary" Label="@L["Update automatically in the maintenance window"]" />
                <MudTimePicker @bind-Time="_updateWindow" Label="@L["Start of the maintenance window (2 hours)"]" Variant="Variant.Outlined" Margin="Margin.Dense" Editable="true" Disabled="@(!_updateAuto)" />
                <div><MudButton Variant="Variant.Outlined" OnClick="SaveUpdateSettingsAsync">@L["Save"]</MudButton></div>
            }
            <MudText Typo="Typo.caption">
                @L["The database is backed up before every update; running deployments are awaited. The interface is briefly unavailable meanwhile; agents update themselves afterwards. Note: this path brings new program code onto the server and, via the agents, onto all computers. As long as releases are unsigned, the checksum only secures the transfer, not the origin – which is why automatic updates are off by default."]
            </MudText>
        }
    </MudStack>
</MudPaper>

@code {
    private bool _updateBusy;
    private bool _updateAuto;
    private TimeSpan? _updateWindow = new TimeSpan(3, 0, 0);
    private string? _updateMessage;
    private Severity _updateSeverity;

    private async Task LoadUpdateAsync()
    {
        var current = await Updates.GetSettingsAsync();
        (_updateAuto, _updateWindow) = (current.Automatic, current.WindowStart);
    }

    private async Task CheckUpdateAsync()
    {
        _updateBusy = true;
        _updateMessage = null;
        try
        {
            await Updates.CheckAsync(force: true);
        }
        finally
        {
            _updateBusy = false;
        }
    }

    private async Task ApplyUpdateAsync()
    {
        _updateBusy = true;
        try
        {
            var error = await Updates.ApplyAsync(await Audit.ActorAsync());
            _updateMessage = error ?? L["The update to {0} is running. The service restarts shortly; reload this page afterwards.", Updates.Latest?.Version];
            _updateSeverity = error is null ? Severity.Info : Severity.Error;
        }
        finally
        {
            _updateBusy = false;
        }
    }

    private async Task SaveUpdateSettingsAsync()
    {
        await Updates.SaveSettingsAsync(_updateAuto, _updateWindow ?? new TimeSpan(3, 0, 0));
        await Audit.LogAsync(L["Setting changed"], L["Automatic update: {0}", _updateAuto ? L["on, from {0}", $"{_updateWindow:hh\\:mm}"] : Display.OnOff(false)]);
        Snackbar.Add(L["Saved."], Severity.Success);
    }

    private string? _defenderTenant;
    private string? _defenderClient;
    private string? _defenderAllowed;
    private string? _defenderError;
    private bool _defenderRemoveOld = true;
    private bool _defenderBusy;
    private Inventory.Remoting.DefenderClient.DeviceCode? _defenderCode;
    private CancellationTokenSource? _defenderCancel;

    private async Task AllowInDefenderAsync()
    {
        var (tenant, client) = (_defenderTenant!.Trim(), _defenderClient!.Trim());
        (_defenderBusy, _defenderError) = (true, null);
        _defenderCancel?.Dispose();
        _defenderCancel = new CancellationTokenSource();
        var ct = _defenderCancel.Token;
        try
        {
            await SettingsService.SetAsync(SettingKeys.DefenderTenant, tenant, ct);
            await SettingsService.SetAsync(SettingKeys.DefenderClientId, client, ct);
            _defenderCode = await Defender.BeginSignInAsync(tenant, client, ct);
            StateHasChanged();
            var token = await Defender.WaitForTokenAsync(tenant, client, _defenderCode, ct);
            _defenderCode = null;
            StateHasChanged();
            var result = await Defender.AllowRunnerAsync(token, Runner.ExeSha256,
                $"InventoryRunner.exe of the Inventory server, version {Updates.CurrentVersion} (scans and software deployment)", _defenderRemoveOld, ct);
            await SettingsService.SetAsync(SettingKeys.DefenderAllowedHash, Runner.ExeSha256, ct);
            _defenderAllowed = Runner.ExeSha256;
            await Audit.LogAsync(L["Runner allowed in Microsoft Defender"], L["SHA-256 {0}, {1} earlier indicators removed", Runner.ExeSha256, result.Removed]);
            Snackbar.Add(L["The runner is allowed in Defender; {0} earlier indicators removed.", result.Removed], Severity.Success);
        }
        catch (Inventory.Core.Abstractions.RemoteException ex)
        {
            _defenderError = ex.Message;
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            (_defenderBusy, _defenderCode) = (false, null);
        }
    }

    public void Dispose()
    {
        // Verlässt man die Seite, endet auch das Warten auf die Anmeldung.
        _defenderCancel?.Cancel();
        _defenderCancel?.Dispose();
    }

    private string? _agentUrl;
    private string _publicDownload = "off";
    private DateTime? _publicDownloadUntil;

    private async Task LoadPublicDownloadAsync()
    {
        _publicDownloadUntil = await Agents.GetPublicDownloadUntilAsync();
        _publicDownload = _publicDownloadUntil is null ? "off" : _publicDownloadUntil == AgentService.PublicDownloadForever ? "forever" : "open";
    }

    private async Task SetPublicDownloadAsync(string choice)
    {
        // Die Seite gibt das Anmeldegeheimnis frei: die Rolle wird beim Klick erneut geprüft, nicht nur beim Öffnen der Einstellungen.
        if (choice == "open" || !await Access.DemandAdminAsync())
            return;
        TimeSpan? duration = choice switch
        {
            "1h" => TimeSpan.FromHours(1),
            "1d" => TimeSpan.FromDays(1),
            "7d" => TimeSpan.FromDays(7),
            "forever" => Timeout.InfiniteTimeSpan,
            _ => null,
        };
        await Agents.SetPublicDownloadAsync(duration);
        await LoadPublicDownloadAsync();
        var state = _publicDownload switch
        {
            "off" => L["closed"].Value,
            "forever" => L["open permanently"].Value,
            _ => L["open until {0}", Display.LocalTime(_publicDownloadUntil)].Value,
        };
        await Audit.LogAsync(L["Setting changed"], $"{L["Download page without sign-in"]}: {state}");
        Snackbar.Add(L["Saved."], Severity.Success);
    }
