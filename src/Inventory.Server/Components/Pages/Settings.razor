@page "/settings"
@using Microsoft.Extensions.Options
@inject SettingsService SettingsService
@inject AdSyncService AdSync
@inject AgentService Agents
@inject UpdateService Updates
@inject CredentialService CredentialService
@inject IOptions<InventoryOptions> Options
@inject ISnackbar Snackbar
@inject Auditor Audit

<PageTitle>Einstellungen – Inventory</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Einstellungen</MudText>

<MudPaper Class="pa-4" Style="max-width: 640px" Outlined="true">
    <MudStack Spacing="4">
        <MudSelect T="TransportKind" Value="_transport" ValueChanged="SetTransportAsync" Label="Standard-Transport" Variant="Variant.Outlined"
                   HelperText="Gilt für alle Rechner, bei denen kein eigener Transport eingestellt ist.">
            <MudSelectItem T="TransportKind" Value="TransportKind.SmbService">@Display.Transport(TransportKind.SmbService)</MudSelectItem>
            <MudSelectItem T="TransportKind" Value="TransportKind.WinRm">@Display.Transport(TransportKind.WinRm)</MudSelectItem>
        </MudSelect>
        <MudSwitch T="bool" Value="_fallback" ValueChanged="SetFallbackAsync" Color="Color.Primary"
                   Label="Bei Zustellfehlern den anderen Transport versuchen" />
        <MudSwitch T="bool" Value="_verifyName" ValueChanged="SetVerifyNameAsync" Color="Color.Primary"
                   Label="Rechnernamen vor der Ausführung prüfen" />
        <MudText Typo="Typo.body2">
            Befehle und Deployments laufen nur, wenn der erreichte Rechner so heißt wie eingetragen. Das verhindert, dass ein
            veralteter DNS-Eintrag eine Installation auf einen fremden Rechner lenkt. Scans sind davon ausgenommen: sie laufen
            trotzdem und zeigen so, welcher Rechner tatsächlich antwortet. Die erfassten Daten gehören dann zu diesem Rechner,
            und der Eintrag gilt nicht als online.
        </MudText>
        <MudText Typo="Typo.body2">
            SMB + Dienst braucht die Freigabe ADMIN$ und den Dienststeuerungs-Manager (Port 445), der Job läuft als Lokales System.
            WinRM braucht aktiviertes PowerShell-Remoting (Port 5985), der Job läuft mit dem hinterlegten Konto.
        </MudText>
        <MudTextField Value="@Options.Value.ResolveDataDirectory()" Label="Datenverzeichnis" Variant="Variant.Outlined" ReadOnly="true"
                      HelperText="Datenbank, Schlüssel, Paketdateien und tägliche Sicherungen (Unterordner backups, 14 Stück). Änderbar über Inventory:DataDirectory." />
        <MudText Typo="Typo.body2">
            Anmeldung:
            @if (!Options.Value.AuthenticationEnabled)
            {
                <span>abgeschaltet</span>
            }
            @if (Options.Value.ResolveWindowsAuthentication())
            {
                <span>Windows-Anmeldung, erlaubt für @string.Join(", ", Options.Value.DescribeAllowedGroups()). </span>
            }
            @if (Options.Value.OidcEnabled)
            {
                <span>@Options.Value.Oidc.DisplayName (@Options.Value.Oidc.ResolveAuthority()), erlaubt für @string.Join(", ", Options.Value.Oidc.AllowedGroups).</span>
            }
        </MudText>
        @if (!Options.Value.AuthenticationEnabled && !Options.Value.ResolveSimulate())
        {
            <MudAlert Severity="Severity.Error">Die Anmeldung ist abgeschaltet: Jeder, der diese Adresse erreicht, kann mit den hinterlegten Zugangsdaten Befehle auf den Zielrechnern ausführen.</MudAlert>
        }
        @if (Options.Value.ResolveSimulate())
        {
            <MudAlert Severity="Severity.Warning">Simulationsmodus: Es finden keine echten Zugriffe auf Zielrechner statt.</MudAlert>
        }
    </MudStack>
</MudPaper>

<MudPaper Class="pa-4 mt-4" Style="max-width: 640px" Outlined="true">
    <MudStack Spacing="3">
        <MudText Typo="Typo.h6">Active Directory</MudText>
        <MudText Typo="Typo.body2">
            Legt Computerkonten aus dem Verzeichnis als Rechner an und kennzeichnet Rechner, deren Konto dort nicht mehr gefunden wird.
            Von Hand angelegte Rechner, die das Verzeichnis nie gekannt hat, bleiben unberührt.
        </MudText>
        <MudSwitch T="bool" @bind-Value="_adEnabled" Color="Color.Primary" Label="Regelmäßig synchronisieren" />
        <MudTextField @bind-Value="_adServer" Label="Domänencontroller oder Domäne" Variant="Variant.Outlined" Margin="Margin.Dense"
                      HelperText="Leer = Domäne, der dieser Server angehört" />
        <MudTextField @bind-Value="_adBaseDns" Label="Suchwurzeln (OUs)" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3"
                      Placeholder="OU=Clients,DC=firma,DC=local" HelperText="Eine je Zeile; leer = gesamte Domäne" />
        <MudSelect T="int?" @bind-Value="_adCredentialId" Label="Zugangsdaten" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                   Placeholder="Konto des Server-Dienstes">
            @foreach (var credential in _credentials)
            {
                <MudSelectItem T="int?" Value="@credential.Id">@credential.Name (@credential.Username)</MudSelectItem>
            }
        </MudSelect>
        <MudNumericField T="int" @bind-Value="_adIntervalHours" Label="Intervall (Stunden)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="720" />
        <MudSwitch T="bool" @bind-Value="_adExcludeDisabled" Color="Color.Primary" Label="Deaktivierte Computerkonten ausschließen" />
        <MudText Typo="Typo.caption">
            Deaktivierte Konten werden nicht angelegt; ist ein bereits vorhandener Rechner im Verzeichnis deaktiviert, gilt er als nicht mehr gefunden.
        </MudText>
        <MudSelect T="AdMissingAction" @bind-Value="_adMissingAction" Label="Rechner, die im Verzeichnis nicht mehr gefunden werden" Variant="Variant.Outlined" Margin="Margin.Dense">
            <MudSelectItem Value="AdMissingAction.Keep">Behalten und als „nicht im AD“ kennzeichnen</MudSelectItem>
            <MudSelectItem Value="AdMissingAction.Delete">Kennzeichnen und nach einer Frist löschen</MudSelectItem>
        </MudSelect>
        @if (_adMissingAction == AdMissingAction.Delete)
        {
            <MudNumericField T="int" @bind-Value="_adMissingDays" Label="Frist (Tage)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="3650"
                             HelperText="So lange muss ein Rechner ununterbrochen fehlen, bevor er gelöscht wird" />
            <MudAlert Severity="Severity.Warning" Dense="true">
                Mit dem Rechner werden seine Inventardaten und sein Verlauf gelöscht. Wer die Suchwurzeln einschränkt, lässt alle Rechner
                außerhalb davon als fehlend gelten. Wären auf einmal auffällig viele Rechner zu löschen, löscht der Lauf nichts und meldet das.
            </MudAlert>
        }
        <MudText Typo="Typo.caption">
            Gekennzeichnete Rechner stehen in der Rechnerliste unter dem Filter „Nicht (mehr) im AD“ und lassen sich über das Regelfeld
            „Nicht (mehr) im Active Directory“ in dynamischen Sammlungen verwenden, etwa um sie von Zeitplänen auszunehmen.
        </MudText>
        <MudStack Row="true" Wrap="Wrap.Wrap">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAdAsync">Speichern</MudButton>
            <MudButton Variant="Variant.Outlined" Disabled="_adBusy" OnClick="PreviewAdAsync">Vorschau</MudButton>
            <MudButton Variant="Variant.Outlined" Disabled="_adBusy" OnClick="SyncAdAsync">Jetzt synchronisieren</MudButton>
        </MudStack>
        @if (_adMessage is not null)
        {
            <MudAlert Severity="@_adSeverity" Dense="true">@_adMessage</MudAlert>
        }
        @if (_adLastResult is not null)
        {
            <MudText Typo="Typo.caption">Letzter Lauf @Display.LocalTime(_adLastRunUtc): @_adLastResult</MudText>
        }
    </MudStack>
</MudPaper>

<MudPaper Class="pa-4 mt-4" Style="max-width: 640px" Outlined="true">
    <MudStack Spacing="3">
        <MudText Typo="Typo.h6">Agenten</MudText>
        <MudText Typo="Typo.body2">
            Optional: Ein fest installierter Agent holt Jobs über eine ausgehende Verbindung ab – sinnvoll für Rechner, die der Server
            nicht direkt erreicht (Notebooks unterwegs, andere Netze). Installiert wird er über „Rechner → Aktionen → Agent installieren“.
            Nach einem Update des Servers aktualisieren sich die Agenten bei ihrer nächsten Anfrage selbst.
        </MudText>
        <MudTextField @bind-Value="_agentUrl" Label="Adresse dieses Servers aus Sicht der Agenten" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Placeholder="https://inventory.firma.local:5100" HelperText="HTTPS empfohlen: Über diese Verbindung erhält der Agent Befehle, die er als Lokales System ausführt." />
        <MudTextField Value="_agentToken" Label="Anmeldegeheimnis" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true"
                      HelperText="Wird bei der Installation mitgegeben. Erneuern sperrt nur neue Anmeldungen, vorhandene Agenten bleiben verbunden." />
        <MudStack Row="true">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAgentAsync">Speichern</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="RenewAgentTokenAsync">Geheimnis erneuern</MudButton>
        </MudStack>
    </MudStack>
</MudPaper>

<MudPaper id="updates" Class="pa-4 mt-4" Style="max-width: 640px" Outlined="true">
    <MudStack Spacing="3">
        <MudText Typo="Typo.h6">Updates</MudText>
        <MudText Typo="Typo.body2">Installierte Version: <b>@Updates.CurrentVersion</b></MudText>
        @if (Updates.IsDevelopmentBuild)
        {
            <MudAlert Severity="Severity.Info" Dense="true">Lokal gebauter Entwicklungsstand – es wird nicht nach Updates gesucht.</MudAlert>
        }
        else if (!Updates.Enabled)
        {
            <MudAlert Severity="Severity.Info" Dense="true">Die Update-Prüfung ist in der Konfiguration abgeschaltet (Inventory:Update:Enabled).</MudAlert>
        }
        else
        {
            @if (Updates.UpdateAvailable)
            {
                <MudAlert Severity="Severity.Success" Dense="true">
                    <b>Version @Updates.Latest!.Version ist verfügbar</b>
                    @if (Updates.Latest.PublishedUtc is not null)
                    {
                        <span> (veröffentlicht @Display.LocalTime(Updates.Latest.PublishedUtc))</span>
                    }
                    <span>. </span><MudLink Href="@Updates.Latest.PageUrl" Target="_blank">Änderungen und Download</MudLink>
                </MudAlert>
                @if (!string.IsNullOrWhiteSpace(Updates.Latest!.Notes))
                {
                    <pre class="release-notes">@Updates.Latest!.Notes</pre>
                }
                @if (Updates.CannotInstallReason is not null)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true">@Updates.CannotInstallReason</MudAlert>
                }
            }
            else if (Updates.LastCheckUtc is not null && Updates.LastError is null)
            {
                <MudText Typo="Typo.body2">Inventory ist aktuell (geprüft @Display.LocalTime(Updates.LastCheckUtc), Quelle: github.com/@Updates.Repository).</MudText>
            }
            @if (Updates.LastError is not null)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">@Updates.LastError</MudAlert>
            }
            @if (_updateMessage is not null)
            {
                <MudAlert Severity="@_updateSeverity" Dense="true">@_updateMessage</MudAlert>
            }
            <MudStack Row="true" Wrap="Wrap.Wrap">
                <MudButton Variant="Variant.Outlined" Disabled="_updateBusy" OnClick="CheckUpdateAsync">Jetzt prüfen</MudButton>
                @if (Updates.UpdateAvailable && Updates.CannotInstallReason is null)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_updateBusy || Updates.Installing)" OnClick="ApplyUpdateAsync">
                        @(Updates.Installing ? "Wird installiert …" : "Jetzt aktualisieren")
                    </MudButton>
                }
            </MudStack>
            @if (Updates.CannotInstallReason is null)
            {
                <MudSwitch T="bool" @bind-Value="_updateAuto" Color="Color.Primary" Label="Automatisch im Wartungsfenster aktualisieren" />
                <MudTimePicker @bind-Time="_updateWindow" Label="Beginn des Wartungsfensters (2 Stunden)" Variant="Variant.Outlined" Margin="Margin.Dense" Editable="true" Disabled="@(!_updateAuto)" />
                <div><MudButton Variant="Variant.Outlined" OnClick="SaveUpdateSettingsAsync">Speichern</MudButton></div>
            }
            <MudText Typo="Typo.caption">
                Vor jeder Aktualisierung wird die Datenbank gesichert; laufende Deployments werden abgewartet. Die Oberfläche ist währenddessen
                kurz nicht erreichbar, Agenten aktualisieren sich danach selbst. Hinweis: Über diesen Weg gelangt neuer Programmcode auf den
                Server und über die Agenten auf alle Rechner. Solange Releases unsigniert sind, sichert die Prüfsumme nur die Übertragung,
                nicht die Herkunft – die Automatik ist deshalb standardmäßig aus.
            </MudText>
        }
    </MudStack>
</MudPaper>

@code {
    private bool _updateBusy;
    private bool _updateAuto;
    private TimeSpan? _updateWindow = new TimeSpan(3, 0, 0);
    private string? _updateMessage;
    private Severity _updateSeverity;

    private async Task LoadUpdateAsync()
    {
        var current = await Updates.GetSettingsAsync();
        (_updateAuto, _updateWindow) = (current.Automatic, current.WindowStart);
    }

    private async Task CheckUpdateAsync()
    {
        _updateBusy = true;
        _updateMessage = null;
        try
        {
            await Updates.CheckAsync(force: true);
        }
        finally
        {
            _updateBusy = false;
        }
    }

    private async Task ApplyUpdateAsync()
    {
        _updateBusy = true;
        try
        {
            var error = await Updates.ApplyAsync(await Audit.UserNameAsync());
            _updateMessage = error ?? $"Die Aktualisierung auf {Updates.Latest?.Version} läuft. Der Dienst startet gleich neu; diese Seite danach neu laden.";
            _updateSeverity = error is null ? Severity.Info : Severity.Error;
        }
        finally
        {
            _updateBusy = false;
        }
    }

    private async Task SaveUpdateSettingsAsync()
    {
        await Updates.SaveSettingsAsync(_updateAuto, _updateWindow ?? new TimeSpan(3, 0, 0));
        await Audit.LogAsync("Einstellung geändert", $"Automatische Aktualisierung: {(_updateAuto ? $"an, ab {_updateWindow:hh\\:mm} Uhr" : "aus")}");
        Snackbar.Add("Gespeichert.", Severity.Success);
    }

    private string? _agentUrl;
    private string _agentToken = "";

    private async Task SaveAgentAsync()
    {
        await Agents.SetServerUrlAsync(_agentUrl);
        await Audit.LogAsync("Einstellung geändert", $"Server-Adresse für Agenten: {_agentUrl}");
        Snackbar.Add("Gespeichert.", Severity.Success);
    }

    private async Task RenewAgentTokenAsync()
    {
        _agentToken = await Agents.RenewEnrollmentTokenAsync();
        await Audit.LogAsync("Einstellung geändert", "Anmeldegeheimnis für Agenten erneuert");
    }

    private bool _adEnabled;
    private string? _adServer;
    private string? _adBaseDns;
    private int? _adCredentialId;
    private int _adIntervalHours = 24;
    private bool _adExcludeDisabled = true;
    private AdMissingAction _adMissingAction;
    private int _adMissingDays = 30;
    private DateTime? _adLastRunUtc;
    private string? _adLastResult;
    private string? _adMessage;
    private Severity _adSeverity;
    private bool _adBusy;
    private List<Credential> _credentials = [];

    private async Task LoadAdAsync()
    {
        _credentials = await CredentialService.ListAsync();
        var ad = await AdSync.GetSettingsAsync();
        (_adEnabled, _adServer, _adBaseDns, _adCredentialId, _adIntervalHours, _adLastRunUtc, _adLastResult) =
            (ad.Enabled, ad.Server, ad.BaseDns?.Replace(";", "\n"), ad.CredentialId, ad.IntervalHours, ad.LastRunUtc, ad.LastResult);
        (_adExcludeDisabled, _adMissingAction, _adMissingDays) = (ad.ExcludeDisabled, ad.MissingAction, ad.MissingDays);
    }

    private async Task SaveAdAsync()
    {
        await AdSync.SaveSettingsAsync(_adEnabled, _adServer, _adBaseDns, _adCredentialId, _adIntervalHours, _adExcludeDisabled, _adMissingAction, _adMissingDays);
        await Audit.LogAsync("Einstellung geändert", $"AD-Synchronisation: {(_adEnabled ? "an" : "aus")}, Server {_adServer ?? "(Domäne)"}, alle {_adIntervalHours} h, " +
            $"deaktivierte Konten {(_adExcludeDisabled ? "ausgeschlossen" : "einbezogen")}, fehlende Rechner {(_adMissingAction == AdMissingAction.Delete ? $"nach {_adMissingDays} Tagen löschen" : "behalten")}");
        Snackbar.Add("Gespeichert.", Severity.Success);
    }

    private async Task PreviewAdAsync()
    {
        await RunAdAsync(async () =>
        {
            var preview = await AdSync.PreviewAsync();
            static string Names(List<string> names) => names.Count == 0 ? "" : ": " + string.Join(", ", names.Take(15)) + (names.Count > 15 ? " …" : "");
            var text = $"{preview.Total} Computerkonten gefunden ({preview.Disabled} deaktiviert). Neu anzulegen: {preview.NewNames.Count}{Names(preview.NewNames)}. " +
                       $"Nicht im AD: {preview.MissingNames!.Count}{Names(preview.MissingNames)}.";
            if (preview.DeleteNames!.Count > 0)
                text += preview.DeleteBlocked
                    ? $" Zu löschen wären {preview.DeleteNames.Count} – auffällig viele auf einmal, der Lauf würde deshalb nichts löschen."
                    : $" Der nächste Lauf löscht {preview.DeleteNames.Count}{Names(preview.DeleteNames)}.";
            return text;
        });
    }

    private Task SyncAdAsync() => RunAdAsync(() => AdSync.SyncAsync());

    /// <summary>Speichert zuerst, damit Vorschau und Sync mit den gerade angezeigten Werten laufen.</summary>
    private async Task RunAdAsync(Func<Task<string>> action)
    {
        _adBusy = true;
        _adMessage = null;
        try
        {
            await AdSync.SaveSettingsAsync(_adEnabled, _adServer, _adBaseDns, _adCredentialId, _adIntervalHours, _adExcludeDisabled, _adMissingAction, _adMissingDays);
            _adMessage = await action();
            _adSeverity = _adMessage.StartsWith("Fehler") ? Severity.Error : Severity.Success;
        }
        catch (Inventory.Core.Abstractions.RemoteException ex)
        {
            _adMessage = ex.Message;
            _adSeverity = Severity.Error;
        }
        finally
        {
            _adBusy = false;
            var ad = await AdSync.GetSettingsAsync();
            (_adLastRunUtc, _adLastResult) = (ad.LastRunUtc, ad.LastResult);
        }
    }

    private TransportKind _transport;

    private bool _fallback;
    private bool _verifyName = true;

    private async Task SetVerifyNameAsync(bool enabled)
    {
        _verifyName = enabled;
        await SettingsService.SetVerifyTargetNameAsync(enabled);
        await Audit.LogAsync("Einstellung geändert", $"Rechnernamen vor der Ausführung prüfen: {(enabled ? "an" : "aus")}");
        Snackbar.Add("Gespeichert.", Severity.Success);
    }

    protected override async Task OnInitializedAsync()
    {
        _transport = await SettingsService.GetDefaultTransportAsync();
        _fallback = await SettingsService.GetTransportFallbackAsync();
        _verifyName = await SettingsService.GetVerifyTargetNameAsync();
        await LoadAdAsync();
        await LoadUpdateAsync();
        _agentUrl = await Agents.GetServerUrlAsync();
        _agentToken = await Agents.GetEnrollmentTokenAsync();
    }

    private async Task SetFallbackAsync(bool enabled)
    {
        _fallback = enabled;
        await SettingsService.SetTransportFallbackAsync(enabled);
        await Audit.LogAsync("Einstellung geändert", $"Ausweich-Transport: {(enabled ? "an" : "aus")}");
        Snackbar.Add("Gespeichert.", Severity.Success);
    }

    private async Task SetTransportAsync(TransportKind kind)
    {
        _transport = kind;
        await SettingsService.SetDefaultTransportAsync(kind);
        await Audit.LogAsync("Einstellung geändert", $"Standard-Transport: {Display.Transport(kind)}");
        Snackbar.Add("Gespeichert.", Severity.Success);
    }
}
