@page "/settings"
@using Microsoft.Extensions.Options
@inject SettingsService SettingsService
@inject AdSyncService AdSync
@inject CredentialService CredentialService
@inject IOptions<InventoryOptions> Options
@inject ISnackbar Snackbar
@inject Auditor Audit

<PageTitle>Einstellungen – Inventory</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Einstellungen</MudText>

<MudPaper Class="pa-4" Style="max-width: 640px" Outlined="true">
    <MudStack Spacing="4">
        <MudSelect T="TransportKind" Value="_transport" ValueChanged="SetTransportAsync" Label="Standard-Transport" Variant="Variant.Outlined"
                   HelperText="Gilt für alle Rechner, bei denen kein eigener Transport eingestellt ist.">
            <MudSelectItem T="TransportKind" Value="TransportKind.SmbService">@Display.Transport(TransportKind.SmbService)</MudSelectItem>
            <MudSelectItem T="TransportKind" Value="TransportKind.WinRm">@Display.Transport(TransportKind.WinRm)</MudSelectItem>
        </MudSelect>
        <MudSwitch T="bool" Value="_fallback" ValueChanged="SetFallbackAsync" Color="Color.Primary"
                   Label="Bei Zustellfehlern den anderen Transport versuchen" />
        <MudText Typo="Typo.body2">
            SMB + Dienst braucht die Freigabe ADMIN$ und den Dienststeuerungs-Manager (Port 445), der Job läuft als Lokales System.
            WinRM braucht aktiviertes PowerShell-Remoting (Port 5985), der Job läuft mit dem hinterlegten Konto.
        </MudText>
        <MudTextField Value="@Options.Value.ResolveDataDirectory()" Label="Datenverzeichnis" Variant="Variant.Outlined" ReadOnly="true"
                      HelperText="Datenbank, Schlüssel, Paketdateien und tägliche Sicherungen (Unterordner backups, 14 Stück). Änderbar über Inventory:DataDirectory." />
        <MudText Typo="Typo.body2">
            Anmeldung: @(Options.Value.ResolveWindowsAuthentication() ? $"Windows-Anmeldung, erlaubt für {string.Join(", ", Options.Value.DescribeAllowedGroups())}" : "abgeschaltet")
        </MudText>
        @if (!Options.Value.ResolveWindowsAuthentication() && !Options.Value.ResolveSimulate())
        {
            <MudAlert Severity="Severity.Error">Die Anmeldung ist abgeschaltet: Jeder, der diese Adresse erreicht, kann mit den hinterlegten Zugangsdaten Befehle auf den Zielrechnern ausführen.</MudAlert>
        }
        @if (Options.Value.ResolveSimulate())
        {
            <MudAlert Severity="Severity.Warning">Simulationsmodus: Es finden keine echten Zugriffe auf Zielrechner statt.</MudAlert>
        }
    </MudStack>
</MudPaper>

<MudPaper Class="pa-4 mt-4" Style="max-width: 640px" Outlined="true">
    <MudStack Spacing="3">
        <MudText Typo="Typo.h6">Active Directory</MudText>
        <MudText Typo="Typo.body2">
            Legt aktivierte Computerkonten aus dem Verzeichnis als Rechner an. Bereits vorhandene bleiben unverändert, gelöscht wird nie automatisch.
        </MudText>
        <MudSwitch T="bool" @bind-Value="_adEnabled" Color="Color.Primary" Label="Regelmäßig synchronisieren" />
        <MudTextField @bind-Value="_adServer" Label="Domänencontroller oder Domäne" Variant="Variant.Outlined" Margin="Margin.Dense"
                      HelperText="Leer = Domäne, der dieser Server angehört" />
        <MudTextField @bind-Value="_adBaseDns" Label="Suchwurzeln (OUs)" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3"
                      Placeholder="OU=Clients,DC=firma,DC=local" HelperText="Eine je Zeile; leer = gesamte Domäne" />
        <MudSelect T="int?" @bind-Value="_adCredentialId" Label="Zugangsdaten" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                   Placeholder="Konto des Server-Dienstes">
            @foreach (var credential in _credentials)
            {
                <MudSelectItem T="int?" Value="@credential.Id">@credential.Name (@credential.Username)</MudSelectItem>
            }
        </MudSelect>
        <MudNumericField T="int" @bind-Value="_adIntervalHours" Label="Intervall (Stunden)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="720" />
        <MudStack Row="true" Wrap="Wrap.Wrap">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAdAsync">Speichern</MudButton>
            <MudButton Variant="Variant.Outlined" Disabled="_adBusy" OnClick="PreviewAdAsync">Vorschau</MudButton>
            <MudButton Variant="Variant.Outlined" Disabled="_adBusy" OnClick="SyncAdAsync">Jetzt synchronisieren</MudButton>
        </MudStack>
        @if (_adMessage is not null)
        {
            <MudAlert Severity="@_adSeverity" Dense="true">@_adMessage</MudAlert>
        }
        @if (_adLastResult is not null)
        {
            <MudText Typo="Typo.caption">Letzter Lauf @Display.LocalTime(_adLastRunUtc): @_adLastResult</MudText>
        }
    </MudStack>
</MudPaper>

@code {
    private bool _adEnabled;
    private string? _adServer;
    private string? _adBaseDns;
    private int? _adCredentialId;
    private int _adIntervalHours = 24;
    private DateTime? _adLastRunUtc;
    private string? _adLastResult;
    private string? _adMessage;
    private Severity _adSeverity;
    private bool _adBusy;
    private List<Credential> _credentials = [];

    private async Task LoadAdAsync()
    {
        _credentials = await CredentialService.ListAsync();
        var ad = await AdSync.GetSettingsAsync();
        (_adEnabled, _adServer, _adBaseDns, _adCredentialId, _adIntervalHours, _adLastRunUtc, _adLastResult) =
            (ad.Enabled, ad.Server, ad.BaseDns?.Replace(";", "\n"), ad.CredentialId, ad.IntervalHours, ad.LastRunUtc, ad.LastResult);
    }

    private async Task SaveAdAsync()
    {
        await AdSync.SaveSettingsAsync(_adEnabled, _adServer, _adBaseDns, _adCredentialId, _adIntervalHours);
        await Audit.LogAsync("Einstellung geändert", $"AD-Synchronisation: {(_adEnabled ? "an" : "aus")}, Server {_adServer ?? "(Domäne)"}, alle {_adIntervalHours} h");
        Snackbar.Add("Gespeichert.", Severity.Success);
    }

    private async Task PreviewAdAsync()
    {
        await RunAdAsync(async () =>
        {
            var preview = await AdSync.PreviewAsync();
            var names = string.Join(", ", preview.NewNames.Take(15)) + (preview.NewNames.Count > 15 ? " …" : "");
            return $"{preview.Total} Computerkonten gefunden, davon {preview.NewNames.Count} neu" + (preview.NewNames.Count > 0 ? $": {names}" : ".");
        });
    }

    private Task SyncAdAsync() => RunAdAsync(() => AdSync.SyncAsync());

    /// <summary>Speichert zuerst, damit Vorschau und Sync mit den gerade angezeigten Werten laufen.</summary>
    private async Task RunAdAsync(Func<Task<string>> action)
    {
        _adBusy = true;
        _adMessage = null;
        try
        {
            await AdSync.SaveSettingsAsync(_adEnabled, _adServer, _adBaseDns, _adCredentialId, _adIntervalHours);
            _adMessage = await action();
            _adSeverity = _adMessage.StartsWith("Fehler") ? Severity.Error : Severity.Success;
        }
        catch (Inventory.Core.Abstractions.RemoteException ex)
        {
            _adMessage = ex.Message;
            _adSeverity = Severity.Error;
        }
        finally
        {
            _adBusy = false;
            var ad = await AdSync.GetSettingsAsync();
            (_adLastRunUtc, _adLastResult) = (ad.LastRunUtc, ad.LastResult);
        }
    }

    private TransportKind _transport;

    private bool _fallback;

    protected override async Task OnInitializedAsync()
    {
        _transport = await SettingsService.GetDefaultTransportAsync();
        _fallback = await SettingsService.GetTransportFallbackAsync();
        await LoadAdAsync();
    }

    private async Task SetFallbackAsync(bool enabled)
    {
        _fallback = enabled;
        await SettingsService.SetTransportFallbackAsync(enabled);
        await Audit.LogAsync("Einstellung geändert", $"Ausweich-Transport: {(enabled ? "an" : "aus")}");
        Snackbar.Add("Gespeichert.", Severity.Success);
    }

    private async Task SetTransportAsync(TransportKind kind)
    {
        _transport = kind;
        await SettingsService.SetDefaultTransportAsync(kind);
        await Audit.LogAsync("Einstellung geändert", $"Standard-Transport: {Display.Transport(kind)}");
        Snackbar.Add("Gespeichert.", Severity.Success);
    }
}
