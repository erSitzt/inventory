    private AdMissingAction _adMissingAction;
    private int _adMissingDays = 30;
    private DateTime? _adLastRunUtc;
    private string? _adLastResult;
    private string? _adMessage;
    private Severity _adSeverity;
    private bool _adBusy;
    private List<Credential> _credentials = [];

    private bool _hbEnabled;
