@page "/software"
@inject ReportService Reports
@inject PackageService PackageService
@inject IDialogService Dialogs
@inject Auditor Audit
@inject IStringLocalizer<SharedResource> L
@inject Access Access

<PageTitle>@L["Software"] – Inventory</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
    <MudText Typo="Typo.h5">@L["Software"]</MudText>
    <MudSpacer />
    <MudTextField @bind-Value="_search" Placeholder="@L["Search program or publisher"]" Adornment="Adornment.Start" Immediate="true"
                  AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 320px" />
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" Href="api/reports/software.csv" Target="_blank">@L["All installations (CSV)"]</MudButton>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" Href="api/reports/computers.csv" Target="_blank">@L["Computers (CSV)"]</MudButton>
</MudStack>

<MudText Typo="Typo.body2" Class="mb-4">
    @L["One row per program; different versions are grouped and listed when the row is expanded. Click a version to see the computers."]
    @L["Programs installed per user are only readable while that user is logged on; otherwise they are kept from the previous scan."]
</MudText>

<MudGrid>
    <MudItem xs="12" lg="@(_selected is null ? 12 : 8)">
        <MudDataGrid T="SoftwareGroup" Items="_groups" Dense="true" Hover="true" SortMode="SortMode.Single" RowsPerPage="50"
                     QuickFilter="@(g => string.IsNullOrWhiteSpace(_search) || g.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) || (g.Publisher?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) || g.Versions.Any(v => v.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)))">
            <Columns>
                <HierarchyColumn T="SoftwareGroup" />
                <TemplateColumn Title="@L["Program"]" SortBy="g => g.Name">
                    <CellTemplate>
                        <b>@context.Item.Name</b>
                        @if (context.Item.Versions.Count == 1 && context.Item.Versions[0].Name != context.Item.Name)
                        {
                            <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary)">@context.Item.Versions[0].Name</MudText>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@L["Publisher"]" SortBy="g => g.Publisher">
                    <CellTemplate>@context.Item.Publisher</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@L["Versions"]" SortBy="g => g.Versions.Count">
                    <CellTemplate>
                        @if (context.Item.Versions.Count == 1)
                        {
                            <MudLink OnClick="@(() => SelectAsync(context.Item.Versions[0]))">@(context.Item.Versions[0].Version ?? L["unknown"])</MudLink>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info">@L["{0} versions", context.Item.Versions.Count]</MudChip>
                            <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary)">@L["newest {0}", context.Item.Versions[0].Version]</MudText>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@L["Installation"]" Sortable="false">
                    <CellTemplate>
                        @if (context.Item.PerMachine)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@L["all users"]</MudChip>
                        }
                        @if (context.Item.PerUser)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Warning">@L["per user"]</MudChip>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@L["Computers"]" SortBy="g => g.Computers">
                    <CellTemplate>@context.Item.Computers</CellTemplate>
                </TemplateColumn>
            </Columns>
            <ChildRowContent>
                <MudSimpleTable Dense="true" Elevation="0" Class="ma-2" Style="max-width: 800px">
                    <thead>
                        <tr><th>@L["Version"]</th><th>@L["Reported name"]</th><th style="text-align: right">@L["all users"]</th><th style="text-align: right">@L["per user"]</th><th style="text-align: right">@L["Computers"]</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var version in context.Item.Versions)
                        {
                            <tr>
                                <td><MudLink OnClick="@(() => SelectAsync(version))">@(version.Version ?? L["unknown"])</MudLink></td>
                                <td>@version.Name</td>
                                <td style="text-align: right">@version.PerMachine</td>
                                <td style="text-align: right">@version.PerUser</td>
                                <td style="text-align: right">@version.Computers</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </ChildRowContent>
            <NoRecordsContent>
                <MudText Class="pa-4">@L["No software recorded yet. The overview fills with the first inventory scan."]</MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudDataGridPager T="SoftwareGroup" PageSizeOptions="@(new[] { 50, 100, 500 })" RowsPerPageString="@L["Rows per page"]" />
            </PagerContent>
        </MudDataGrid>
    </MudItem>
    @if (_selected is not null)
    {
        <MudItem xs="12" lg="4">
            <MudPaper Class="pa-4" Outlined="true">
                <MudStack Row="true" AlignItems="AlignItems.Start">
                    <div style="flex: 1">
                        <MudText Typo="Typo.h6">@_selected.Name</MudText>
                        <MudText Typo="Typo.body2">@L["Version"] @(_selected.Version ?? L["unknown"]) · @L["{0} computers", _computers.Count]</MudText>
                    </div>
                    <MudTooltip Text="@L["Close"]"><MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" aria-label="@L["Close"]" OnClick="@(() => _selected = null)" /></MudTooltip>
                </MudStack>
                <AdminOnly>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="mt-2" StartIcon="@Icons.Material.Filled.DeleteSweep" Disabled="@(_computers.Count == 0)" OnClick="UninstallAsync">@L["Uninstall …"]</MudButton>
                </AdminOnly>
                <MudList T="string" Dense="true">
                    @foreach (var computer in _computers)
                    {
                        <MudListItem T="string" Href="@($"computers/{computer.Computer.Id}")">
                            @computer.Computer.Name
                            @if (computer.PerUser)
                            {
                                <MudText Typo="Typo.caption" Inline="true" Style="color: var(--mud-palette-text-secondary)"> · @L["per user"]@(computer.CarriedOver ? " – " + L["from an earlier scan, user not logged on"] : "")</MudText>
                            }
                        </MudListItem>
                    }
                </MudList>
            </MudPaper>
        </MudItem>
    }
</MudGrid>

@code {
    private List<SoftwareGroup> _groups = [];
    private SoftwareSummary? _selected;
    private List<SoftwareInstall> _computers = [];
    private string _search = "";

    protected override async Task OnInitializedAsync() => _groups = await Reports.SoftwareGroupsAsync();

    /// <summary>Legt bei Bedarf das Deinstallations-Paket für genau dieses Programm an und öffnet den Deploy-Dialog mit den betroffenen Rechnern.</summary>
    private async Task UninstallAsync()
    {
        if (!await Access.DemandAdminAsync())
            return;
        var (package, created) = await PackageService.EnsureUninstallPackageAsync(_selected!.Name, _selected.Name, null, approvedBy: await Audit.UserNameAsync());
        if (created)
            await Audit.LogAsync(L["Package created"], package.Name);
        var parameters = new DialogParameters<DeployDialog> { { d => d.PackageId, package.Id }, { d => d.ComputerIds, _computers.Select(c => c.Computer.Id).ToList() } };
        await Dialogs.ShowAsync<DeployDialog>(L["Deploy \"{0}\"", package.Name], parameters, new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
    }

    private async Task SelectAsync(SoftwareSummary version)
    {
        _selected = version;
        _computers = await Reports.ComputersWithSoftwareAsync(version.Name, version.Version);
    }
}
