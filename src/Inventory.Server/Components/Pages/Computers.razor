@page "/computers"
@inject ComputerService ComputerService
@inject CredentialService CredentialService
@inject CollectionService CollectionService
@inject ScanService ScanService
@inject WakeService WakeService
@inject AgentService AgentService
@inject RemoteJobService Jobs
@inject FrameworkInstallService Framework
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject Auditor Audit
@inject IStringLocalizer<SharedResource> L
@inject Display Display
@inject Access Access
@inject UpdateInstaller Updates

<PageTitle>@L["Computers"] – Inventory</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
    <MudText Typo="Typo.h5">@L["Computers"]</MudText>
    <MudSpacer />
    @if (_collections.Count > 0)
    {
        <MudSelect T="int?" Value="_activeCollection?.Id" ValueChanged="SetCollection" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 240px"
                   Label="@L["Collection"]" Clearable="true" aria-label="@L["Collection"]">
            @foreach (var summary in _collections)
            {
                <MudSelectItem T="int?" Value="@summary.Collection.Id">@summary.Collection.Name (@summary.Count)</MudSelectItem>
            }
        </MudSelect>
    }
    @* Mehrere Filter gelten zusammen (und); die Zahl je Eintrag sagt, wie viele Rechner mit ihm übrig blieben. *@
    <MudSelect T="string" MultiSelection="true" SelectedValues="_filters" SelectedValuesChanged="SetFilters" Variant="Variant.Outlined" Margin="Margin.Dense"
               Style="max-width: 300px" Label="@L["Filter"]" Placeholder="@L["All computers"]" Clearable="true" aria-label="@L["Filter"]"
               MultiSelectionTextFunc="@(_ => string.Join(", ", BuiltInViews.Where(v => _filters.Contains(v.Key)).Select(v => L[v.Label].Value)))">
        @foreach (var (key, label) in BuiltInViews)
        {
            <MudSelectItem T="string" Value="@key">@L[label] (@_scope.Count(c => InFilters(c) && InView(key, c)))</MudSelectItem>
        }
    </MudSelect>
    <MudSelect T="ChassisKind" MultiSelection="true" SelectedValues="_types" SelectedValuesChanged="SetTypes" Variant="Variant.Outlined" Margin="Margin.Dense"
               Style="max-width: 220px" Label="@L["Device type"]" Clearable="true" aria-label="@L["Device type"]"
               MultiSelectionTextFunc="@(_ => string.Join(", ", _types.Order().Select(k => L[Chassis.Label(k)].Value)))">
        @foreach (var kind in Enum.GetValues<ChassisKind>().Where(k => _types.Contains(k) || _computers.Any(c => RoleOf(c) == k)))
        {
            <MudSelectItem T="ChassisKind" Value="@kind">@L[Chassis.Label(kind)] (@_computers.Count(c => RoleOf(c) == kind))</MudSelectItem>
        }
    </MudSelect>
    <MudTextField @bind-Value="_search" Placeholder="@L["Search"]" Adornment="Adornment.Start" Immediate="true"
                  AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 240px" />
    <AdminOnly>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddAsync">@L["Add"]</MudButton>
        <MudTooltip Text="@L["Import asset data (CSV)"]">
            <MudIconButton Icon="@Icons.Material.Filled.UploadFile" aria-label="@L["Import asset data (CSV)"]" OnClick="ImportAssetsAsync" />
        </MudTooltip>
    </AdminOnly>
    <OperatorOnly>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ManageSearch" Disabled="_busy" OnClick="ScanAsync">
            @(_selected.Count > 0 ? L["Scan ({0})", _selected.Count] : L["Scan all"])
        </MudButton>
    </OperatorOnly>
    <OperatorOnly>
        <MudMenu Label="@L["Actions"]" Variant="Variant.Outlined" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" Disabled="_busy">
            <MudMenuItem Icon="@Icons.Material.Filled.NetworkCheck" OnClick="ProbeAsync">
                @(_selected.Count > 0 ? L["Check reachability of selection"] : L["Check reachability of all"])
            </MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.PowerSettingsNew" Disabled="@(_selected.Count == 0)" OnClick="WakeAsync">@L["Wake (Wake-on-LAN)"]</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.RocketLaunch" Disabled="@(_selected.Count == 0)" OnClick="DeployAsync">@L["Deploy package"]</MudMenuItem>
            <AdminOnly>
                <MudMenuItem Icon="@Icons.Material.Filled.Terminal" Disabled="@(_selected.Count == 0)" OnClick="RunCommand">@L["Run command"]</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.SystemUpdateAlt" Disabled="@(_selected.Count == 0)" OnClick="@(() => Updates.OpenAsync(_selected.Select(c => c.Id).ToList(), securityOnly: false))">@L["Install pending updates"]</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Security" Disabled="@(_selected.Count == 0)" OnClick="@(() => Updates.OpenAsync(_selected.Select(c => c.Id).ToList(), securityOnly: true))">@L["Install pending security updates"]</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.SystemUpdateAlt" Disabled="@(_selected.Count == 0)" OnClick="@(() => Updates.OpenAsync(_selected.Select(c => c.Id).ToList(), securityOnly: false, restart: false))">@L["Install pending updates without restart"]</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Security" Disabled="@(_selected.Count == 0)" OnClick="@(() => Updates.OpenAsync(_selected.Select(c => c.Id).ToList(), securityOnly: true, restart: false))">@L["Install pending security updates without restart"]</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.SettingsRemote" Disabled="@(_selected.Count == 0)" OnClick="InstallAgentAsync">@L["Install agent"]</MudMenuItem>
                @if (Framework.Available)
                {
                    <MudMenuItem Icon="@Icons.Material.Filled.Extension" Disabled="@(_selected.Count == 0)" OnClick="InstallFrameworkAsync">@L["Install .NET Framework 4.8"]</MudMenuItem>
                }
                <MudMenuItem Icon="@Icons.Material.Filled.ConnectedTv" Disabled="@(_selected.Count == 0)" OnClick="InstallLauncherAsync">@L["Install remote access launcher"]</MudMenuItem>
            </AdminOnly>
            <AdminOnly>
                <MudDivider />
                @foreach (var summary in _collections.Where(c => !c.Collection.IsDynamic))
                {
                    var target = summary.Collection;
                    <MudMenuItem Icon="@Icons.Material.Filled.CreateNewFolder" Disabled="@(_selected.Count == 0)" OnClick="@(() => AddToCollectionAsync(target))">
                        @L["Add to \"{0}\"", target.Name]
                    </MudMenuItem>
                }
                @if (_activeCollection is { IsDynamic: false })
                {
                    <MudMenuItem Icon="@Icons.Material.Filled.FolderOff" Disabled="@(_selected.Count == 0)" OnClick="RemoveFromCollectionAsync">
                        @L["Remove from \"{0}\"", _activeCollection.Name]
                    </MudMenuItem>
                }
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" Disabled="@(_selected.Count == 0)" OnClick="DeleteAsync">@L["Delete"]</MudMenuItem>
            </AdminOnly>
        </MudMenu>
    </OperatorOnly>
</MudStack>

@if (_busy && _progressText is not null)
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">@_progressText</MudAlert>
}

<MudDataGrid T="Computer" Items="_computers" MultiSelection="true" @bind-SelectedItems="_selected" QuickFilter="Matches"
             Dense="true" Hover="true" Loading="_busy" SortMode="SortMode.Single" RowsPerPage="50">
    <Columns>
        <SelectColumn T="Computer" />
        <TemplateColumn Title="Name" SortBy="c => c.Name">
            <CellTemplate>
                <span style="white-space: nowrap">
                    <MudTooltip Text="@Display.DeviceLabel(context.Item)">
                        <MudIcon Icon="@Display.DeviceIcon(context.Item)" Size="Size.Small" Color="Color.Default"
                                 Style="@($"vertical-align: text-bottom; margin-right: 6px; opacity: {(context.Item.LastScanUtc is null ? "0.4" : "0.75")}")" aria-label="@Display.DeviceLabel(context.Item)" />
                    </MudTooltip>
                    <MudLink Href="@($"computers/{context.Item.Id}")">@context.Item.Name</MudLink>
                </span>
                @foreach (var tag in context.Item.TagList)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@tag</MudChip>
                }
                @if (context.Item.NameMismatch)
                {
                    <MudTooltip Text="@L["Under this name the computer {0} responded (stale DNS entry or alias?)", context.Item.ReportedName]">
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.Warning">@L["is {0}", context.Item.ReportedName]</MudChip>
                    </MudTooltip>
                }
                @if (context.Item.DirectoryInactive)
                {
                    <MudTooltip Text="@InactiveText(context.Item)">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.HourglassDisabled">@L["decommissioned?"]</MudChip>
                    </MudTooltip>
                }
                @if (context.Item.MissingInDirectory)
                {
                    <MudTooltip Text="@(context.Item.DirectoryDisabled ? L["The computer account is disabled in Active Directory, since {0}.", Display.LocalTime(context.Item.DirectoryMissingSinceUtc)] : L["The computer account is missing in Active Directory, since {0}.", Display.LocalTime(context.Item.DirectoryMissingSinceUtc)])">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" Icon="@Icons.Material.Filled.PersonOff">@(context.Item.DirectoryDisabled ? L["disabled in AD"] : L["not in AD"])</MudChip>
                    </MudTooltip>
                }
                else if (context.Item.ReverseDnsMismatch)
                {
                    <MudTooltip Text="@L["According to reverse DNS the address {0} belongs to {1}. The computer has not reported its own name yet – a scan will tell.", context.Item.IpAddress, context.Item.ReverseDnsName]">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" Icon="@Icons.Material.Filled.HelpOutline">DNS: @context.Item.ReverseDnsName!.Split('.')[0]</MudChip>
                    </MudTooltip>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Status" SortBy="c => c.IsOnline">
            <CellTemplate>
                @if (context.Item.AgentKeyHash is not null)
                {
                    <MudTooltip Text="@L["Agent {0}, last contact {1}", context.Item.AgentVersion, Display.LocalTime(context.Item.AgentLastSeenUtc)]">
                        <MudChip T="string" Size="Size.Small" Color="@(Display.AgentConnected(context.Item) ? Color.Success : Color.Default)" Icon="@Icons.Material.Filled.SettingsRemote">
                            @(Display.AgentConnected(context.Item) ? L["Agent"] : L["Agent disconnected"])
                        </MudChip>
                    </MudTooltip>
                }
                else if (context.Item.LastProbeUtc is null && context.Item.LastScanUtc is null)
                {
                    <MudChip T="string" Size="Size.Small">@L["unchecked"]</MudChip>
                }
                else if (context.Item.IsOnline)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success">@L["online"]</MudChip>
                }
                else if (context.Item.NameMismatch)
                {
                    <MudTooltip Text="@L["A different computer responds at this name's address; the listed one is therefore unreachable."]">
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">@L["unreachable"]</MudChip>
                    </MudTooltip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default">@L["offline"]</MudChip>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@L["Operating system"]" SortBy="c => Display.Os(c)">
            <CellTemplate>@Display.Os(context.Item)</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@L["Security"]" Sortable="false">
            <CellTemplate>
                @if (context.Item.FirewallOff)
                {
                    <MudTooltip Text="@L["At least one firewall profile is off"]"><MudIcon Icon="@Icons.Material.Filled.GppBad" Color="Color.Error" Size="Size.Small" /></MudTooltip>
                }
                @if (context.Item.AntivirusProblem)
                {
                    <MudTooltip Text="@L["No real-time antivirus active"]"><MudIcon Icon="@Icons.Material.Filled.BugReport" Color="Color.Error" Size="Size.Small" /></MudTooltip>
                }
                @if (context.Item.UpdatePendingCount > 0)
                {
                    <MudTooltip Text="@L["{0} updates pending", context.Item.UpdatePendingCount]"><MudIcon Icon="@Icons.Material.Filled.SystemUpdateAlt" Color="Color.Warning" Size="Size.Small" /></MudTooltip>
                }
                @if (context.Item.UpdateRebootRequired == true)
                {
                    <MudTooltip Text="@L["Reboot pending"]"><MudIcon Icon="@Icons.Material.Filled.RestartAlt" Color="Color.Warning" Size="Size.Small" /></MudTooltip>
                }
                @if (context.Item.FirewallDomain is not null && !context.Item.FirewallOff && !context.Item.AntivirusProblem && !(context.Item.UpdatePendingCount > 0) && context.Item.UpdateRebootRequired != true)
                {
                    <MudTooltip Text="@L["Firewall on, antivirus active, no updates pending"]"><MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Color="Color.Success" Size="Size.Small" /></MudTooltip>
                }
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="c => c.Model" Title="@L["Model"]" />
        <PropertyColumn Property="c => c.LoggedOnUser" Title="@L["User"]" />
        <PropertyColumn Property="c => c.IpAddress" Title="@L["IP address"]" />
        <TemplateColumn Title="@L["Last scan"]" SortBy="c => c.LastScanUtc">
            <CellTemplate>
                @if (context.Item.LastScanError is not null)
                {
                    <MudTooltip Text="@context.Item.LastScanError">
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Size="Size.Small" />
                            <span>@L["failed"]</span>
                        </MudStack>
                    </MudTooltip>
                }
                else
                {
                    @Display.LocalTime(context.Item.LastScanUtc)
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Sortable="false" CellStyle="width: 1%; white-space: nowrap">
            <CellTemplate>
                <OperatorOnly>
                    <RemoteAccessMenu Computer="context.Item" Compact="true" />
                </OperatorOnly>
                <AdminOnly>
                    <MudTooltip Text="@L["Edit"]"><MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="@L["Edit"]" OnClick="@(() => EditAsync(context.Item))" /></MudTooltip>
                </AdminOnly>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudText Class="pa-4">
            @(_computers.Count > 0 || _filters.Count > 0 && _scope.Count > 0 ? L["No entries match the filter."]
                : _activeCollection is not null ? L["This collection contains no computers."]
                : _all.Count > 0 ? L["No entries match the filter."]
                : L["No computers yet. Use \"Add\" to enter names one by one or as a list."])
        </MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudDataGridPager T="Computer" PageSizeOptions="@(new[] { 25, 50, 100, 500 })" RowsPerPageString="@L["Rows per page"]" />
    </PagerContent>
</MudDataGrid>

@code {
    [SupplyParameterFromQuery(Name = "collection")] public int? CollectionId { get; set; }
    /// <summary>Filter, durch Komma getrennt (online,updates …); ein Rechner muss alle erfüllen.</summary>
    [SupplyParameterFromQuery(Name = "filter")] public string? Filter { get; set; }
    /// <summary>Geräteklassen (server, desktop, laptop …), durch Komma getrennt; eine davon genügt.</summary>
    [SupplyParameterFromQuery(Name = "type")] public string? Type { get; set; }

    private HashSet<string> _filters = [];
    private HashSet<ChassisKind> _types = [];

    /// <summary>Die Klasse, wie die Liste sie mit dem Symbol zeigt: ein Server-Betriebssystem macht einen Server.</summary>
    private static ChassisKind RoleOf(Computer c) => Chassis.Role(c.ChassisType, c.Model, c.OsName);

    private void SetCollection(int? id) => Navigate(id, _filters, _types);
    private void SetFilters(IEnumerable<string> filters) => Navigate(_activeCollection?.Id, filters, _types);
    private void SetTypes(IEnumerable<ChassisKind> types) => Navigate(_activeCollection?.Id, _filters, types);

    /// <summary>Sammlung, Filter und Geräteklassen stehen in der Adresse: die Ansicht lässt sich verlinken und überlebt ein Neuladen.</summary>
    private void Navigate(int? collection, IEnumerable<string> filters, IEnumerable<ChassisKind> types)
    {
        var keys = BuiltInViews.Select(v => v.Key).Where(filters.Contains).ToList();
        var kinds = types.Order().Select(k => k.ToString().ToLowerInvariant()).ToList();
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["collection"] = collection,
            ["filter"] = keys.Count > 0 ? string.Join(",", keys) : null,
            ["type"] = kinds.Count > 0 ? string.Join(",", kinds) : null,
        }));
    }

    private static readonly (string Key, string Label)[] BuiltInViews =
    [
        ("online", "Online"), ("offline", "Offline"), ("mismatch", "Wrong computer responds"),
        ("nodirectory", "Not (anymore) in AD"), ("inactive", "Presumably decommissioned"), ("unscanned", "Not scanned yet"), ("scanerror", "Scan failed"), ("agent", "With agent"),
        ("firewall", "Firewall off"), ("antivirus", "No real-time antivirus"), ("updates", "Updates pending"), ("reboot", "Reboot pending"),
        ("warranty", "Warranty ends within 90 days"),
    ];

    private List<Computer> _all = [];
    /// <summary>Alle Rechner oder die der gewählten Sammlung, noch ohne Filter.</summary>
    private List<Computer> _scope = [];

    private string InactiveText(Computer c) => L["Last AD logon {0}, last seen by the inventory {1}.",
        Display.LocalTime(c.DirectoryLastLogonUtc), c.LastInventorySightingUtc is null ? L["never"] : Display.LocalTime(c.LastInventorySightingUtc)];

    private static bool InView(string key, Computer c) => key switch
    {
        "online" => c.IsOnline,
        "offline" => !c.IsOnline,
        "mismatch" => c.NameMismatch,
        "unscanned" => c.LastScanUtc is null,
        "nodirectory" => c.MissingInDirectory,
        "inactive" => c.DirectoryInactive,
        "scanerror" => c.LastScanError is not null,
        "agent" => c.AgentKeyHash is not null,
        "firewall" => c.FirewallOff,
        "antivirus" => c.AntivirusProblem,
        "updates" => c.UpdatePendingCount > 0,
        "reboot" => c.UpdateRebootRequired == true,
        "warranty" => c.WarrantyDaysLeft(DateOnly.FromDateTime(DateTime.Now)) <= DashboardStats.WarrantyWarningDays,
        _ => true,
    };

    private bool InFilters(Computer c) => _filters.All(key => InView(key, c));

    private List<Computer> _computers = [];
    private List<CollectionSummary> _collections = [];
    private Collection? _activeCollection;
    private HashSet<Computer> _selected = [];
    private string _search = "";
    private bool _busy;
    private string? _progressText;

    protected override Task OnParametersSetAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        var requested = (Filter ?? "").Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
        _filters = BuiltInViews.Select(v => v.Key).Where(requested.Contains).ToHashSet();
        _types = (Type ?? "").Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
            .Select(t => Enum.TryParse<ChassisKind>(t, true, out var kind) && Enum.IsDefined(kind) ? kind : (ChassisKind?)null)
            .OfType<ChassisKind>().ToHashSet();
        _collections = await CollectionService.ListAsync();
        _activeCollection = _collections.FirstOrDefault(c => c.Collection.Id == CollectionId)?.Collection;
        _all = await ComputerService.ListAsync();
        if (_activeCollection is not null)
        {
            var members = await CollectionService.GetMemberIdsAsync(_activeCollection.Id);
            _scope = _all.Where(c => members.Contains(c.Id)).ToList();
        }
        else
            _scope = _all;
        _computers = _scope.Where(InFilters).ToList();
        _selected = [];
    }

    private bool Matches(Computer c) => (_types.Count == 0 || _types.Contains(RoleOf(c))) && MatchesSearch(c);

    private bool MatchesSearch(Computer c) =>
        string.IsNullOrWhiteSpace(_search)
        || new[] { c.Name, c.ReportedName, c.IpAddress, c.Description, c.OsName, c.Model, c.LoggedOnUser, c.SerialNumber,
                c.Owner, c.Location, c.CostCenter, c.InventoryNumber, c.Tags, c.PrimaryUser, c.Notes,
                c.PurchaseDate?.ToString("yyyy-MM-dd"), c.WarrantyUntil?.ToString("yyyy-MM-dd") }
            .Any(v => v?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false);

    /// <summary>Die Auswahl, sonst alle gerade angezeigten Rechner.</summary>
    private string NameOf(int id) => _computers.FirstOrDefault(c => c.Id == id)?.Name ?? $"#{id}";

    private List<int> TargetIds() => (_selected.Count > 0 ? _selected : _computers.Where(Matches)).Select(c => c.Id).ToList();

    private async Task ImportAssetsAsync()
    {
        if (!await Access.DemandAdminAsync())
            return;
        var dialog = await Dialogs.ShowAsync<ImportAssetsDialog>(L["Import asset data (CSV)"], new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Medium });
        if (await dialog.Result is { Canceled: false, Data: true })
            await ReloadAsync();
    }

    private async Task AddAsync()
    {
        if (!await Access.DemandAdminAsync())
            return;
        var dialog = await Dialogs.ShowAsync<AddComputersDialog>(L["Add computers"], new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
        if (await dialog.Result is { Canceled: false, Data: string text })
        {
            var added = await ComputerService.ImportAsync(text);
            if (added.Count == 0)
            {
                Snackbar.Add(L["No new computers – all names already existed or were invalid."], Severity.Warning);
                return;
            }
            await Audit.LogAsync(L["Computers added"], string.Join(", ", added.Select(c => c.Name)));
            if (_activeCollection is { IsDynamic: false })
                await CollectionService.AddMembersAsync(_activeCollection.Id, added.Select(c => c.Id));

            // Gleich prüfen, wer unter den neuen Namen wirklich antwortet: veraltete DNS-Einträge fallen so sofort auf.
            _busy = true;
            _progressText = L["Checking {0} new computers …", added.Count];
            StateHasChanged();
            try
            {
                var ids = added.Select(c => c.Id).ToHashSet();
                await ComputerService.ProbeAsync(ids);
                var all = await ComputerService.ListAsync();
                var fresh = all.Where(c => ids.Contains(c.Id)).ToList();
                Snackbar.Add(L["{0} computers added, {1} of them reachable.", added.Count, fresh.Count(c => c.IsOnline)], Severity.Success);
                foreach (var computer in fresh.Where(c => c.NameMismatch))
                {
                    var known = all.FirstOrDefault(c => c.Id != computer.Id && string.Equals(c.ExpectedMachineName, computer.ReportedName, StringComparison.OrdinalIgnoreCase));
                    Snackbar.Add(known is null
                            ? L["Under \"{0}\" the computer {1} responds – probably a stale DNS entry or alias.", computer.Name, computer.ReportedName]
                            : L["Under \"{0}\" {1} responds, which is already listed as \"{2}\".", computer.Name, computer.ReportedName, known.Name],
                        Severity.Warning, options => options.RequireInteraction = true);
                }
            }
            finally
            {
                _busy = false;
                _progressText = null;
            }
            await ReloadAsync();
        }
    }

    private async Task EditAsync(Computer computer)
    {
        if (!await Access.DemandAdminAsync())
            return;
        var parameters = new DialogParameters<EditComputerDialog>
        {
            { d => d.Computer, computer },
            { d => d.Credentials, await CredentialService.ListAsync() },
        };
        var dialog = await Dialogs.ShowAsync<EditComputerDialog>(computer.Name, parameters, new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
        if (await dialog.Result is { Canceled: false })
            await ReloadAsync();
    }

    private async Task WakeAsync()
    {
        if (!await Access.DemandOperatorAsync())
            return;
        // Wer schon läuft, braucht kein Paket.
        var ids = _selected.Where(c => !c.IsOnline).Select(c => c.Id).ToList();
        if (ids.Count == 0)
        {
            Snackbar.Add(L["All selected computers are online."], Severity.Info);
            return;
        }
        if (!await Access.DemandComputersAsync(ids, NameOf))
            return;
        var results = await WakeService.WakeAsync(ids);
        var sent = results.Where(r => r.Sent).ToList();
        if (sent.Count > 0)
            await Audit.LogAsync(L["Wake-up sent"], string.Join(", ", sent.Select(r => r.ComputerName)));
        var unknown = results.Count(r => r.Macs.Count == 0);
        var relayed = sent.Count(r => r.Relays.Count > 0);
        var via = relayed > 0 ? " " + L["For {0} of them also through an agent in their subnet.", relayed] : "";
        Snackbar.Add((unknown == 0
                ? L["Wake-up sent to {0} computers.", sent.Count]
                : L["Wake-up sent to {0} computers; for {1} no MAC address is known.", sent.Count, unknown]) + via,
            sent.Count > 0 ? Severity.Info : Severity.Warning);
    }

    private async Task ScanAsync()
    {
        if (!await Access.DemandOperatorAsync())
            return;
        var ids = TargetIds();
        // Ohne Auswahl ("alle scannen") nur die Rechner des eigenen Bereichs; eine Auswahl muss ganz darin liegen.
        if (_selected.Count == 0 && await Access.AllowedComputersAsync() is { } allowed)
            ids = [.. ids.Where(allowed.Contains)];
        else if (!await Access.DemandComputersAsync(ids, NameOf))
            return;
        if (ids.Count == 0)
            return;
        // Ohne Auswahl trifft der Scan schnell Hunderte Rechner: erst nachfragen.
        if (_selected.Count == 0 && await Dialogs.ShowMessageBoxAsync(L["Scan all"],
                L["Scan all {0} computers shown now? Each one is contacted over the network.", ids.Count], yesText: L["Scan"], cancelText: L["Cancel"]) != true)
            return;
        _busy = true;
        var done = 0;
        _progressText = L["Scanning {0} computers …", ids.Count];
        await Audit.LogAsync(L["Inventory scan started"], L["{0} computers", ids.Count]);
        try
        {
            var outcomes = await ScanService.ScanAsync(ids, _ =>
            {
                var current = Interlocked.Increment(ref done);
                _progressText = L["Scanning … {0} of {1} done", current, ids.Count];
                InvokeAsync(StateHasChanged);
            });
            var failed = outcomes.Count(o => !o.Success);
            Snackbar.Add(failed == 0 ? L["{0} computers scanned.", outcomes.Count] : L["{0} scanned, {1} failed.", outcomes.Count - failed, failed],
                failed == 0 ? Severity.Success : Severity.Warning);
            var mismatched = outcomes.Count(o => o.MismatchedName is not null);
            if (mismatched > 0)
                Snackbar.Add(L["{0} computers reported a different name than listed – see the marker in the list.", mismatched], Severity.Warning);
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
            _progressText = null;
        }
    }

    private async Task ProbeAsync()
