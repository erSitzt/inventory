@page "/computers"
@inject ComputerService ComputerService
@inject CredentialService CredentialService
@inject CollectionService CollectionService
@inject ScanService ScanService
@inject AgentService AgentService
@inject RemoteJobService Jobs
@inject Inventory.Remoting.RunnerPackage Runner
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject Auditor Audit

<PageTitle>Rechner – Inventory</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
    <MudText Typo="Typo.h5">Rechner</MudText>
    <MudSpacer />
    <MudSelect T="int?" Value="CollectionId" ValueChanged="SetCollection" Placeholder="Alle Rechner" Clearable="true" Variant="Variant.Outlined"
               Margin="Margin.Dense" Style="max-width: 240px" aria-label="Sammlung">
        @foreach (var summary in _collections)
        {
            <MudSelectItem T="int?" Value="@summary.Collection.Id">@summary.Collection.Name (@summary.Count)</MudSelectItem>
        }
    </MudSelect>
    <MudTextField @bind-Value="_search" Placeholder="Suchen" Adornment="Adornment.Start" Immediate="true"
                  AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 240px" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddAsync">Hinzufügen</MudButton>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ManageSearch" Disabled="_busy" OnClick="ScanAsync">
        @(_selected.Count > 0 ? $"Scannen ({_selected.Count})" : "Alle scannen")
    </MudButton>
    <MudMenu Label="Aktionen" Variant="Variant.Outlined" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" Disabled="_busy">
        <MudMenuItem Icon="@Icons.Material.Filled.NetworkCheck" OnClick="ProbeAsync">
            @(_selected.Count > 0 ? "Erreichbarkeit der Auswahl prüfen" : "Erreichbarkeit aller prüfen")
        </MudMenuItem>
        <MudMenuItem Icon="@Icons.Material.Filled.RocketLaunch" Disabled="@(_selected.Count == 0)" OnClick="DeployAsync">Paket bereitstellen</MudMenuItem>
        <MudMenuItem Icon="@Icons.Material.Filled.Terminal" Disabled="@(_selected.Count == 0)" OnClick="RunCommand">Befehl ausführen</MudMenuItem>
        <MudMenuItem Icon="@Icons.Material.Filled.SettingsRemote" Disabled="@(_selected.Count == 0)" OnClick="InstallAgentAsync">Agent installieren</MudMenuItem>
        <MudDivider />
        @foreach (var summary in _collections.Where(c => !c.Collection.IsDynamic))
        {
            var target = summary.Collection;
            <MudMenuItem Icon="@Icons.Material.Filled.CreateNewFolder" Disabled="@(_selected.Count == 0)" OnClick="@(() => AddToCollectionAsync(target))">
                Zu „@target.Name“ hinzufügen
            </MudMenuItem>
        }
        @if (_activeCollection is { IsDynamic: false })
        {
            <MudMenuItem Icon="@Icons.Material.Filled.FolderOff" Disabled="@(_selected.Count == 0)" OnClick="RemoveFromCollectionAsync">
                Aus „@_activeCollection.Name“ entfernen
            </MudMenuItem>
        }
        <MudDivider />
        <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" Disabled="@(_selected.Count == 0)" OnClick="DeleteAsync">Löschen</MudMenuItem>
    </MudMenu>
</MudStack>

@if (_busy && _progressText is not null)
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">@_progressText</MudAlert>
}

<MudDataGrid T="Computer" Items="_computers" MultiSelection="true" @bind-SelectedItems="_selected" QuickFilter="Matches"
             Dense="true" Hover="true" Loading="_busy" SortMode="SortMode.Single" RowsPerPage="50">
    <Columns>
        <SelectColumn T="Computer" />
        <TemplateColumn Title="Name" SortBy="c => c.Name">
            <CellTemplate>
                <MudLink Href="@($"computers/{context.Item.Id}")">@context.Item.Name</MudLink>
                @if (context.Item.NameMismatch)
                {
                    <MudTooltip Text="@($"Unter diesem Namen hat sich der Rechner {context.Item.ReportedName} gemeldet (veralteter DNS-Eintrag oder Alias?)")">
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.Warning">ist @context.Item.ReportedName</MudChip>
                    </MudTooltip>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Status" SortBy="c => c.IsOnline">
            <CellTemplate>
                @if (context.Item.AgentKeyHash is not null)
                {
                    <MudTooltip Text="@($"Agent {context.Item.AgentVersion}, letzter Kontakt {Display.LocalTime(context.Item.AgentLastSeenUtc)}")">
                        <MudChip T="string" Size="Size.Small" Color="@(Display.AgentConnected(context.Item) ? Color.Success : Color.Default)" Icon="@Icons.Material.Filled.SettingsRemote">
                            @(Display.AgentConnected(context.Item) ? "Agent" : "Agent getrennt")
                        </MudChip>
                    </MudTooltip>
                }
                else if (context.Item.LastProbeUtc is null && context.Item.LastScanUtc is null)
                {
                    <MudChip T="string" Size="Size.Small">ungeprüft</MudChip>
                }
                else if (context.Item.IsOnline)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success">online</MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default">offline</MudChip>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Betriebssystem" SortBy="c => Display.Os(c)">
            <CellTemplate>@Display.Os(context.Item)</CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="c => c.Model" Title="Modell" />
        <PropertyColumn Property="c => c.LoggedOnUser" Title="Benutzer" />
        <PropertyColumn Property="c => c.IpAddress" Title="IP-Adresse" />
        <TemplateColumn Title="Letzter Scan" SortBy="c => c.LastScanUtc">
            <CellTemplate>
                @if (context.Item.LastScanError is not null)
                {
                    <MudTooltip Text="@context.Item.LastScanError">
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Size="Size.Small" />
                            <span>fehlgeschlagen</span>
                        </MudStack>
                    </MudTooltip>
                }
                else
                {
                    @Display.LocalTime(context.Item.LastScanUtc)
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Sortable="false" CellStyle="width: 1%">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="Bearbeiten" OnClick="@(() => EditAsync(context.Item))" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudText Class="pa-4">
            @(_activeCollection is null
                ? "Noch keine Rechner vorhanden. Über „Hinzufügen“ lassen sich Namen einzeln oder als Liste anlegen."
                : "Diese Sammlung enthält keine Rechner.")
        </MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudDataGridPager T="Computer" PageSizeOptions="@(new[] { 25, 50, 100, 500 })" RowsPerPageString="Zeilen pro Seite" />
    </PagerContent>
</MudDataGrid>

@code {
    [SupplyParameterFromQuery(Name = "collection")] public int? CollectionId { get; set; }

    private List<Computer> _computers = [];
    private List<CollectionSummary> _collections = [];
    private Collection? _activeCollection;
    private HashSet<Computer> _selected = [];
    private string _search = "";
    private bool _busy;
    private string? _progressText;

    protected override Task OnParametersSetAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        _collections = await CollectionService.ListAsync();
        _activeCollection = _collections.FirstOrDefault(c => c.Collection.Id == CollectionId)?.Collection;
        var all = await ComputerService.ListAsync();
        if (_activeCollection is not null)
        {
            var members = await CollectionService.GetMemberIdsAsync(_activeCollection.Id);
            all = all.Where(c => members.Contains(c.Id)).ToList();
        }
        _computers = all;
        _selected = [];
    }

    private void SetCollection(int? id) =>
        Navigation.NavigateTo(id is null ? "computers" : $"computers?collection={id}");

    private bool Matches(Computer c) =>
        string.IsNullOrWhiteSpace(_search)
        || new[] { c.Name, c.ReportedName, c.IpAddress, c.Description, c.OsName, c.Model, c.LoggedOnUser, c.SerialNumber }
            .Any(v => v?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false);

    /// <summary>Die Auswahl, sonst alle gerade angezeigten Rechner.</summary>
    private List<int> TargetIds() => (_selected.Count > 0 ? _selected : _computers.Where(Matches)).Select(c => c.Id).ToList();

    private async Task AddAsync()
    {
        var dialog = await Dialogs.ShowAsync<AddComputersDialog>("Rechner hinzufügen", new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
        if (await dialog.Result is { Canceled: false, Data: string text })
        {
            var added = await ComputerService.ImportAsync(text);
            if (added.Count > 0)
                await Audit.LogAsync("Rechner hinzugefügt", string.Join(", ", added.Select(c => c.Name)));
            if (_activeCollection is { IsDynamic: false } && added.Count > 0)
                await CollectionService.AddMembersAsync(_activeCollection.Id, added.Select(c => c.Id));
            Snackbar.Add(added.Count == 0 ? "Keine neuen Rechner – alle Namen waren bereits vorhanden oder ungültig." : $"{added.Count} Rechner hinzugefügt.",
                added.Count == 0 ? Severity.Warning : Severity.Success);
            await ReloadAsync();
        }
    }

    private async Task EditAsync(Computer computer)
    {
        var parameters = new DialogParameters<EditComputerDialog>
        {
            { d => d.Computer, computer },
            { d => d.Credentials, await CredentialService.ListAsync() },
        };
        var dialog = await Dialogs.ShowAsync<EditComputerDialog>(computer.Name, parameters, new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
        if (await dialog.Result is { Canceled: false })
            await ReloadAsync();
    }

    private async Task ScanAsync()
    {
        var ids = TargetIds();
        if (ids.Count == 0)
            return;
        _busy = true;
        var done = 0;
        _progressText = $"Scanne {ids.Count} Rechner …";
        await Audit.LogAsync("Inventar-Scan gestartet", $"{ids.Count} Rechner"); 
        try
        {
            var outcomes = await ScanService.ScanAsync(ids, _ =>
            {
                var current = Interlocked.Increment(ref done);
                _progressText = $"Scanne … {current} von {ids.Count} fertig";
                InvokeAsync(StateHasChanged);
            });
            var failed = outcomes.Count(o => !o.Success);
            Snackbar.Add(failed == 0 ? $"{outcomes.Count} Rechner gescannt." : $"{outcomes.Count - failed} gescannt, {failed} fehlgeschlagen.",
                failed == 0 ? Severity.Success : Severity.Warning);
            var mismatched = outcomes.Count(o => o.MismatchedName is not null);
            if (mismatched > 0)
                Snackbar.Add($"{mismatched} Rechner haben sich mit einem anderen Namen gemeldet als eingetragen – siehe Markierung in der Liste.", Severity.Warning);
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
            _progressText = null;
        }
    }

    private async Task ProbeAsync()
    {
        var ids = TargetIds();
        _busy = true;
        try
        {
            var online = await ComputerService.ProbeAsync(ids);
            Snackbar.Add($"{online} von {ids.Count} Rechnern erreichbar.", Severity.Info);
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private Task DeployAsync()
    {
        var parameters = new DialogParameters<DeployDialog> { { d => d.ComputerIds, _selected.Select(c => c.Id).ToList() } };
        return Dialogs.ShowAsync<DeployDialog>("Paket bereitstellen", parameters, new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
    }

    private async Task InstallAgentAsync()
    {
        BuiltJob job;
        try
        {
            job = await AgentService.BuildInstallJobAsync(Runner.Files, Runner.Hash);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return;
        }

        var targets = _selected.ToList();
        _busy = true;
        _progressText = $"Installiere Agent auf {targets.Count} Rechnern …";
        await Audit.LogAsync("Agent-Installation gestartet", string.Join(", ", targets.Select(c => c.Name)));
        try
        {
            var failures = new System.Collections.Concurrent.ConcurrentBag<string>();
            await Parallel.ForEachAsync(targets, new ParallelOptions { MaxDegreeOfParallelism = 8 }, async (computer, ct) =>
            {
                // Jeder Rechner braucht eine eigene Job-ID; der Agent selbst kann sich nicht aktualisieren, daher immer agentenlos.
                var manifest = new JobManifest { Steps = job.Manifest.Steps };
                var result = await Jobs.RunAsync(computer.Id, manifest, null, ct, job.Files, agentless: true);
                if (!result.Success)
                    failures.Add($"{computer.Name}: {result.Error ?? result.Steps.FirstOrDefault(s => s.Error is not null)?.Error ?? result.Steps.LastOrDefault()?.Output}");
            });
            if (failures.IsEmpty)
                Snackbar.Add($"Agent auf {targets.Count} Rechnern installiert. Sie erscheinen als „Agent“, sobald sich der Dienst meldet.", Severity.Success);
            else
                Snackbar.Add($"{failures.Count} von {targets.Count} fehlgeschlagen – {string.Join("; ", failures.Take(3))}", Severity.Error);
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
            _progressText = null;
        }
    }

    private void RunCommand() => Navigation.NavigateTo($"run?ids={string.Join(',', _selected.Select(c => c.Id))}");

    private async Task AddToCollectionAsync(Collection collection)
    {
        var added = await CollectionService.AddMembersAsync(collection.Id, _selected.Select(c => c.Id));
        Snackbar.Add($"{added} Rechner zu „{collection.Name}“ hinzugefügt.", Severity.Success);
        await ReloadAsync();
    }

    private async Task RemoveFromCollectionAsync()
    {
        var removed = await CollectionService.RemoveMembersAsync(_activeCollection!.Id, _selected.Select(c => c.Id));
        Snackbar.Add($"{removed} Rechner aus „{_activeCollection.Name}“ entfernt.", Severity.Success);
        await ReloadAsync();
    }

    private async Task DeleteAsync()
    {
        var count = _selected.Count;
        var confirmed = await Dialogs.ShowMessageBoxAsync("Rechner löschen",
            $"{count} Rechner samt Inventardaten wirklich löschen? Das lässt sich nicht rückgängig machen.", yesText: "Löschen", cancelText: "Abbrechen");
        if (confirmed != true)
            return;
        await ComputerService.DeleteAsync(_selected.Select(c => c.Id));
        await Audit.LogAsync("Rechner gelöscht", string.Join(", ", _selected.Select(c => c.Name)));
        Snackbar.Add($"{count} Rechner gelöscht.", Severity.Success);
        await ReloadAsync();
    }
}
