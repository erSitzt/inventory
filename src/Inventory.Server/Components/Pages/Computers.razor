    private async Task InstallAgentAsync()
    {
        if (!await Access.DemandAdminAsync())
            return;
        BuiltJob job;
        try
        {
            job = await AgentService.BuildInstallJobAsync();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return;
        }

        var targets = _selected.ToList();
        _busy = true;
        _progressText = L["Installing agent on {0} computers …", targets.Count];
        await Audit.LogAsync(L["Agent installation started"], string.Join(", ", targets.Select(c => c.Name)));
        try
        {
            var failures = new System.Collections.Concurrent.ConcurrentBag<string>();
            await Parallel.ForEachAsync(targets, new ParallelOptions { MaxDegreeOfParallelism = 8 }, async (computer, ct) =>
            {
                // Der Agent selbst kann sich nicht aktualisieren, daher immer agentenlos.
                var result = await Jobs.RunAgentInstallAsync(computer.Id, job, ct);
                if (!result.Success)
                    failures.Add($"{computer.Name}: {result.Error ?? result.Steps.FirstOrDefault(s => s.Error is not null)?.Error ?? result.Steps.LastOrDefault()?.Output}");
            });
            if (failures.IsEmpty)
                Snackbar.Add(L["Agent installed on {0} computers. They show as \"Agent\" as soon as the service reports in.", targets.Count], Severity.Success);
            else
                Snackbar.Add(L["{0} of {1} failed – {2}", failures.Count, targets.Count, string.Join("; ", failures.Take(3))], Severity.Error);
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
            _progressText = null;
        }
    }

    /// <summary>
    /// Installiert .NET Framework 4.8 ohne Runner (über ADMIN$ und den Dienststeuer-Manager); für Rechner, auf denen der
    /// Runner mangels Framework nicht startet. Rechner, die es schon haben, bleiben unberührt.
    /// </summary>
    private async Task InstallFrameworkAsync()
    {
        if (!await Access.DemandAdminAsync())
            return;
        var targets = _selected.ToList();
        var confirmed = await Dialogs.ShowMessageBoxAsync(L["Install .NET Framework 4.8"],
            L["Installs .NET Framework 4.8 from the offline installer of Microsoft on {0} computers. It takes 5 to 30 minutes per computer and usually needs a restart, which Inventory does not trigger. Computers that already have it are left alone.", targets.Count],
            yesText: L["Install"], cancelText: L["Cancel"]);
        if (confirmed != true)
            return;

        _busy = true;
        _progressText = L["Installing .NET Framework 4.8 on {0} computers …", targets.Count];
        StateHasChanged();
        await Audit.LogAsync(L[".NET Framework installation started"], string.Join(", ", targets.Select(c => c.Name)));
        try
        {
            var results = new System.Collections.Concurrent.ConcurrentBag<(string Computer, Inventory.Core.Abstractions.FrameworkInstallResult Result)>();
            await Parallel.ForEachAsync(targets, new ParallelOptions { MaxDegreeOfParallelism = 8 }, async (computer, ct) =>
                results.Add((computer.Name, await Framework.InstallAsync(computer.Id, ct))));
            foreach (var (computer, result) in results.OrderBy(r => r.Computer))
                await Audit.LogAsync(result.Success ? L[".NET Framework installed"] : L[".NET Framework installation failed"], $"{computer}: {result.Message}");
            var failures = results.Where(r => !r.Result.Success).Select(r => $"{r.Computer}: {r.Result.Message}").ToList();
            var reboot = results.Where(r => r.Result is { Success: true, RebootRequired: true }).Select(r => r.Computer).ToList();
            if (failures.Count == 0)
                Snackbar.Add(reboot.Count == 0
                    ? L[".NET Framework 4.8 is installed on {0} computers.", targets.Count]
                    : L[".NET Framework 4.8 is installed on {0} computers; {1} need a restart: {2}", targets.Count, reboot.Count, string.Join(", ", reboot.Take(5))], Severity.Success);
            else
                Snackbar.Add(L["{0} of {1} failed – {2}", failures.Count, targets.Count, string.Join("; ", failures.Take(3))], Severity.Error);
        }
        finally
        {
            _busy = false;
            _progressText = null;
        }
    }

    /// <summary>Richtet auf den gewählten (Admin-)PCs den Starter ein, der Fernzugriffe direkt aus der Oberfläche öffnet.</summary>
    private async Task InstallLauncherAsync()
    {
        if (!await Access.DemandAdminAsync())
            return;
        BuiltJob job;
        try
        {
            job = AgentService.BuildLauncherInstallJob(Path.Combine(AppContext.BaseDirectory, "launcher"));
        }
        catch (Exception ex) when (ex is InvalidOperationException or IOException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return;
        }

        var targets = _selected.ToList();
        _busy = true;
        _progressText = L["Installing the launcher on {0} computers …", targets.Count];
        await Audit.LogAsync(L["Remote access launcher installed"], string.Join(", ", targets.Select(c => c.Name)));
        try
        {
            var failures = new System.Collections.Concurrent.ConcurrentBag<string>();
            await Parallel.ForEachAsync(targets, new ParallelOptions { MaxDegreeOfParallelism = 8 }, async (computer, ct) =>
            {
                var result = await Jobs.RunAsync(computer.Id, new JobManifest { Steps = job.Manifest.Steps }, null, ct, job.Files);
                if (!result.Success)
                    failures.Add($"{computer.Name}: {result.Error ?? result.Steps.FirstOrDefault(s => s.Error is not null)?.Error}");
            });
            if (failures.IsEmpty)
                Snackbar.Add(L["Launcher set up on {0} computers. Remote access now opens there with one click.", targets.Count], Severity.Success);
            else
                Snackbar.Add(L["{0} of {1} failed – {2}", failures.Count, targets.Count, string.Join("; ", failures.Take(3))], Severity.Error);
        }
        finally
        {
            _busy = false;
            _progressText = null;
        }
    }

