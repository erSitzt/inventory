        var removed = await CollectionService.RemoveMembersAsync(_activeCollection!.Id, _selected.Select(c => c.Id));
        await Audit.LogAsync(L["Collection members removed"], $"{_activeCollection.Name}: {string.Join(", ", _selected.Select(c => c.Name))}");
