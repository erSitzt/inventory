    private async Task DeleteAsync()
    {
        if (!await Access.DemandAdminAsync())
            return;
        var count = _selected.Count;
        var confirmed = await Dialogs.ShowMessageBoxAsync(L["Delete computers"],
            L["Really delete {0} computers including their inventory data? This cannot be undone.", count], yesText: L["Delete"], cancelText: L["Cancel"]);
        if (confirmed != true)
            return;
        await ComputerService.DeleteAsync(_selected.Select(c => c.Id));
        await Audit.LogAsync(L["Computers deleted"], string.Join(", ", _selected.Select(c => c.Name)));
        Snackbar.Add(L["{0} computers deleted.", count], Severity.Success);
        await ReloadAsync();
    }
