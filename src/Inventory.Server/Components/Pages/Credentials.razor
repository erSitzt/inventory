@page "/credentials"
@inject CredentialService CredentialService
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject Auditor Audit
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Credentials"] – Inventory</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h5">@L["Credentials"]</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => EditAsync(null))">@L["Add"]</MudButton>
</MudStack>

<MudText Typo="Typo.body2" Class="mb-4">
    @L["The server uses these accounts to access the target computers. They need local administrator rights there. Passwords are stored encrypted and never shown again."]
</MudText>

<MudDataGrid T="Credential" Items="_credentials" Dense="true" Hover="true" SortMode="SortMode.None">
    <Columns>
        <PropertyColumn Property="c => c.Name" Title="@L["Name"]" />
        <PropertyColumn Property="c => c.Username" Title="@L["User"]" />
        <PropertyColumn Property="c => c.Description" Title="@L["Description"]" />
        <TemplateColumn Title="@L["Default"]">
            <CellTemplate>
                @if (context.Item.IsDefault)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">@L["Default"]</MudChip>
                }
                else
                {
                    <MudButton Size="Size.Small" OnClick="@(() => SetDefaultAsync(context.Item))">@L["Make default"]</MudButton>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn CellStyle="width: 1%; white-space: nowrap">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="@L["Edit"]" OnClick="@(() => EditAsync(context.Item))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" aria-label="@L["Delete"]" OnClick="@(() => DeleteAsync(context.Item))" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudText Class="pa-4">@L["No credentials stored yet."]</MudText>
    </NoRecordsContent>
</MudDataGrid>

@code {
    private List<Credential> _credentials = [];

    protected override async Task OnInitializedAsync() => _credentials = await CredentialService.ListAsync();

    private async Task EditAsync(Credential? credential)
    {
        var parameters = new DialogParameters<EditCredentialDialog> { { d => d.Credential, credential } };
        var dialog = await Dialogs.ShowAsync<EditCredentialDialog>(credential?.Name ?? L["Add credentials"], parameters,
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
        if (await dialog.Result is { Canceled: false })
            _credentials = await CredentialService.ListAsync();
    }

    private async Task SetDefaultAsync(Credential credential)
    {
        await CredentialService.SetDefaultAsync(credential.Id);
        await Audit.LogAsync(L["Default credentials changed"], credential.Name);
        _credentials = await CredentialService.ListAsync();
    }

    private async Task DeleteAsync(Credential credential)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(L["Delete credentials"],
            L["Really delete \"{0}\"? Computers using these credentials fall back to the default.", credential.Name],
            yesText: L["Delete"], cancelText: L["Cancel"]);
        if (confirmed != true)
            return;
        await CredentialService.DeleteAsync(credential.Id);
        await Audit.LogAsync(L["Credentials deleted"], $"{credential.Name} ({credential.Username})");
        Snackbar.Add(L["Credentials deleted."], Severity.Success);
        _credentials = await CredentialService.ListAsync();
    }
}
