@page "/credentials"
@inject CredentialService CredentialService
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject Auditor Audit

<PageTitle>Zugangsdaten – Inventory</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h5">Zugangsdaten</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => EditAsync(null))">Hinzufügen</MudButton>
</MudStack>

<MudText Typo="Typo.body2" Class="mb-4">
    Mit diesen Konten greift der Server auf die Zielrechner zu. Sie brauchen dort lokale Administratorrechte.
    Passwörter werden verschlüsselt gespeichert und nie wieder angezeigt.
</MudText>

<MudDataGrid T="Credential" Items="_credentials" Dense="true" Hover="true" SortMode="SortMode.None">
    <Columns>
        <PropertyColumn Property="c => c.Name" Title="Name" />
        <PropertyColumn Property="c => c.Username" Title="Benutzer" />
        <PropertyColumn Property="c => c.Description" Title="Beschreibung" />
        <TemplateColumn Title="Standard">
            <CellTemplate>
                @if (context.Item.IsDefault)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">Standard</MudChip>
                }
                else
                {
                    <MudButton Size="Size.Small" OnClick="@(() => SetDefaultAsync(context.Item))">Als Standard</MudButton>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn CellStyle="width: 1%; white-space: nowrap">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="Bearbeiten" OnClick="@(() => EditAsync(context.Item))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" aria-label="Löschen" OnClick="@(() => DeleteAsync(context.Item))" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudText Class="pa-4">Noch keine Zugangsdaten hinterlegt.</MudText>
    </NoRecordsContent>
</MudDataGrid>

@code {
    private List<Credential> _credentials = [];

    protected override async Task OnInitializedAsync() => _credentials = await CredentialService.ListAsync();

    private async Task EditAsync(Credential? credential)
    {
        var parameters = new DialogParameters<EditCredentialDialog> { { d => d.Credential, credential } };
        var dialog = await Dialogs.ShowAsync<EditCredentialDialog>(credential?.Name ?? "Zugangsdaten hinzufügen", parameters,
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
        if (await dialog.Result is { Canceled: false })
            _credentials = await CredentialService.ListAsync();
    }

    private async Task SetDefaultAsync(Credential credential)
    {
        await CredentialService.SetDefaultAsync(credential.Id);
        await Audit.LogAsync("Standard-Zugangsdaten geändert", credential.Name);
        _credentials = await CredentialService.ListAsync();
    }

    private async Task DeleteAsync(Credential credential)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync("Zugangsdaten löschen",
            $"„{credential.Name}“ wirklich löschen? Rechner, die diese Zugangsdaten nutzen, fallen auf den Standard zurück.",
            yesText: "Löschen", cancelText: "Abbrechen");
        if (confirmed != true)
            return;
        await CredentialService.DeleteAsync(credential.Id);
        await Audit.LogAsync("Zugangsdaten gelöscht", $"{credential.Name} ({credential.Username})");
        Snackbar.Add("Zugangsdaten gelöscht.", Severity.Success);
        _credentials = await CredentialService.ListAsync();
    }
}
