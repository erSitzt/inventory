@page "/schedules"
@inject ScheduleService ScheduleService
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject Auditor Audit
@inject Display Display
@inject IStringLocalizer<SharedResource> L
@inject Access Access

<PageTitle>@L["Schedules"] – Inventory</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h5">@L["Schedules"]</MudText>
    <MudSpacer />
    <AdminOnly>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => EditAsync(null))">@L["New schedule"]</MudButton>
    </AdminOnly>
</MudStack>

<MudText Typo="Typo.body2" Class="mb-4">
    @L["A schedule scans regularly or deploys a package to a collection, e.g. \"Chrome\" to \"Chrome outdated\"."]
    @if (_schedules.Any(s => s.Name.StartsWith(ExampleData.Prefix)))
    {
        <span class="ml-1">@L["The examples are disabled; use \"Edit\" to adjust and enable them, or simply delete them."]</span>
    }
</MudText>

<MudDataGrid T="Schedule" Items="_schedules" Dense="true" Hover="true" SortMode="SortMode.None">
    <Columns>
        <PropertyColumn Property="s => s.Name" Title="@L["Name"]" />
        <TemplateColumn Title="@L["Action"]">
            <CellTemplate>@(context.Item.Action switch
                {
                    ScheduleAction.Scan => L["Inventory scan"],
                    ScheduleAction.Report => L["Report \"{0}\"", context.Item.Report?.Name],
                    ScheduleAction.DeviceScan => L["Network device scan"],
                    _ => L["Package \"{0}\"", context.Item.Package?.Name],
                })</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@L["Target"]">
            <CellTemplate>@(context.Item.Action switch
                {
                    ScheduleAction.Report => context.Item.NotificationChannel?.Name ?? L["all enabled channels"],
                    ScheduleAction.DeviceScan => L["All enabled address ranges"],
                    _ => context.Item.Collection?.Name ?? L["All computers"],
                })</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@L["Rhythm"]">
            <CellTemplate>@Display.Trigger(context.Item)</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@L["Fulfilled"]">
            <CellTemplate>
                @if (_compliance.TryGetValue(context.Item.Id, out var state))
                {
                    <MudTooltip Text="@L["Members of the target on which the package succeeded through this schedule"]">
                        <MudChip T="string" Size="Size.Small" Color="@(state.Members > 0 && state.Compliant == state.Members ? Color.Success : Color.Warning)">@state.Compliant / @state.Members</MudChip>
                    </MudTooltip>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@L["Next run"]">
            <CellTemplate>
                @if (!context.Item.Enabled)
                {
                    <MudChip T="string" Size="Size.Small">@L["disabled"]</MudChip>
                }
                else
                {
                    @Display.LocalTime(context.Item.NextRunUtc)
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@L["Last run"]">
            <CellTemplate>
                @if (context.Item.LastRunUtc is not null)
                {
                    <span>@Display.LocalTime(context.Item.LastRunUtc): @context.Item.LastResult</span>
                }
                else
                {
                    <span>–</span>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn CellStyle="width: 1%; white-space: nowrap">
            <CellTemplate>
                <AdminOnly>
                    <MudTooltip Text="@L["Run now"]"><MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" aria-label="@L["Run now"]" Disabled="_busy" OnClick="@(() => RunNowAsync(context.Item))" /></MudTooltip>
                    <MudTooltip Text="@L["Edit"]"><MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="@L["Edit"]" OnClick="@(() => EditAsync(context.Item))" /></MudTooltip>
                    <MudTooltip Text="@L["Delete"]"><MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" aria-label="@L["Delete"]" OnClick="@(() => DeleteAsync(context.Item))" /></MudTooltip>
                </AdminOnly>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudText Class="pa-4">@L["No schedules yet. A schedule scans regularly or deploys a package to a collection – e.g. to the dynamic collection \"Chrome outdated\"."]</MudText>
    </NoRecordsContent>
</MudDataGrid>

@code {
    private List<Schedule> _schedules = [];
    private Dictionary<int, ScheduleService.Compliance> _compliance = [];
    private bool _busy;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        _schedules = await ScheduleService.ListAsync();
        _compliance = await ScheduleService.ComplianceAsync();
    }

    private async Task EditAsync(Schedule? schedule)
    {
        if (!await Access.DemandAdminAsync())
            return;
        var parameters = new DialogParameters<EditScheduleDialog> { { d => d.Schedule, schedule } };
        var dialog = await Dialogs.ShowAsync<EditScheduleDialog>(schedule?.Name ?? L["New schedule"], parameters, new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
        if (await dialog.Result is { Canceled: false })
            await ReloadAsync();
    }

    private async Task RunNowAsync(Schedule schedule)
    {
        if (!await Access.DemandAdminAsync())
            return;
        _busy = true;
        try
        {
            await Audit.LogAsync(L["Schedule started manually"], schedule.Name);
            var result = await ScheduleService.RunNowAsync(schedule.Id);
            Snackbar.Add($"{schedule.Name}: {result}", result.StartsWith(L["Error"]) ? Severity.Error : Severity.Success);
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync(Schedule schedule)
    {
        if (!await Access.DemandAdminAsync())
            return;
        var confirmed = await Dialogs.ShowMessageBoxAsync(L["Delete schedule"], L["Really delete \"{0}\"?", schedule.Name], yesText: L["Delete"], cancelText: L["Cancel"]);
        if (confirmed != true)
            return;
        await ScheduleService.DeleteAsync(schedule.Id);
        await Audit.LogAsync(L["Schedule deleted"], schedule.Name);
        _schedules = await ScheduleService.ListAsync();
    }
}
