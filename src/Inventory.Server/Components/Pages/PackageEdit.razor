@page "/packages/{Id:int}"
@inject PackageService PackageService
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject Auditor Audit
@inject Display Display
@inject IStringLocalizer<SharedResource> L
@inject Access Access

<PageTitle>@(_package?.Name ?? L["Package"]) – Inventory</PageTitle>

@if (_package is null)
{
    @if (_loaded)
    {
        <MudAlert Severity="Severity.Warning">@L["This package does not exist (anymore)."] <MudLink Href="packages">@L["Back to the list"]</MudLink></MudAlert>
    }
    return;
}

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="packages" aria-label="@L["Back to the list"]" />
    <MudText Typo="Typo.h5">@_package.Name</MudText>
    <MudSpacer />
    <OperatorOnly>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.RocketLaunch" Disabled="@(_package.Steps.Count == 0 || (!_package.IsApproved && !_isAdmin))" OnClick="DeployAsync">@L["Deploy"]</MudButton>
    </OperatorOnly>
</MudStack>

<MudAlert Severity="@(_package.IsApproved ? Severity.Success : Severity.Warning)" Dense="true" Class="mb-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Wrap="Wrap.Wrap">
        @if (_package.IsApproved)
        {
            <span>@L["Approved for deployment by {0} on {1}.", _package.ApprovedBy, Display.LocalTime(_package.ApprovedUtc)]</span>
            <AdminOnly><MudButton Size="Size.Small" Variant="Variant.Text" OnClick="RevokeApprovalAsync">@L["Withdraw approval"]</MudButton></AdminOnly>
        }
        else
        {
            <span>@L["Not approved: operators and schedules cannot deploy this package. Every change to steps, detection or files withdraws the approval."]</span>
            <AdminOnly><MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@(_package.Steps.Count == 0)" OnClick="ApproveAsync">@L["Approve"]</MudButton></AdminOnly>
        }
    </MudStack>
</MudAlert>

@if (_package.CatalogId is not null)
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
        @L["Imported from the"] <MudLink Href="library">@L["package library"]</MudLink> (@_package.CatalogId).
        @(_package.CatalogAutoUpdate ? L["New versions are adopted automatically"] : L["New versions are not adopted automatically"]);
        @L["the installation step is then replaced with the new setup, own steps and files are kept."]
    </MudAlert>
}

<MudGrid>
    <MudItem xs="12" lg="7">
        <MudPaper Class="pa-4 mb-4" Outlined="true">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                <MudText Typo="Typo.h6">@L["Steps"]</MudText>
                <MudSpacer />
                <AdminOnly>
                    <MudMenu Label="@L["Add step"]" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" EndIcon="@Icons.Material.Filled.KeyboardArrowDown">
                        @foreach (var type in AddableTypes)
                        {
                            <MudMenuItem Icon="@Display.StepIcon(type)" OnClick="@(() => EditStepAsync(null, type, false))">@Display.Step(type)</MudMenuItem>
                        }
                        <MudDivider />
                        <MudMenuItem Icon="@Icons.Material.Filled.Inventory2" OnClick="@(() => EditStepAsync(null, StepType.Command, true))">@L["Run another package"]</MudMenuItem>
                    </MudMenu>
                </AdminOnly>
            </MudStack>

            @if (_package.Steps.Count == 0)
            {
                <MudText Color="Color.Secondary">@L["No steps yet. Steps run on the target computer one after another as Local System."]</MudText>
            }
            <MudList T="string" Dense="true">
                @foreach (var (step, index) in _package.Steps.Select((s, i) => (s, i)))
                {
                    <MudListItem T="string" Ripple="false">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudText Typo="Typo.body2" Style="width: 1.5rem; text-align: right">@(index + 1).</MudText>
                            <MudIcon Icon="@(step.NestedPackageId is null ? Display.StepIcon(step.Definition.Type) : Icons.Material.Filled.Inventory2)" Size="Size.Small" />
                            <div style="flex: 1; min-width: 0">
                                <MudText Typo="Typo.body1">@step.Definition.Name</MudText>
                                <MudText Typo="Typo.caption" Class="step-summary">
                                    @if (step.NestedPackageId is not null)
                                    {
                                        <span>@L["Package \"{0}\"", step.NestedPackage?.Name]</span>
                                    }
                                    else
                                    {
                                        <span>@Display.Step(step.Definition.Type): @Display.StepSummary(step.Definition)</span>
                                    }
                                    @if (step.NestedPackageId is null && step.Definition.RunAs == StepRunAs.LoggedOnUser)
                                    {
                                        <span> · @L["as logged-on user"]</span>
                                    }
                                    @if (step.Definition.Conditions is { IsEmpty: false })
                                    {
                                        <span> · @L["with condition"]</span>
                                    }
                                    @if (step.NestedPackageId is null && step.Definition.Retries > 0)
                                    {
                                        <span> · @L["{0} retries", step.Definition.Retries]</span>
                                    }
                                    @if (step.NestedPackageId is null && step.Definition.CloseProcesses.Count > 0)
                                    {
                                        <span> · @L["closes {0}", string.Join(", ", step.Definition.CloseProcesses)]</span>
                                    }
                                    @if (step.Definition.ContinueOnError)
                                    {
                                        <span> · @L["continue on error"]</span>
                                    }
                                </MudText>
                            </div>
                            <AdminOnly>
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" aria-label="@L["Move up"]" Disabled="@(index == 0)" OnClick="@(() => MoveAsync(step, -1))" />
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" aria-label="@L["Move down"]" Disabled="@(index == _package.Steps.Count - 1)" OnClick="@(() => MoveAsync(step, 1))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="@L["Edit"]" OnClick="@(() => EditStepAsync(step, step.Definition.Type, step.NestedPackageId is not null))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" aria-label="@L["Delete"]" OnClick="@(() => DeleteStepAsync(step))" />
                            </AdminOnly>
                        </MudStack>
                    </MudListItem>
                }
            </MudList>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" lg="5">
        <MudPaper Class="pa-4 mb-4" Outlined="true">
            <MudText Typo="Typo.h6" Class="mb-2">@L["Properties"]</MudText>
            <MudStack Spacing="3">
                <MudTextField @bind-Value="_name" Label="@L["Name"]" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                <MudTextField @bind-Value="_version" Label="@L["Version"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudTextField @bind-Value="_description" Label="@L["Description"]" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" />
                <AdminOnly>
                    <div>
                        <MudButton Variant="Variant.Outlined" Disabled="@string.IsNullOrWhiteSpace(_name)" OnClick="SaveHeaderAsync">@L["Save"]</MudButton>
                    </div>
                </AdminOnly>
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4 mb-4" Outlined="true">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                <MudText Typo="Typo.h6">@L["Detection"]</MudText>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@(_package.Detection is null ? Color.Default : Color.Success)">@(_package.Detection is null ? L["off"] : L["active"])</MudChip>
                <MudSpacer />
                <AdminOnly>
                    @if (MsiFiles.Count > 0)
                    {
                        <MudMenu Label="@L["Fill from MSI"]" Variant="Variant.Text" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" Dense="true">
                            @foreach (var file in MsiFiles)
                            {
                                <MudMenuItem OnClick="@(() => FillFromMsi(file, false))">@L["{0}: name and minimum version", file]</MudMenuItem>
                                <MudMenuItem OnClick="@(() => FillFromMsi(file, true))">@L["{0}: product code (exactly this version)", file]</MudMenuItem>
                            }
                        </MudMenu>
                    }
                </AdminOnly>
            </MudStack>
            <MudText Typo="Typo.body2" Class="mb-3">
                @L["If all conditions entered here apply, the package counts as already installed: the computer is skipped and reported as \"already installed\". Without detection the package always runs."]
            </MudText>
            <MudStack Spacing="3">
                <MudTextField @bind-Value="_detection.SoftwareInstalled" Label="@L["Installed program (name)"]" Placeholder="7-Zip" Variant="Variant.Outlined" Margin="Margin.Dense"
                              HelperText="@L["Name as shown in \"Programs and Features\". Without * it must occur as whole words, with * it is a pattern for the whole name."]" />
                <MudTextField @bind-Value="_detection.SoftwareMinVersion" Label="@L["Minimum version"]" Placeholder="24.08" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Disabled="@string.IsNullOrWhiteSpace(_detection.SoftwareInstalled)" />
                <MudTextField @bind-Value="_detection.MsiProductCode" Label="@L["MSI product code"]" Placeholder="{00000000-0000-0000-0000-000000000000}" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudTextField @bind-Value="_detection.FileExists" Label="@L["File/folder exists"]" Placeholder="%ProgramFiles%\App\app.exe" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudTextField @bind-Value="_detection.RegistryKeyExists" Label="@L["Registry key exists"]" Placeholder="HKLM\SOFTWARE\Company\Product" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudSwitch T="bool" @bind-Value="_verify" Color="Color.Primary" Disabled="@_detection.IsEmpty" Label="@L["Verify after the installation"]" />
                <MudText Typo="Typo.caption">
                    @L["With verification the detection must also apply after the last step; otherwise the deployment fails for this computer even if every step reported success."]
                </MudText>
                <AdminOnly>
                    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                        <MudButton Variant="Variant.Outlined" OnClick="SaveDetectionAsync">@L["Save"]</MudButton>
                        @if (!string.IsNullOrWhiteSpace(_package.Detection?.SoftwareInstalled) || !string.IsNullOrWhiteSpace(_package.Detection?.MsiProductCode))
                        {
                            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.DeleteSweep" OnClick="CreateUninstallAsync">@L["Uninstall package"]</MudButton>
                        }
                    </MudStack>
                </AdminOnly>
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4" Outlined="true">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                <MudText Typo="Typo.h6">@L["Files"]</MudText>
                <MudSpacer />
                <AdminOnly>
                    <MudButton HtmlTag="label" for="package-files" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.UploadFile" Disabled="_uploading">
                        @(_uploading ? _uploadText : L["Upload"])
                    </MudButton>
                    <InputFile id="package-files" OnChange="UploadAsync" multiple hidden />
                </AdminOnly>
            </MudStack>
            <MudText Typo="Typo.body2" Class="mb-2">
                @L["All files of the package are copied to the target computer with every deployment. Large files can also be placed directly on the server:"] <code>@PackageService.Repository.DirectoryFor(Id)</code>
            </MudText>
            @if (_files.Count == 0)
            {
                <MudText Color="Color.Secondary">@L["No files."]</MudText>
            }
            else
            {
                <MudSimpleTable Dense="true" Elevation="0">
                    <tbody>
                        @foreach (var file in _files)
                        {
                            <tr>
                                <td style="word-break: break-all">@file.RelativePath</td>
                                <td style="white-space: nowrap; text-align: right">@Display.FileSize(file.Size)</td>
                                <AdminOnly>
                                    <td style="width: 1%"><MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" aria-label="@L["Delete file"]" OnClick="@(() => DeleteFile(file))" /></td>
                                </AdminOnly>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private const long MaxUploadBytes = 8L << 30;

    private static readonly StepType[] AddableTypes =
        [StepType.Install, StepType.Uninstall, StepType.WindowsUpdate, StepType.Command, StepType.PowerShell, StepType.FileCopy, StepType.Service, StepType.Sleep, StepType.Reboot, StepType.InventoryScan];

    [Parameter] public int Id { get; set; }

    private Package? _package;
    private bool _loaded;
    private string _name = "";
    private string? _version;
    private string? _description;
    private List<Inventory.Data.RepositoryFile> _files = [];
    private bool _uploading;
    private bool _isAdmin;
    private StepConditions _detection = new();
    private bool _verify;

    private List<string> MsiFiles => _files.Select(f => f.RelativePath).Where(f => f.EndsWith(".msi", StringComparison.OrdinalIgnoreCase)).ToList();
    private string _uploadText = "";

    protected override async Task OnParametersSetAsync()
    {
        _isAdmin = await Access.IsAdminAsync();
        await ReloadAsync();
        _loaded = true;
        if (_package is not null)
        {
            _name = _package.Name;
            _version = _package.Version;
            _description = _package.Description;
            LoadDetection();
        }
    }

    private async Task ReloadAsync()
    {
        _package = await PackageService.GetAsync(Id);
        _files = _package is null ? [] : PackageService.Repository.List(Id);
    }

    private async Task SaveHeaderAsync()
    {
        if (!await Access.DemandAdminAsync())
            return;
        try
        {
            var before = $"{_package!.Name} {_package.Version}".Trim();
            await PackageService.SaveAsync(Id, _name, _version, _description);
            var after = $"{_name.Trim()} {_version?.Trim()}".Trim();
            await Audit.LogAsync(L["Package changed"], before == after ? after : $"{before} → {after}");
            Snackbar.Add(L["Saved."], Severity.Success);
            await ReloadAsync();
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateException)
        {
            Snackbar.Add(L["A package named \"{0}\" already exists.", _name.Trim()], Severity.Error);
        }
    }

    private async Task ApproveAsync()
    {
        if (!await Access.DemandAdminAsync())
            return;
        await PackageService.ApproveAsync(Id, await Audit.UserNameAsync());
        await Audit.LogAsync(L["Package approved"], $"{_package!.Name} {_package.Version}".Trim());
        await ReloadAsync();
    }

    private async Task RevokeApprovalAsync()
    {
        if (!await Access.DemandAdminAsync())
            return;
        await PackageService.RevokeApprovalAsync(Id);
        await Audit.LogAsync(L["Package approval withdrawn"], _package!.Name);
        await ReloadAsync();
    }

    private void LoadDetection()
    {
        // Kopie, damit ungespeicherte Eingaben nicht im geladenen Paket landen.
        _detection = _package!.Detection is { } stored ? JobJson.Deserialize<StepConditions>(JobJson.Serialize(stored))! : new StepConditions();
        _verify = _package.VerifyAfterInstall;
    }

    private async Task SaveDetectionAsync()
    {
        if (!await Access.DemandAdminAsync())
            return;
        await PackageService.SaveDetectionAsync(Id, _detection, _verify);
        await Audit.LogAsync(L["Package detection changed"], $"{_package!.Name}: {(_detection.IsEmpty ? L["off"] : Display.Detection(_detection))}");
        Snackbar.Add(L["Saved."], Severity.Success);
        await ReloadAsync();
        LoadDetection();
    }

    /// <summary>Gegenstück zum Paket: entfernt das Programm, das die Erkennung beschreibt.</summary>
    private async Task CreateUninstallAsync()
    {
        if (!await Access.DemandAdminAsync())
            return;
        var detection = _package!.Detection!;
        var (package, created) = await PackageService.EnsureUninstallPackageAsync(
            string.IsNullOrWhiteSpace(detection.SoftwareInstalled) ? _package.Name : detection.SoftwareInstalled, detection.SoftwareInstalled, detection.MsiProductCode,
            approvedBy: await Audit.UserNameAsync());
        if (created)
            await Audit.LogAsync(L["Package created"], package.Name);
        Navigation.NavigateTo($"packages/{package.Id}");
    }

    private void FillFromMsi(string file, bool productCode)
    {
        if (Inventory.Data.MsiProperties.Read(PackageService.Repository.Resolve(Id, file)) is not { } product)
        {
            Snackbar.Add(L["{0} could not be read as an MSI file.", file], Severity.Error);
            return;
        }
        if (productCode)
        {
            _detection.MsiProductCode = product.ProductCode;
        }
        else
        {
            _detection.SoftwareInstalled = product.Name is null ? null : SoftwareMatcher.BaseName(product.Name);
            _detection.SoftwareMinVersion = product.Version;
        }
        Snackbar.Add(L["Filled in – check the values and save."], Severity.Info);
    }

    private async Task EditStepAsync(PackageStep? step, StepType type, bool nested)
    {
        if (!await Access.DemandAdminAsync())
            return;
        var parameters = new DialogParameters<EditStepDialog>
        {
            { d => d.PackageId, Id },
            { d => d.Step, step },
            { d => d.Type, type },
            { d => d.Nested, nested },
            { d => d.Files, _files.Select(f => f.RelativePath).ToList() },
        };
        var title = step is null ? L["New step: {0}", nested ? L["Run package"] : Display.Step(type)] : step.Definition.Name;
        var dialog = await Dialogs.ShowAsync<EditStepDialog>(title, parameters, new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Medium });
        if (await dialog.Result is { Canceled: false })
            await ReloadAsync();
    }

    private async Task MoveAsync(PackageStep step, int direction)
    {
        if (!await Access.DemandAdminAsync())
            return;
        await PackageService.MoveStepAsync(Id, step.Id, direction);
        await Audit.LogAsync(L["Package step moved"], $"{_package!.Name}: {step.Definition.Name}");
        await ReloadAsync();
    }

    private async Task DeleteStepAsync(PackageStep step)
    {
        if (!await Access.DemandAdminAsync())
            return;
        await PackageService.DeleteStepAsync(Id, step.Id);
        await Audit.LogAsync(L["Package step deleted"], $"{_package!.Name}: {step.Definition.Name}");
        await ReloadAsync();
    }

    private async Task UploadAsync(InputFileChangeEventArgs e)
    {
        if (!await Access.DemandAdminAsync())
            return;
        _uploading = true;
        try
        {
            var files = e.GetMultipleFiles(maximumFileCount: 200);
            foreach (var (file, index) in files.Select((f, i) => (f, i)))
            {
                _uploadText = L["Uploading {0} of {1} …", index + 1, files.Count];
                StateHasChanged();
                if (file.Size > MaxUploadBytes)
                {
                    Snackbar.Add(L["{0} is too large for the browser upload – please place it directly in the repository folder.", file.Name], Severity.Error);
                    continue;
                }
                await using var stream = file.OpenReadStream(MaxUploadBytes);
                await PackageService.RevokeApprovalAsync(Id);
                await PackageService.Repository.SaveAsync(Id, Path.GetFileName(file.Name), stream);
                await Audit.LogAsync(L["Package file uploaded"], $"{_package!.Name}: {file.Name} ({Display.FileSize(file.Size)})");
            }
        }
        catch (Exception ex) when (ex is IOException or ArgumentException)
        {
            Snackbar.Add(L["Upload failed: {0}", ex.Message], Severity.Error);
        }
        finally
        {
            _uploading = false;
            await ReloadAsync();
        }
    }

    private async Task DeleteFile(Inventory.Data.RepositoryFile file)
    {
        if (!await Access.DemandAdminAsync())
            return;
        await PackageService.RevokeApprovalAsync(Id);
        PackageService.Repository.Delete(Id, file.RelativePath);
        _ = Audit.LogAsync(L["Package file deleted"], $"{_package!.Name}: {file.RelativePath}");
        await ReloadAsync();
    }

    private async Task DeployAsync()
    {
        var parameters = new DialogParameters<DeployDialog> { { d => d.PackageId, Id } };
        await Dialogs.ShowAsync<DeployDialog>(L["Deploy \"{0}\"", _package!.Name], parameters, new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
    }
}
