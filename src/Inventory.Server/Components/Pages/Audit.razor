@page "/audit"
@inject AuditService AuditService
@inject Display Display
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Audit log"] – Inventory</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h5">@L["Audit log"]</MudText>
    <MudSpacer />
    <MudTextField @bind-Value="_search" Placeholder="@L["Search"]" Adornment="Adornment.Start" Immediate="true"
                  AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 280px" />
</MudStack>

<AutoRefresh OnTick="RefreshAsync" />

<MudDataGrid T="AuditEntry" Items="_entries" Dense="true" Hover="true" SortMode="SortMode.None" RowsPerPage="50"
             QuickFilter="@(e => string.IsNullOrWhiteSpace(_search) || $"{e.User} {e.Action} {e.Details}".Contains(_search, StringComparison.OrdinalIgnoreCase))">
    <Columns>
        <TemplateColumn Title="@L["Time"]" CellStyle="white-space: nowrap">
            <CellTemplate>@Display.LocalTime(context.Item.TimeUtc)</CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="e => e.User" Title="@L["User"]" />
        <PropertyColumn Property="e => e.Action" Title="@L["Action"]" />
        <PropertyColumn Property="e => e.Details" Title="Details" CellStyle="word-break: break-word" />
    </Columns>
    <NoRecordsContent>
        <MudText Class="pa-4">@L["No entries yet. Commands, deployments, scans and changes to credentials, packages, schedules and settings are logged."]</MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudDataGridPager T="AuditEntry" PageSizeOptions="@(new[] { 50, 100, 500 })" RowsPerPageString="@L["Rows per page"]" />
    </PagerContent>
</MudDataGrid>

@code {
    private List<AuditEntry> _entries = [];
    private string _search = "";

    private long _latest;

    protected override async Task OnInitializedAsync()
    {
        _latest = await AuditService.LatestIdAsync();
        _entries = await AuditService.ListAsync();
    }

    private async Task RefreshAsync()
    {
        var latest = await AuditService.LatestIdAsync();
        if (latest == _latest)
            return;
        _latest = latest;
        _entries = await AuditService.ListAsync();
    }
}
