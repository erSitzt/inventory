@page "/computers/{Id:int}"
@inject ComputerService ComputerService
@inject PackageService PackageService
@inject CredentialService CredentialService
@inject IDialogService Dialogs
@inject ScanService ScanService
@inject WakeService WakeService
@inject InventoryStore Store
@inject ISnackbar Snackbar
@inject Auditor Audit
@inject IStringLocalizer<SharedResource> L
@inject Display Display
@inject Access Access

<PageTitle>@(_computer?.Name ?? L["Computer"]) – Inventory</PageTitle>

@if (_computer is null)
{
    @if (_loaded)
    {
        <MudAlert Severity="Severity.Warning">@L["This computer does not exist (anymore)."] <MudLink Href="computers">@L["Back to the list"]</MudLink></MudAlert>
    }
    return;
}

<AutoRefresh OnTick="RefreshAsync" />

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="computers" aria-label="@L["Back to the list"]" />
    <MudText Typo="Typo.h5">@_computer.Name</MudText>
    <MudChip T="string" Size="Size.Small" Color="@(_computer.IsOnline ? Color.Success : _computer.NameMismatch ? Color.Warning : Color.Default)">@(_computer.IsOnline ? L["online"] : _computer.NameMismatch ? L["unreachable"] : L["offline"])</MudChip>
    <MudSpacer />
    <OperatorOnly>
        <RemoteAccessMenu Computer="_computer" />
    </OperatorOnly>
    <AdminOnly>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit" OnClick="EditAsync">@L["Edit"]</MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Terminal" Href="@($"run?ids={Id}")">@L["Run command"]</MudButton>
    </AdminOnly>
    <OperatorOnly>
        @if (!_computer.IsOnline)
        {
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PowerSettingsNew" OnClick="WakeAsync">@L["Wake"]</MudButton>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ManageSearch" Disabled="_scanning" OnClick="ScanAsync">
            @(_scanning ? L["Scanning …"] : L["Scan now"])
        </MudButton>
    </OperatorOnly>
</MudStack>

@if (_computer.NameMismatch)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        @L["Under the name {0} the computer {1} responds (address {2}). Probably a stale DNS entry or an alias (CNAME) points to this computer; existing inventory data belongs to {1}. Commands and deployments are not executed on this entry while the names differ. Scans still run – but they capture {1}, not {0}.", _computer.Name, _computer.ReportedName, _computer.IpAddress]
        <div class="mt-2">
            <AdminOnly>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="RenameAsync">@L["Rename entry to {0}", _computer.ReportedName]</MudButton>
            </AdminOnly>
        </div>
    </MudAlert>
}
else if (_computer.ReverseDnsMismatch)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">
        @L["According to reverse DNS the address {0} belongs to {1}, listed is {2}. The computer has not reported its own name yet; a scan shows who really responds.", _computer.IpAddress, _computer.ReverseDnsName, _computer.Name]
    </MudAlert>
}
@if (_computer.MissingInDirectory)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        @(_computer.DirectoryDisabled ? L["The computer account is disabled in Active Directory"] : L["The computer account was no longer found in Active Directory"])
        (@L["since {0}", Display.LocalTime(_computer.DirectoryMissingSinceUtc)]@(_computer.DirectorySeenUtc is null ? "" : ", " + L["last present {0}", Display.LocalTime(_computer.DirectorySeenUtc)])).
        @L["What happens to such computers is set under \"Active Directory\" in the settings."]
    </MudAlert>
}
@if (_computer.LastScanError is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@L["Last scan failed: {0}", _computer.LastScanError]</MudAlert>
}
@if (_computer.LastScanUtc is null)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">@L["This computer has not been scanned yet."]</MudAlert>
}

<MudTabs Outlined="true" Border="true" TabPanelsClass="pt-4" ApplyEffectsToContainer="true">
    <MudTabPanel Text="@L["Overview"]">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudSimpleTable Dense="true" Outlined="true" Elevation="0">
                    <tbody>
                        @Row(L["Reported name"], _computer.ReportedName)
                        @if (_computer.DnsName is not null)
                        {
                            @Row(L["DNS name"], _computer.DnsName)
                        }
                        @Row(L["Operating system"], Display.Os(_computer))
                        @Row(L["Version"], $"{_computer.OsVersion} {_computer.OsArchitecture}".Trim())
                        @Row(L["Installed on"], Display.LocalTime(_computer.OsInstalledUtc))
                        @Row(L["Last boot"], Display.LocalTime(_computer.LastBootUtc))
                        @Row(L["Logged-on user"], _computer.LoggedOnUser)
                        @Row(L["Primary user"], _computer.PrimaryUser)
                        @Row(L["Domain"], _computer.Domain)
                        @Row(L["IP address"], _computer.IpAddress)
                        @Row(L["Reverse DNS"], _computer.ReverseDnsName)
                        @Row(L["Last scan"], Display.LocalTime(_computer.LastScanUtc))
                        @Row(L["Last seen"], Display.LocalTime(_computer.LastSeenUtc))
                    </tbody>
                </MudSimpleTable>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSimpleTable Dense="true" Outlined="true" Elevation="0">
                    <tbody>
                        @Row(L["Manufacturer"], _computer.Manufacturer)
                        @Row(L["Model"], _computer.Model)
                        @Row(L["Serial number"], _computer.SerialNumber)
                        @Row("BIOS", _computer.BiosVersion)
                        @Row(L["Processor"], _computer.CpuName)
                        @Row(L["Cores / threads"], _computer.CpuCores is null ? null : $"{_computer.CpuCores} / {_computer.CpuLogicalProcessors}")
                        @Row(L["Memory"], Display.Bytes(_computer.MemoryBytes))
                        @Row(L["Collections"], string.Join(", ", _computer.Collections.Select(c => c.Name)))
                        @Row(L["Agent"], _computer.AgentKeyHash is null ? L["not installed"] : L["Version {0}, last contact {1}", _computer.AgentVersion, Display.LocalTime(_computer.AgentLastSeenUtc)])
                        @Row(L["Description"], _computer.Description)
                        @Row(L["Owner"], _computer.Owner)
                        @Row(L["Location"], _computer.Location)
                        @Row(L["Cost center"], _computer.CostCenter)
                        @Row(L["Inventory number"], _computer.InventoryNumber)
                        @Row(L["Purchase date"], _computer.PurchaseDate?.ToString("d"))
                        @Row(L["Warranty until"], _computer.WarrantyUntil is null ? null : $"{_computer.WarrantyUntil:d}{(_computer.WarrantyDaysLeft(DateOnly.FromDateTime(DateTime.Now)) < 0 ? " – " + L["expired"] : "")}")
                        @Row(L["Tags"], _computer.Tags)
                        @Row(L["Notes"], _computer.Notes)
                        @if (_computer.DirectorySeenUtc is not null)
                        {
                            @Row(L["AD organizational unit"], _computer.DirectoryOu)
                            @Row(L["AD groups"], string.Join(", ", _computer.DirectoryGroupNames))
                            @Row(L["AD description"], _computer.DirectoryDescription)
                            @Row(L["Last AD logon"], _computer.DirectoryLastLogonUtc is null ? null : Display.LocalTime(_computer.DirectoryLastLogonUtc))
                        }
                    </tbody>
                </MudSimpleTable>
            </MudItem>
        </MudGrid>
    </MudTabPanel>

    <MudTabPanel Text="@L["Hardware"]">
        @if (_computer.HardwareScanUtc is null)
        {
            <MudText Color="Color.Secondary">@L["Not captured yet. Hardware details are read with the next scan; computers with an agent need the current agent version first."]</MudText>
        }
        else
        {
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudSimpleTable Dense="true" Outlined="true" Elevation="0">
                        <tbody>
                            @Row(L["Device type"], Display.Chassis(_computer))
                            @Row(L["Firmware"], _computer.FirmwareType)
                            @Row(L["BIOS date"], _computer.BiosDateUtc?.ToString("d"))
                            @Row(L["Graphics"], _computer.Gpu)
                            @Row(L["Memory slots"], _computer.MemorySlots is null ? null : L["{0} of {1} used", _computer.MemoryModules.Count, _computer.MemorySlots])
                            @Row(L["Battery"], _computer.BatteryPresent switch
                            {
                                null => null,
                                false => L["none"],
                                true when _computer.BatteryHealthPercent is null => L["present"],
                                true when _computer.BatteryCycleCount is null => L["{0} % of the original capacity", _computer.BatteryHealthPercent],
                                true => L["{0} % of the original capacity, {1} charge cycles", _computer.BatteryHealthPercent, _computer.BatteryCycleCount],
                            })
                        </tbody>
                    </MudSimpleTable>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-4" Outlined="true">
                        <MudText Typo="Typo.h6" Class="mb-2">@L["Platform security"]</MudText>
                        @StatusRow("Secure Boot", _computer.SecureBoot)
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
                            <MudText Typo="Typo.body2" Style="flex: 1">TPM</MudText>
                            <MudChip T="string" Size="Size.Small" Color="@(_computer.TpmPresent is null ? Color.Default : _computer.TpmReady == true ? Color.Success : Color.Warning)">
                                @(_computer.TpmPresent switch
                                {
                                    null => L["unknown"],
                                    false => L["none"],
                                    true => $"{_computer.TpmVersion} – {(_computer.TpmReady == true ? L["ready"] : L["not ready"])}".TrimStart(' ', '–'),
                                })
                            </MudChip>
                        </MudStack>
                        @foreach (var volume in _computer.Volumes)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
                                <MudText Typo="Typo.body2" Style="flex: 1">
                                    BitLocker @volume.Drive@(volume.Method is null ? "" : $" ({volume.Method})")@(volume.EncryptedPercent is > 0 and < 100 ? ", " + L["{0} % encrypted", volume.EncryptedPercent] : "")
                                </MudText>
                                <MudChip T="string" Size="Size.Small" Color="@Display.OnOffColor(volume.Protected)">@Display.OnOff(volume.Protected)</MudChip>
                            </MudStack>
                        }
                        @if (_computer.Volumes.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["BitLocker: no volume reported."]</MudText>
                        }
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">@L["Memory modules"]</MudText>
                    <MudDataGrid T="ComputerMemoryModule" Items="_computer.MemoryModules" Dense="true" Hover="true" SortMode="SortMode.None">
                        <Columns>
                            <PropertyColumn Property="m => m.Slot" Title="@L["Slot"]" />
                            <TemplateColumn Title="@L["Size"]"><CellTemplate>@Display.Bytes(context.Item.CapacityBytes)</CellTemplate></TemplateColumn>
                            <TemplateColumn Title="@L["Type"]"><CellTemplate>@context.Item.Type@(context.Item.SpeedMhz is null ? "" : $" {context.Item.SpeedMhz} MHz")</CellTemplate></TemplateColumn>
                            <PropertyColumn Property="m => m.Manufacturer" Title="@L["Manufacturer"]" />
                            <PropertyColumn Property="m => m.PartNumber" Title="@L["Part number"]" />
                            <PropertyColumn Property="m => m.SerialNumber" Title="@L["Serial number"]" />
                        </Columns>
                    </MudDataGrid>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">@L["Physical disks"]</MudText>
                    <MudDataGrid T="ComputerPhysicalDisk" Items="_computer.PhysicalDisks" Dense="true" Hover="true" SortMode="SortMode.None">
                        <Columns>
                            <PropertyColumn Property="d => d.Model" Title="@L["Model"]" />
                            <TemplateColumn Title="@L["Type"]"><CellTemplate>@string.Join(" ", new[] { context.Item.MediaType, context.Item.BusType }.Where(v => v is not null))</CellTemplate></TemplateColumn>
                            <TemplateColumn Title="@L["Size"]"><CellTemplate>@Display.Bytes(context.Item.SizeBytes)</CellTemplate></TemplateColumn>
                            <PropertyColumn Property="d => d.SerialNumber" Title="@L["Serial number"]" />
                            <TemplateColumn Title="@L["State"]">
                                <CellTemplate>
                                    @if (context.Item.Health is not null)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="@Display.HealthColor(context.Item.Health)">@L[context.Item.Health]</MudChip>
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                    </MudDataGrid>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">@L["Monitors"]</MudText>
                    <MudDataGrid T="ComputerMonitor" Items="_computer.Monitors" Dense="true" Hover="true" SortMode="SortMode.None">
                        <Columns>
                            <PropertyColumn Property="m => m.Manufacturer" Title="@L["Manufacturer"]" />
                            <PropertyColumn Property="m => m.Model" Title="@L["Model"]" />
                            <PropertyColumn Property="m => m.SerialNumber" Title="@L["Serial number"]" />
                            <PropertyColumn Property="m => m.Year" Title="@L["Year"]" />
                        </Columns>
                    </MudDataGrid>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">@L["Printers"]</MudText>
                    <MudDataGrid T="ComputerPrinter" Items="_computer.Printers" Dense="true" Hover="true" SortMode="SortMode.None">
                        <Columns>
                            <PropertyColumn Property="p => p.Name" Title="@L["Name"]" />
                            <PropertyColumn Property="p => p.Driver" Title="@L["Driver"]" />
                            <PropertyColumn Property="p => p.Port" Title="@L["Port"]" />
                            <TemplateColumn Title="@L["Shared"]"><CellTemplate>@Display.YesNo(context.Item.Shared)</CellTemplate></TemplateColumn>
                        </Columns>
                    </MudDataGrid>
                    <MudText Typo="Typo.caption">@L["Printers set up for the whole computer; connections of individual users are not visible to the scan."]</MudText>
                </MudItem>
            </MudGrid>
        }
    </MudTabPanel>

    <MudTabPanel Text="@($"{L["Software"]} ({_computer.Software.Count})")">
        <MudTextField @bind-Value="_softwareSearch" Placeholder="@L["Search software"]" Adornment="Adornment.Start" Immediate="true" Class="mb-2"
                      AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 320px" />
        <MudDataGrid T="ComputerSoftware" Items="_computer.Software" Dense="true" Hover="true" SortMode="SortMode.Single" RowsPerPage="50"
                     QuickFilter="@(s => string.IsNullOrWhiteSpace(_softwareSearch) || s.Name.Contains(_softwareSearch, StringComparison.OrdinalIgnoreCase) || (s.Publisher?.Contains(_softwareSearch, StringComparison.OrdinalIgnoreCase) ?? false))">
            <Columns>
                <PropertyColumn Property="s => s.Name" Title="@L["Name"]" />
                <PropertyColumn Property="s => s.Version" Title="@L["Version"]" />
                <PropertyColumn Property="s => s.Publisher" Title="@L["Publisher"]" />
                <PropertyColumn Property="s => s.InstallDate" Title="@L["Installed"]" />
                <TemplateColumn Title="@L["Type"]" Sortable="false">
                    <CellTemplate>@(context.Item.Is64Bit ? "64 Bit" : "32 Bit")@(context.Item.PerUser ? ", " + L["per user"] : "")@(context.Item.CarriedOver ? " – " + L["from an earlier scan, user not logged on"] : "")</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Sortable="false" CellStyle="width: 1%; white-space: nowrap">
                    <CellTemplate>
                        <AdminOnly>
                            <MudTooltip Text="@L["Uninstall …"]">
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteSweep" Size="Size.Small" aria-label="@L["Uninstall …"]" OnClick="@(() => UninstallAsync(context.Item))" />
                            </MudTooltip>
                        </AdminOnly>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="ComputerSoftware" PageSizeOptions="@(new[] { 50, 100, 500 })" RowsPerPageString="@L["Rows per page"]" />
            </PagerContent>
        </MudDataGrid>
    </MudTabPanel>

    <MudTabPanel Text="@($"{L["Apps"]} ({_computer.Apps.Count})")">
        <MudText Typo="Typo.body2" Class="mb-2">
            @L["App packages (MSIX/AppX, also from the Store) registered on the computer, without parts of Windows and runtime libraries. If the list is empty, the computer has no such apps or has not been scanned with a current runner yet."]
        </MudText>
        <MudDataGrid T="ComputerApp" Items="_computer.Apps" Dense="true" Hover="true" SortMode="SortMode.Single" RowsPerPage="50">
            <Columns>
                <TemplateColumn Title="@L["Name"]" SortBy="@(a => a.DisplayName ?? a.Name)">
                    <CellTemplate>@(context.Item.DisplayName ?? context.Item.Name)</CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="a => a.Name" Title="@L["Package name"]" />
                <PropertyColumn Property="a => a.Version" Title="@L["Version"]" />
                <PropertyColumn Property="a => a.Publisher" Title="@L["Publisher"]" />
                <TemplateColumn Title="@L["New users"]" SortBy="@(a => a.Provisioned)">
                    <CellTemplate>@(context.Item.Provisioned ? L["provisioned"] : "")</CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="ComputerApp" PageSizeOptions="@(new[] { 50, 100, 500 })" RowsPerPageString="@L["Rows per page"]" />
            </PagerContent>
        </MudDataGrid>
    </MudTabPanel>

    <MudTabPanel Text="@($"Hotfixes ({_computer.Hotfixes.Count})")">
        <MudDataGrid T="ComputerHotfix" Items="_computer.Hotfixes" Dense="true" Hover="true" SortMode="SortMode.Single">
            <Columns>
                <PropertyColumn Property="h => h.HotfixId" Title="KB" />
                <PropertyColumn Property="h => h.Description" Title="@L["Description"]" />
                <PropertyColumn Property="h => h.InstalledOn" Title="@L["Installed on"]" />
            </Columns>
        </MudDataGrid>
    </MudTabPanel>

    <MudTabPanel Text="@L["Disks"]">
        <MudDataGrid T="ComputerDisk" Items="_computer.Disks" Dense="true" Hover="true" SortMode="SortMode.None">
            <Columns>
                <PropertyColumn Property="d => d.Drive" Title="@L["Drive"]" />
                <PropertyColumn Property="d => d.Label" Title="@L["Label"]" />
                <PropertyColumn Property="d => d.FileSystem" Title="@L["File system"]" />
                <TemplateColumn Title="@L["Size"]"><CellTemplate>@Display.Bytes(context.Item.SizeBytes)</CellTemplate></TemplateColumn>
                <TemplateColumn Title="@L["Free"]">
                    <CellTemplate>
                        @Display.Bytes(context.Item.FreeBytes)
                        @if (context.Item.SizeBytes > 0)
                        {
                            <span> (@((100d * context.Item.FreeBytes / context.Item.SizeBytes).ToString("N0")) %)</span>
                        }
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    </MudTabPanel>

    <MudTabPanel Text="@L["Network"]">
        <MudDataGrid T="ComputerNetworkAdapter" Items="_computer.NetworkAdapters" Dense="true" Hover="true" SortMode="SortMode.None">
            <Columns>
                <PropertyColumn Property="n => n.Name" Title="@L["Adapter"]" />
                <PropertyColumn Property="n => n.MacAddress" Title="@L["MAC address"]" />
                <PropertyColumn Property="n => n.IpAddresses" Title="@L["IP addresses"]" />
                <PropertyColumn Property="n => n.Gateways" Title="Gateway" />
                <PropertyColumn Property="n => n.DnsServers" Title="@L["DNS servers"]" />
                <TemplateColumn Title="DHCP"><CellTemplate>@Display.YesNo(context.Item.DhcpEnabled)</CellTemplate></TemplateColumn>
            </Columns>
        </MudDataGrid>
    </MudTabPanel>

    <MudTabPanel Text="@($"{L["Services"]} ({_computer.Services.Count})")">
        <MudDataGrid T="ComputerWindowsService" Items="_computer.Services" Dense="true" Hover="true" SortMode="SortMode.Single" RowsPerPage="50">
            <Columns>
                <PropertyColumn Property="s => s.Name" Title="@L["Name"]" />
                <PropertyColumn Property="s => s.DisplayName" Title="@L["Display name"]" />
                <PropertyColumn Property="s => s.State" Title="@L["State"]" />
                <PropertyColumn Property="s => s.StartMode" Title="@L["Start type"]" />
                <PropertyColumn Property="s => s.Account" Title="@L["Account"]" />
            </Columns>
            <PagerContent>
                <MudDataGridPager T="ComputerWindowsService" PageSizeOptions="@(new[] { 50, 100, 500 })" RowsPerPageString="@L["Rows per page"]" />
            </PagerContent>
        </MudDataGrid>
    </MudTabPanel>

    <MudTabPanel Text="@L["Security"]">
        @if (_computer.FirewallDomain is null && _computer.DefenderEnabled is null && _computer.UpdateRebootRequired is null)
        {
            <MudText Color="Color.Secondary">@L["Not captured yet. Firewall, antivirus and Windows Update are read with the next scan."]</MudText>
        }
        else
        {
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-4" Outlined="true">
                        <MudText Typo="Typo.h6" Class="mb-2">@L["Windows Firewall"]</MudText>
                        @StatusRow(L["Domain network"], _computer.FirewallDomain)
                        @StatusRow(L["Private network"], _computer.FirewallPrivate)
                        @StatusRow(L["Public network"], _computer.FirewallPublic)
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-4" Outlined="true">
                        <MudText Typo="Typo.h6" Class="mb-2">@L["Antivirus"]</MudText>
                        @StatusRow("Microsoft Defender", _computer.DefenderEnabled)
                        @StatusRow(L["Real-time protection"], _computer.DefenderRealTime)
                        @StatusRow(L["Tamper protection"], _computer.DefenderTamperProtected)
                        @if (_computer.DefenderMode is not null)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
                                <MudText Typo="Typo.body2" Style="flex: 1">@L["Mode"]</MudText>
                                <MudChip T="string" Size="Size.Small" Color="@(_computer.DefenderMode == "Normal" ? Color.Success : Color.Warning)">@Display.DefenderMode(_computer.DefenderMode)</MudChip>
                            </MudStack>
                        }
                        <MudText Typo="Typo.body2" Class="mt-2">@L["Signature: {0} from {1}", _computer.DefenderSignatureVersion ?? "–", Display.LocalTime(_computer.DefenderSignatureUpdatedUtc)]</MudText>
                        <MudText Typo="Typo.body2">@L["Last quick scan: {0}", Display.LocalTime(_computer.DefenderLastQuickScanUtc)]</MudText>
                        <MudText Typo="Typo.body2">@L["Active: {0}", string.IsNullOrEmpty(_computer.AntivirusProducts) ? "–" : _computer.AntivirusProducts]</MudText>
                        @if (!string.IsNullOrEmpty(_computer.AntivirusProductsInactive))
                        {
                            <MudText Typo="Typo.body2">@L["Registered but off: {0}", _computer.AntivirusProductsInactive]</MudText>
                        }
                        @if (_computer.AntivirusDefinitionsOutdated == true)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">@L["Virus definitions are out of date."]</MudAlert>
                        }
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-4" Outlined="true">
                        <MudText Typo="Typo.h6" Class="mb-2">Windows Update</MudText>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
                            <MudText Typo="Typo.body2" Style="flex: 1">@L["Reboot pending"]</MudText>
                            <MudChip T="string" Size="Size.Small" Color="@(_computer.UpdateRebootRequired == true ? Color.Warning : Color.Success)">@(_computer.UpdateRebootRequired switch { true => L["yes"], false => L["no"], null => L["unknown"] })</MudChip>
                        </MudStack>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
                            <MudText Typo="Typo.body2" Style="flex: 1">@L["Pending updates"]</MudText>
                            <MudChip T="string" Size="Size.Small" Color="@(_computer.UpdatePendingCount > 0 ? Color.Warning : _computer.UpdatePendingCount == 0 ? Color.Success : Color.Default)">@(_computer.UpdatePendingCount?.ToString() ?? L["unknown"])</MudChip>
                        </MudStack>
                        <MudText Typo="Typo.body2" Class="mt-2">@L["Last installation: {0}", Display.LocalTime(_computer.UpdateLastInstallUtc)]</MudText>
                        <MudText Typo="Typo.body2">@L["Last search: {0}", Display.LocalTime(_computer.UpdateLastSearchUtc)]</MudText>
                        <MudText Typo="Typo.body2">@L["Source: {0}", string.IsNullOrEmpty(_computer.UpdateServer) ? "Microsoft Update" : _computer.UpdateServer]</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-4" Outlined="true">
                        <MudText Typo="Typo.h6" Class="mb-2">@L["System configuration"]</MudText>
                        @if (!_computer.PostureKnown)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Not captured yet."]</MudText>
                        }
                        else
                        {
                            @RiskRow(L["Remote Desktop"], _computer.RdpEnabled, riskWhen: null)
                            @if (_computer.RdpEnabled == true)
                            {
                                @RiskRow(L["Network level authentication"], _computer.RdpNla, riskWhen: false)
                            }
                            @RiskRow(L["User Account Control"], _computer.UacEnabled, riskWhen: false)
                            @RiskRow("SMB 1", _computer.Smb1Enabled, riskWhen: true)
                            @RiskRow("Credential Guard", _computer.CredentialGuard, riskWhen: null)
                            @RiskRow(L["Memory integrity"], _computer.MemoryIntegrity, riskWhen: null)
                            @RiskRow(L["LSA protection"], _computer.LsaProtection, riskWhen: null)
                            @RiskRow(L["Built-in administrator account"], _computer.BuiltinAdminEnabled, riskWhen: null)
                            @RiskRow(L["Windows activated"], _computer.WindowsActivated, riskWhen: false)
                            @if (_computer.UacEnabled == true)
                            {
                                <MudText Typo="Typo.body2" Class="mt-2">@L["User Account Control level: {0}", Display.UacLevel(_computer.UacLevel)]</MudText>
                            }
                            @if (_computer.BuiltinAdminEnabled == true && _computer.BuiltinAdminPasswordAgeDays is { } age)
                            {
                                <MudText Typo="Typo.body2">@L["Built-in administrator: password is {0} days old", age]</MudText>
                            }
                        }
                    </MudPaper>
                </MudItem>
                @if (_computer.UpdatePendingCount > 0)
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle1" Class="mb-1">@L["Pending updates"]</MudText>
                        <MudText Typo="Typo.caption">@L["As of the computer's last search ({0}); the scan does not trigger a new search.", Display.LocalTime(_computer.UpdateLastSearchUtc)]</MudText>
                        @if (_computer.PendingUpdates.Count > 0)
                        {
                            <MudDataGrid T="ComputerPendingUpdate" Items="@_computer.PendingUpdates.OrderByDescending(u => u.IsSecurity).ThenBy(u => u.Title)" Dense="true" Hover="true" SortMode="SortMode.None" Class="mt-2">
                                <Columns>
                                    <TemplateColumn Title="KB" CellStyle="white-space: nowrap">
                                        <CellTemplate><MudLink Href="@($"updates?q={Uri.EscapeDataString(context.Item.Key)}")">@(context.Item.KbIds ?? "–")</MudLink></CellTemplate>
                                    </TemplateColumn>
                                    <PropertyColumn Property="u => u.Title" Title="@L["Update title"]" />
                                    <TemplateColumn Title="@L["Classification"]">
                                        <CellTemplate>@(context.Item.Classification is null ? "" : L[context.Item.Classification])</CellTemplate>
                                    </TemplateColumn>
                                    <TemplateColumn Title="@L["Severity"]">
                                        <CellTemplate>
                                            @if (context.Item.Severity is not null)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="@Display.SeverityColor(context.Item.Severity)">@L[context.Item.Severity]</MudChip>
                                            }
                                            else if (context.Item.IsSecurity)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Warning">@L["Security"]</MudChip>
                                            }
                                        </CellTemplate>
                                    </TemplateColumn>
                                    <TemplateColumn Title="@L["Downloaded"]"><CellTemplate>@Display.YesNo(context.Item.IsDownloaded)</CellTemplate></TemplateColumn>
                                    <TemplateColumn Title="@L["Size"]"><CellTemplate>@(context.Item.SizeBytes > 0 ? Display.Bytes(context.Item.SizeBytes) : "")</CellTemplate></TemplateColumn>
                                </Columns>
                            </MudDataGrid>
                        }
                        else
                        {
                            @* Stand aus einem Scan vor der Erfassung der Einzelheiten: nur die Titel sind bekannt. *@
                            <MudList T="string" Dense="true" ReadOnly="true">
                                @foreach (var title in (_computer.UpdatePending ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <MudListItem T="string" Icon="@Icons.Material.Filled.SystemUpdateAlt">@title</MudListItem>
                                }
                            </MudList>
                        }
                    </MudItem>
                }
            </MudGrid>
        }
    </MudTabPanel>

    <MudTabPanel Text="@($"{L["Users"]} ({_computer.LocalUsers.Count})")">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.subtitle1" Class="mb-2">@L["Local administrators"]</MudText>
                <MudDataGrid T="ComputerLocalAdmin" Items="_computer.LocalAdmins" Dense="true" Hover="true" SortMode="SortMode.None">
                    <Columns>
                        <PropertyColumn Property="a => a.Name" Title="@L["Member"]" />
                        <TemplateColumn Title="@L["Type"]"><CellTemplate>@(context.Item.IsGroup ? L["Group"] : L["User"])</CellTemplate></TemplateColumn>
                    </Columns>
                </MudDataGrid>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.subtitle1" Class="mb-2">@L["Local user accounts"]</MudText>
                <MudDataGrid T="ComputerLocalUser" Items="_computer.LocalUsers" Dense="true" Hover="true" SortMode="SortMode.None">
                    <Columns>
                        <PropertyColumn Property="u => u.Name" Title="@L["Name"]" />
                        <TemplateColumn Title="@L["State"]">
                            <CellTemplate>
                                <MudChip T="string" Size="Size.Small" Color="@(context.Item.Disabled ? Color.Default : Color.Success)">@(context.Item.Disabled ? L["disabled"] : L["active"])</MudChip>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="@L["Description"]"><CellTemplate>@(context.Item.FullName ?? context.Item.Description)</CellTemplate></TemplateColumn>
                        <TemplateColumn Title="@L["Last logon"]"><CellTemplate>@(context.Item.LastLogonUtc is null ? "–" : Display.LocalTime(context.Item.LastLogonUtc))</CellTemplate></TemplateColumn>
                        <TemplateColumn Title="@L["Password age (days)"]"><CellTemplate>@context.Item.PasswordAgeDays</CellTemplate></TemplateColumn>
                    </Columns>
                </MudDataGrid>
            </MudItem>
        </MudGrid>
    </MudTabPanel>

    <MudTabPanel Text="@($"{L["Profiles"]} ({_computer.UserProfiles.Count})")">
        <MudText Typo="Typo.body2" Class="mb-2">
            @L["Primary user: {0}.", _computer.PrimaryUser ?? "–"]
            @L["That is who had an interactive session (console or Remote Desktop) on the most days during scans of the last {0} days. Accounts stored as credentials never count; services and scheduled tasks do not either.", InventoryStore.PrimaryUserDays]
        </MudText>
        <MudDataGrid T="ComputerUserProfile" Items="@_computer.UserProfiles.OrderByDescending(p => p.LastUseUtc)" Dense="true" Hover="true" SortMode="SortMode.None">
            <Columns>
                <PropertyColumn Property="p => p.UserName" Title="@L["User"]" />
                <TemplateColumn Title="@L["Last used"]"><CellTemplate>@(context.Item.LastUseUtc is null ? "–" : Display.LocalTime(context.Item.LastUseUtc))</CellTemplate></TemplateColumn>
                <TemplateColumn Title="@L["Profile loaded during the scan"]"><CellTemplate>@(context.Item.Loaded ? L["yes"] : "")</CellTemplate></TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <MudText Class="pa-4">@L["Not captured yet. Profiles are read with the next scan."]</MudText>
            </NoRecordsContent>
        </MudDataGrid>
    </MudTabPanel>

    <MudTabPanel Text="@($"{L["History"]} ({_changes.Count})")">
        @if (_changes.Count == 0)
        {
            <MudText Color="Color.Secondary">@L["No changes yet. The first scan is the baseline; from the second on, what changed is recorded."]</MudText>
        }
        else
        {
            <ChangeGrid Changes="_changes" ShowComputer="false" />
        }
    </MudTabPanel>
</MudTabs>

@code {
    /// <summary>Legt bei Bedarf das Deinstallations-Paket für dieses Programm an und öffnet den Deploy-Dialog für diesen Rechner.</summary>
    private async Task UninstallAsync(ComputerSoftware software)
    {
        if (!await Access.DemandAdminAsync())
            return;
        var (package, created) = await PackageService.EnsureUninstallPackageAsync(software.Name, software.Name, null, approvedBy: await Audit.UserNameAsync());
        if (created)
            await Audit.LogAsync(L["Package created"], package.Name);
        var parameters = new DialogParameters<DeployDialog> { { d => d.PackageId, package.Id }, { d => d.ComputerIds, new List<int> { _computer!.Id } } };
        await Dialogs.ShowAsync<DeployDialog>(L["Deploy \"{0}\"", package.Name], parameters, new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
    }

    [Parameter] public int Id { get; set; }

    private async Task EditAsync()
    {
        if (!await Access.DemandAdminAsync())
            return;
        var parameters = new DialogParameters<EditComputerDialog> { { d => d.Computer, _computer! }, { d => d.Credentials, await CredentialService.ListAsync() } };
        var dialog = await Dialogs.ShowAsync<EditComputerDialog>(_computer!.Name, parameters, new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
        if (await dialog.Result is { Canceled: false })
            _computer = await ComputerService.GetDetailAsync(Id);
    }

    private Computer? _computer;
    private bool _loaded;
    private bool _scanning;
    private string _softwareSearch = "";
    private List<(InventoryChange Change, string Computer)> _changes = [];

    private DateTime? _shownScanUtc;

    protected override async Task OnParametersSetAsync()
    {
        _computer = await ComputerService.GetDetailAsync(Id);
        _changes = await Store.ChangesAsync(Id);
        _shownScanUtc = _computer?.LastScanUtc;
        _loaded = true;
    }

    /// <summary>Lädt neu, wenn inzwischen ein Scan gelaufen ist (Zeitplan, Deployment, anderer Benutzer).</summary>
    private async Task RefreshAsync()
    {
        if (_scanning || _computer is null || await ComputerService.GetAsync(Id) is not { } current || current.LastScanUtc == _shownScanUtc)
            return;
        _computer = await ComputerService.GetDetailAsync(Id);
        _changes = await Store.ChangesAsync(Id);
        _shownScanUtc = _computer?.LastScanUtc;
    }

    private async Task WakeAsync()
    {
        if (!await Access.DemandOperatorAsync())
            return;
        var result = await WakeService.WakeAsync(Id);
        if (result is null)
            return;
        if (result.Macs.Count == 0)
            Snackbar.Add(L["No MAC address is known for this computer: scan it once or enter one under Edit."], Severity.Warning);
        else if (!result.Sent)
            Snackbar.Add(L["The wake-up could not be sent: the server has no way into the network and no agent in the computer's subnet is online."], Severity.Error);
        else
        {
            await Audit.LogAsync(L["Wake-up sent"], _computer!.Name);
            var via = result.Relays.Count > 0 ? " " + L["Also sent through the agent on {0}.", string.Join(", ", result.Relays)] : "";
            Snackbar.Add(L["Wake-up sent to {0}. Whether the computer starts shows after about two minutes under \"Check reachability\".", string.Join(", ", result.Macs)] + via, Severity.Info);
        }
    }

    private async Task ScanAsync()
    {
        if (!await Access.DemandOperatorAsync())
            return;
        _scanning = true;
        try
        {
            await Audit.LogAsync(L["Inventory scan started"], _computer!.Name);
            var outcome = await ScanService.ScanAsync(Id);
            Snackbar.Add(outcome.Success ? L["Scan completed."] : L["Scan failed: {0}", outcome.Error], outcome.Success ? Severity.Success : Severity.Error);
            _computer = await ComputerService.GetDetailAsync(Id);
            _changes = await Store.ChangesAsync(Id);
        }
        finally
        {
            _scanning = false;
        }
    }

    private async Task RenameAsync()
    {
        if (!await Access.DemandAdminAsync())
            return;
        try
        {
            var old = _computer!.Name;
            var name = await ComputerService.RenameToReportedAsync(Id);
            await Audit.LogAsync(L["Computer renamed"], $"{old} → {name}");
            Snackbar.Add(L["Entry is now called {0}.", name], Severity.Success);
            _computer = await ComputerService.GetDetailAsync(Id);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private RenderFragment StatusRow(string label, bool? value) => @<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
        <MudText Typo="Typo.body2" Style="flex: 1">@label</MudText>
        <MudChip T="string" Size="Size.Small" Color="@Display.OnOffColor(value)">@Display.OnOff(value)</MudChip>
    </MudStack>;

    /// <param name="riskWhen">Der Wert, der als Auffälligkeit gilt; null = rein informativ.</param>
    private RenderFragment RiskRow(string label, bool? value, bool? riskWhen) => @<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
        <MudText Typo="Typo.body2" Style="flex: 1">@label</MudText>
        <MudChip T="string" Size="Size.Small" Color="@(value is null ? Color.Default : riskWhen is null ? Color.Info : value == riskWhen ? Color.Warning : Color.Success)">@Display.OnOff(value)</MudChip>
    </MudStack>;

    private static RenderFragment Row(string label, string? value) => @<tr>
        <td style="width: 40%; color: var(--mud-palette-text-secondary)">@label</td>
        <td>@(string.IsNullOrWhiteSpace(value) ? "–" : value)</td>
    </tr>;
}
