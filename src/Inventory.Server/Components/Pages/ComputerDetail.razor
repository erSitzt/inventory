@page "/computers/{Id:int}"
@inject ComputerService ComputerService
@inject ScanService ScanService
@inject InventoryStore Store
@inject ISnackbar Snackbar
@inject Auditor Audit

<PageTitle>@(_computer?.Name ?? "Rechner") – Inventory</PageTitle>

@if (_computer is null)
{
    @if (_loaded)
    {
        <MudAlert Severity="Severity.Warning">Dieser Rechner existiert nicht (mehr). <MudLink Href="computers">Zur Übersicht</MudLink></MudAlert>
    }
    return;
}

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="computers" aria-label="Zurück zur Übersicht" />
    <MudText Typo="Typo.h5">@_computer.Name</MudText>
    <MudChip T="string" Size="Size.Small" Color="@(_computer.IsOnline ? Color.Success : Color.Default)">@(_computer.IsOnline ? "online" : "offline")</MudChip>
    <MudSpacer />
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Terminal" Href="@($"run?ids={Id}")">Befehl ausführen</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ManageSearch" Disabled="_scanning" OnClick="ScanAsync">
        @(_scanning ? "Scan läuft …" : "Jetzt scannen")
    </MudButton>
</MudStack>

@if (_computer.NameMismatch)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        Unter dem Namen <b>@_computer.Name</b> antwortet der Rechner <b>@_computer.ReportedName</b> (Adresse @_computer.IpAddress).
        Vermutlich zeigt ein veralteter DNS-Eintrag oder ein Alias (CNAME) auf diesen Rechner; vorhandene Inventardaten gehören zu @_computer.ReportedName.
        Befehle und Deployments werden auf diesem Eintrag nicht ausgeführt, solange die Namen abweichen.
        <div class="mt-2">
            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="RenameAsync">Eintrag in @_computer.ReportedName umbenennen</MudButton>
        </div>
    </MudAlert>
}
else if (_computer.ReverseDnsMismatch)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">
        Die Adresse @_computer.IpAddress gehört laut Reverse-DNS zu <b>@_computer.ReverseDnsName</b>, eingetragen ist <b>@_computer.Name</b>.
        Der Rechner selbst hat seinen Namen noch nicht genannt; ein Scan zeigt, wer wirklich antwortet.
    </MudAlert>
}
@if (_computer.LastScanError is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">Letzter Scan fehlgeschlagen: @_computer.LastScanError</MudAlert>
}
@if (_computer.LastScanUtc is null)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">Dieser Rechner wurde noch nicht gescannt.</MudAlert>
}

<MudTabs Outlined="true" Border="true" TabPanelsClass="pt-4" ApplyEffectsToContainer="true">
    <MudTabPanel Text="Übersicht">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudSimpleTable Dense="true" Outlined="true" Elevation="0">
                    <tbody>
                        @Row("Gemeldeter Name", _computer.ReportedName)
                        @Row("Betriebssystem", Display.Os(_computer))
                        @Row("Version", $"{_computer.OsVersion} {_computer.OsArchitecture}".Trim())
                        @Row("Installiert am", Display.LocalTime(_computer.OsInstalledUtc))
                        @Row("Letzter Start", Display.LocalTime(_computer.LastBootUtc))
                        @Row("Angemeldeter Benutzer", _computer.LoggedOnUser)
                        @Row("Domäne", _computer.Domain)
                        @Row("IP-Adresse", _computer.IpAddress)
                        @Row("Reverse-DNS", _computer.ReverseDnsName)
                        @Row("Letzter Scan", Display.LocalTime(_computer.LastScanUtc))
                        @Row("Zuletzt gesehen", Display.LocalTime(_computer.LastSeenUtc))
                    </tbody>
                </MudSimpleTable>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSimpleTable Dense="true" Outlined="true" Elevation="0">
                    <tbody>
                        @Row("Hersteller", _computer.Manufacturer)
                        @Row("Modell", _computer.Model)
                        @Row("Seriennummer", _computer.SerialNumber)
                        @Row("BIOS", _computer.BiosVersion)
                        @Row("Prozessor", _computer.CpuName)
                        @Row("Kerne / Threads", _computer.CpuCores is null ? null : $"{_computer.CpuCores} / {_computer.CpuLogicalProcessors}")
                        @Row("Arbeitsspeicher", Display.Bytes(_computer.MemoryBytes))
                        @Row("Sammlungen", string.Join(", ", _computer.Collections.Select(c => c.Name)))
                        @Row("Agent", _computer.AgentKeyHash is null ? "nicht installiert" : $"Version {_computer.AgentVersion}, letzter Kontakt {Display.LocalTime(_computer.AgentLastSeenUtc)}")
                        @Row("Beschreibung", _computer.Description)
                    </tbody>
                </MudSimpleTable>
            </MudItem>
        </MudGrid>
    </MudTabPanel>

    <MudTabPanel Text="@($"Software ({_computer.Software.Count})")">
        <MudTextField @bind-Value="_softwareSearch" Placeholder="Software suchen" Adornment="Adornment.Start" Immediate="true" Class="mb-2"
                      AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 320px" />
        <MudDataGrid T="ComputerSoftware" Items="_computer.Software" Dense="true" Hover="true" SortMode="SortMode.Single" RowsPerPage="50"
                     QuickFilter="@(s => string.IsNullOrWhiteSpace(_softwareSearch) || s.Name.Contains(_softwareSearch, StringComparison.OrdinalIgnoreCase) || (s.Publisher?.Contains(_softwareSearch, StringComparison.OrdinalIgnoreCase) ?? false))">
            <Columns>
                <PropertyColumn Property="s => s.Name" Title="Name" />
                <PropertyColumn Property="s => s.Version" Title="Version" />
                <PropertyColumn Property="s => s.Publisher" Title="Hersteller" />
                <PropertyColumn Property="s => s.InstallDate" Title="Installiert" />
                <TemplateColumn Title="Art" Sortable="false">
                    <CellTemplate>@(context.Item.Is64Bit ? "64 Bit" : "32 Bit")@(context.Item.PerUser ? ", pro Benutzer" : "")</CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="ComputerSoftware" PageSizeOptions="@(new[] { 50, 100, 500 })" RowsPerPageString="Zeilen pro Seite" />
            </PagerContent>
        </MudDataGrid>
    </MudTabPanel>

    <MudTabPanel Text="@($"Hotfixes ({_computer.Hotfixes.Count})")">
        <MudDataGrid T="ComputerHotfix" Items="_computer.Hotfixes" Dense="true" Hover="true" SortMode="SortMode.Single">
            <Columns>
                <PropertyColumn Property="h => h.HotfixId" Title="KB" />
                <PropertyColumn Property="h => h.Description" Title="Beschreibung" />
                <PropertyColumn Property="h => h.InstalledOn" Title="Installiert am" />
            </Columns>
        </MudDataGrid>
    </MudTabPanel>

    <MudTabPanel Text="Datenträger">
        <MudDataGrid T="ComputerDisk" Items="_computer.Disks" Dense="true" Hover="true" SortMode="SortMode.None">
            <Columns>
                <PropertyColumn Property="d => d.Drive" Title="Laufwerk" />
                <PropertyColumn Property="d => d.Label" Title="Bezeichnung" />
                <PropertyColumn Property="d => d.FileSystem" Title="Dateisystem" />
                <TemplateColumn Title="Größe"><CellTemplate>@Display.Bytes(context.Item.SizeBytes)</CellTemplate></TemplateColumn>
                <TemplateColumn Title="Frei">
                    <CellTemplate>
                        @Display.Bytes(context.Item.FreeBytes)
                        @if (context.Item.SizeBytes > 0)
                        {
                            <span> (@((100d * context.Item.FreeBytes / context.Item.SizeBytes).ToString("N0")) %)</span>
                        }
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    </MudTabPanel>

    <MudTabPanel Text="Netzwerk">
        <MudDataGrid T="ComputerNetworkAdapter" Items="_computer.NetworkAdapters" Dense="true" Hover="true" SortMode="SortMode.None">
            <Columns>
                <PropertyColumn Property="n => n.Name" Title="Adapter" />
                <PropertyColumn Property="n => n.MacAddress" Title="MAC-Adresse" />
                <PropertyColumn Property="n => n.IpAddresses" Title="IP-Adressen" />
                <PropertyColumn Property="n => n.Gateways" Title="Gateway" />
                <PropertyColumn Property="n => n.DnsServers" Title="DNS-Server" />
                <TemplateColumn Title="DHCP"><CellTemplate>@(context.Item.DhcpEnabled ? "ja" : "nein")</CellTemplate></TemplateColumn>
            </Columns>
        </MudDataGrid>
    </MudTabPanel>

    <MudTabPanel Text="@($"Dienste ({_computer.Services.Count})")">
        <MudDataGrid T="ComputerWindowsService" Items="_computer.Services" Dense="true" Hover="true" SortMode="SortMode.Single" RowsPerPage="50">
            <Columns>
                <PropertyColumn Property="s => s.Name" Title="Name" />
                <PropertyColumn Property="s => s.DisplayName" Title="Anzeigename" />
                <PropertyColumn Property="s => s.State" Title="Status" />
                <PropertyColumn Property="s => s.StartMode" Title="Starttyp" />
                <PropertyColumn Property="s => s.Account" Title="Konto" />
            </Columns>
            <PagerContent>
                <MudDataGridPager T="ComputerWindowsService" PageSizeOptions="@(new[] { 50, 100, 500 })" RowsPerPageString="Zeilen pro Seite" />
            </PagerContent>
        </MudDataGrid>
    </MudTabPanel>

    <MudTabPanel Text="@($"Benutzer ({_computer.LocalUsers.Count})")">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Lokale Administratoren</MudText>
                <MudDataGrid T="ComputerLocalAdmin" Items="_computer.LocalAdmins" Dense="true" Hover="true" SortMode="SortMode.None">
                    <Columns>
                        <PropertyColumn Property="a => a.Name" Title="Mitglied" />
                        <TemplateColumn Title="Art"><CellTemplate>@(context.Item.IsGroup ? "Gruppe" : "Benutzer")</CellTemplate></TemplateColumn>
                    </Columns>
                </MudDataGrid>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Lokale Benutzerkonten</MudText>
                <MudDataGrid T="ComputerLocalUser" Items="_computer.LocalUsers" Dense="true" Hover="true" SortMode="SortMode.None">
                    <Columns>
                        <PropertyColumn Property="u => u.Name" Title="Name" />
                        <TemplateColumn Title="Status">
                            <CellTemplate>
                                <MudChip T="string" Size="Size.Small" Color="@(context.Item.Disabled ? Color.Default : Color.Success)">@(context.Item.Disabled ? "deaktiviert" : "aktiv")</MudChip>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Beschreibung"><CellTemplate>@(context.Item.FullName ?? context.Item.Description)</CellTemplate></TemplateColumn>
                    </Columns>
                </MudDataGrid>
            </MudItem>
        </MudGrid>
    </MudTabPanel>

    <MudTabPanel Text="@($"Verlauf ({_changes.Count})")">
        @if (_changes.Count == 0)
        {
            <MudText Color="Color.Secondary">Noch keine Änderungen. Der erste Scan ist die Ausgangslage; ab dem zweiten wird festgehalten, was sich geändert hat.</MudText>
        }
        else
        {
            <ChangeGrid Changes="_changes" ShowComputer="false" />
        }
    </MudTabPanel>
</MudTabs>

@code {
    [Parameter] public int Id { get; set; }

    private Computer? _computer;
    private bool _loaded;
    private bool _scanning;
    private string _softwareSearch = "";
    private List<(InventoryChange Change, string Computer)> _changes = [];

    protected override async Task OnParametersSetAsync()
    {
        _computer = await ComputerService.GetDetailAsync(Id);
        _changes = await Store.ChangesAsync(Id);
        _loaded = true;
    }

    private async Task ScanAsync()
    {
        _scanning = true;
        try
        {
            await Audit.LogAsync("Inventar-Scan gestartet", _computer!.Name);
            var outcome = await ScanService.ScanAsync(Id);
            Snackbar.Add(outcome.Success ? "Scan abgeschlossen." : $"Scan fehlgeschlagen: {outcome.Error}", outcome.Success ? Severity.Success : Severity.Error);
            _computer = await ComputerService.GetDetailAsync(Id);
            _changes = await Store.ChangesAsync(Id);
        }
        finally
        {
            _scanning = false;
        }
    }

    private async Task RenameAsync()
    {
        try
        {
            var old = _computer!.Name;
            var name = await ComputerService.RenameToReportedAsync(Id);
            await Audit.LogAsync("Rechner umbenannt", $"{old} → {name}");
            Snackbar.Add($"Eintrag heißt jetzt {name}.", Severity.Success);
            _computer = await ComputerService.GetDetailAsync(Id);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private static RenderFragment Row(string label, string? value) => @<tr>
        <td style="width: 40%; color: var(--mud-palette-text-secondary)">@label</td>
        <td>@(string.IsNullOrWhiteSpace(value) ? "–" : value)</td>
    </tr>;
}
