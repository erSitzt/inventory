@page "/deployments"
@implements IDisposable
@inject DeploymentService DeploymentService
@inject IDialogService Dialogs
@inject IStringLocalizer<SharedResource> L
@inject Display Display

<PageTitle>@L["Deployments"] – Inventory</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h5">@L["Deployments"]</MudText>
    <MudSpacer />
    <OperatorOnly>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.RocketLaunch" OnClick="DeployAsync">@L["Deploy package"]</MudButton>
    </OperatorOnly>
</MudStack>

<MudDataGrid T="Deployment" Items="_deployments" Dense="true" Hover="true" SortMode="SortMode.None">
    <Columns>
        <TemplateColumn Title="@L["Package"]">
            <CellTemplate><MudLink Href="@($"deployments/{context.Item.Id}")">@context.Item.PackageName @context.Item.PackageVersion</MudLink></CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@L["Started"]">
            <CellTemplate>@Display.LocalTime(context.Item.CreatedUtc)</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@L["Status"]">
            <CellTemplate>
                @if (context.Item.FinishedUtc is null)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Info">@L["running"]</MudChip>
                }
                else if (context.Item.Targets.Any(t => t.Status == TargetStatus.WaitingReboot))
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Info">@L["waiting for restart"]</MudChip>
                }
                else if (context.Item.Targets.Any(t => t.Status == TargetStatus.WaitingUser))
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">@L["postponed by users"]</MudChip>
                }
                else if (context.Item.Targets.Any(t => t.Status == TargetStatus.WaitingOffline))
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">@L["waiting for offline computers"]</MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small">@L["finished"]</MudChip>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@L["Result"]">
            <CellTemplate>
                @{
                    var targets = context.Item.Targets;
                    var failed = targets.Count(t => t.Status is TargetStatus.Failed or TargetStatus.Cancelled);
                    var present = targets.Count(t => t.Status == TargetStatus.AlreadyInstalled);
                }
                <span>@L["{0} of {1} succeeded", targets.Count(t => t.Status.IsSuccess()), targets.Count]</span>
                @if (present > 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Inline="true"> · @L["{0} already installed", present]</MudText>
                }
                @if (failed > 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Error" Inline="true"> · @L["{0} failed", failed]</MudText>
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudText Class="pa-4">@L["No deployments yet. A package can be deployed here or directly from the package or computer list."]</MudText>
    </NoRecordsContent>
</MudDataGrid>

@code {
    private List<Deployment> _deployments = [];

    protected override async Task OnInitializedAsync()
    {
        _deployments = await DeploymentService.ListAsync();
        DeploymentService.Changed += OnChanged;
    }

    private void OnChanged(int _) => InvokeAsync(async () =>
    {
        _deployments = await DeploymentService.ListAsync();
        StateHasChanged();
    });

    private Task DeployAsync() =>
        Dialogs.ShowAsync<DeployDialog>(L["Deploy package"], new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });

    public void Dispose() => DeploymentService.Changed -= OnChanged;
}
