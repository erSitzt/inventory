@page "/library"
@inject CatalogService Catalog
@inject Auditor Audit
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject Display Display
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Package library"] – Inventory</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
    <MudText Typo="Typo.h5">@L["Package library"]</MudText>
    <MudSpacer />
    <MudTextField T="string" Value="_search" ValueChanged="SearchAsync" Placeholder="@L["Search program, publisher or tag"]" Adornment="Adornment.Start" Immediate="true"
                  DebounceInterval="350" Clearable="true" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 360px" />
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" Disabled="_busy" OnClick="@(() => ReloadAsync(force: true))">@L["Reload"]</MudButton>
</MudStack>

<MudText Typo="Typo.body2" Class="mb-4">
    @L["Ready-made packages of common programs with verified download address and silent parameters. On import the server downloads the setup directly from the vendor and checks it against the checksum from the catalog. The catalog is generated daily from the manifests of the winget repository"]@(Catalog.Current?.Generated is { } generated ? $" ({L["as of {0}", Display.LocalTime(generated)]})" : "").
    @if (Catalog.IndexAvailable)
    {
        <span> @L["The list shows a base selection of common programs; the search additionally finds all other programs from winget."]</span>
    }
</MudText>

@if (Catalog.LastError is not null)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">@Catalog.LastError</MudAlert>
}
@if (_busyText is not null)
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">@_busyText</MudAlert>
}

<MudDataGrid T="CatalogItem" Items="_items" Dense="true" Hover="true" SortMode="SortMode.Single" RowsPerPage="50" Loading="_busy"
             QuickFilter="@(i => string.IsNullOrWhiteSpace(_search) || i.Entry.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) || (i.Entry.Publisher?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) || i.Entry.Tags.Any(t => t.Contains(_search, StringComparison.OrdinalIgnoreCase)))">
    <Columns>
        <HierarchyColumn T="CatalogItem" />
        <TemplateColumn Title="@L["Program"]" SortBy="i => i.Entry.Name" CellStyle="min-width: 300px">
            <CellTemplate>
                <MudText Typo="Typo.body2">
                    <b>@context.Item.Entry.Name</b>
                    @if (!context.Item.Curated)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Warning">@L["from winget search"]</MudChip>
                    }
                </MudText>
                <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary)">@context.Item.Entry.Description</MudText>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@L["Publisher"]" SortBy="i => i.Entry.Publisher">
            <CellTemplate>@context.Item.Entry.Publisher</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@L["Version"]" Sortable="false">
            <CellTemplate>@context.Item.Entry.Version</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Setup" SortBy="i => Display.InstallerFormat(i.Entry.InstallerType) + i.Entry.InstallerType" CellStyle="white-space: nowrap">
            <CellTemplate>
                <CatalogSetupCell Entry="context.Item.Entry" />
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@L["Status"]" SortBy="i => i.Package == null ? 2 : i.UpdateAvailable ? 0 : 1">
            <CellTemplate>
                @if (context.Item.Package is null)
                {
                    <span>–</span>
                }
                else if (context.Item.UpdateAvailable)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">@L["imported {0} – newer available", context.Item.Package.Version]</MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success">@L["imported, up to date"]</MudChip>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@L["Keep up to date automatically"]" Sortable="false">
            <CellTemplate>
                @if (context.Item.Package is not null)
                {
                    <MudSwitch T="bool" Value="context.Item.Package.CatalogAutoUpdate" ValueChanged="@(on => SetAutoAsync(context.Item, on))" Color="Color.Primary" Size="Size.Small" />
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Sortable="false" CellStyle="width: 1%; white-space: nowrap">
            <CellTemplate>
                @if (context.Item.Package is null)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" Disabled="_busy" OnClick="@(() => ImportAsync(context.Item))">@L["Import"]</MudButton>
                }
                else
                {
                    @if (context.Item.UpdateAvailable)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="@(() => UpdateAsync(context.Item))">@L["Update"]</MudButton>
                    }
                    @if (Catalog.VersionsAvailable)
                    {
                        <MudTooltip Text="@L["Import an older version as a separate package"]">
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.History" Disabled="_busy" aria-label="@L["Import older version"]" OnClick="@(() => ImportAsync(context.Item))" />
                        </MudTooltip>
                    }
                    <MudButton Size="Size.Small" Href="@($"packages/{context.Item.Package.Id}")">@L["Open package"]</MudButton>
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <ChildRowContent>
        <CatalogEntryDetails Entry="context.Item.Entry" />
    </ChildRowContent>
    <NoRecordsContent>
        <MudText Class="pa-4">@(string.IsNullOrWhiteSpace(_search) ? L["The library is empty or unreachable. Source: {0}", Catalog.Location] : L["No match in the base selection."])</MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudDataGridPager T="CatalogItem" PageSizeOptions="@(new[] { 50, 100 })" RowsPerPageString="@L["Rows per page"]" />
    </PagerContent>
</MudDataGrid>

@if (Catalog.IndexAvailable && _search.Trim().Length >= 2)
{
    <MudText Typo="Typo.h6" Class="mt-6 mb-1">@L["More results from winget"]</MudText>
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
        @L["These entries are not part of the base selection and come unchanged from the winget manifests. The checksum secures the download, but only a test shows whether the silent parameters are right – try it on a single computer before deploying."]
    </MudAlert>
    @if (Catalog.IndexError is not null)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-2">@Catalog.IndexError</MudAlert>
    }
    <MudDataGrid T="CatalogItem" Items="_found" Dense="true" Hover="true" SortMode="SortMode.None" Loading="_searching">
        <Columns>
            <HierarchyColumn T="CatalogItem" />
            <TemplateColumn Title="@L["Program"]" CellStyle="min-width: 300px">
                <CellTemplate>
                    <MudText Typo="Typo.body2"><b>@context.Item.Entry.Name</b></MudText>
                    <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary)">@context.Item.Entry.Description</MudText>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="@L["Publisher"]">
                <CellTemplate>@context.Item.Entry.Publisher</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="@L["Version"]">
                <CellTemplate>@context.Item.Entry.Version</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Setup" CellStyle="white-space: nowrap">
                <CellTemplate>
                    <CatalogSetupCell Entry="context.Item.Entry" />
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn CellStyle="width: 1%; white-space: nowrap">
                <CellTemplate>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" Disabled="_busy" OnClick="@(() => ImportAsync(context.Item))">@L["Import"]</MudButton>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <ChildRowContent>
            <CatalogEntryDetails Entry="context.Item.Entry" />
        </ChildRowContent>
        <NoRecordsContent>
            <MudText Class="pa-4">@(_searching ? L["Searching …"] : L["No further match."])</MudText>
        </NoRecordsContent>
    </MudDataGrid>
    @if (_found.Count == SearchLimit)
    {
        <MudText Typo="Typo.caption" Class="mt-1" Style="display: block">@L["Only the first {0} matches – refine the search to see more.", SearchLimit]</MudText>
    }
    @if (Catalog.Index is { } index)
    {
        <MudText Typo="Typo.caption" Class="mt-1" Style="display: block">@L["Search index: {0} programs with an unattended installer", index.Packages.Count.ToString("N0")]@(index.Generated is { } indexDate ? $", {L["as of {0}", Display.LocalTime(indexDate)]}" : "").</MudText>
    }
}

<MudText Typo="Typo.caption" Class="mt-4" Style="display: block">
    @L["Tip: On import, a dynamic collection \"… outdated\" with all computers running an older version can be created. A schedule that regularly deploys the package to this collection keeps the program up to date everywhere."]
</MudText>

@code {
    private const int SearchLimit = 50;
    private List<CatalogItem> _items = [];
    private List<CatalogItem> _found = [];
    private bool _searching;
    private string _search = "";
    private bool _busy;
    private string? _busyText;

    protected override Task OnInitializedAsync() => ReloadAsync(force: false);

    private async Task SearchAsync(string? text)
    {
        _search = text ?? "";
        await FindAsync();
    }

    private async Task FindAsync()
    {
        var text = _search;
        _searching = true;
        StateHasChanged();
        var found = await Catalog.SearchAsync(text, SearchLimit);
        // Inzwischen weitergetippt: das Ergebnis der neueren Suche nicht überschreiben.
        if (text == _search)
        {
            _found = found;
            _searching = false;
        }
    }

    private async Task ReloadAsync(bool force)
    {
        _busy = true;
        try
        {
            if (force)
            {
                await Catalog.RefreshAsync(force: true);
                if (Catalog.Index is not null)
                    await Catalog.RefreshIndexAsync(force: true);
            }
            _items = await Catalog.ListAsync();
            await FindAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ImportAsync(CatalogItem item)
    {
        var parameters = new DialogParameters<ImportPackageDialog> { { d => d.Entry, item.Entry }, { d => d.Curated, item.Curated }, { d => d.OlderOnly, item.Package is not null } };
        var dialog = await Dialogs.ShowAsync<ImportPackageDialog>(L["Import {0}", item.Entry.Name], parameters, new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
        if (await dialog.Result is not { Canceled: false, Data: ImportPackageDialog.Choice choice })
            return;
        var version = choice.Version ?? item.Entry.Version;
        await RunAsync(L["Downloading {0} {1} from the vendor …", item.Entry.Name, version], async () =>
        {
            await Catalog.ImportAsync(item.Entry.Id, choice.AutoUpdate, choice.CreateCollection, await Audit.UserNameAsync(), choice.Version);
            Snackbar.Add(L["{0} {1} imported.", item.Entry.Name, version], Severity.Success);
        });
    }

    private Task UpdateAsync(CatalogItem item) => RunAsync(L["Downloading {0} {1} from the vendor …", item.Entry.Name, item.Entry.Version], async () =>
    {
        await Catalog.UpdateAsync(item.Package!.Id, await Audit.UserNameAsync());
        Snackbar.Add(L["{0} updated to {1}.", item.Package.Name, item.Entry.Version], Severity.Success);
    });

    private async Task SetAutoAsync(CatalogItem item, bool enabled)
    {
        await Catalog.SetAutoUpdateAsync(item.Package!.Id, enabled);
        await Audit.LogAsync(L["Package auto-update changed"], $"{item.Package.Name}: {Display.OnOff(enabled)}");
        _items = await Catalog.ListAsync();
    }

    private async Task RunAsync(string text, Func<Task> action)
    {
        _busy = true;
        _busyText = text;
        try
        {
            await action();
        }
        catch (Exception ex) when (ex is Inventory.Core.Abstractions.RemoteException or InvalidOperationException)
        {
            Snackbar.Add(ex.Message, Severity.Error, options => options.RequireInteraction = true);
        }
        finally
        {
            _busy = false;
            _busyText = null;
            _items = await Catalog.ListAsync();
            await FindAsync();
        }
    }
}
