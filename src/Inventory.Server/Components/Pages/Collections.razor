@page "/collections"
@inject CollectionService CollectionService
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> L
@inject Display Display
@inject Access Access
@inject Auditor Audit

<PageTitle>@L["Collections"] – Inventory</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h5">@L["Collections"]</MudText>
    <MudSpacer />
    <AdminOnly>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Folder" OnClick="@(() => EditAsync(null, false))">@L["Static collection"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FilterAlt" OnClick="@(() => EditAsync(null, true))">@L["Dynamic collection"]</MudButton>
    </AdminOnly>
</MudStack>

<MudText Typo="Typo.body2" Class="mb-4">
    @L["Static collections contain explicitly assigned computers (assigned from the computer list). Dynamic collections fill themselves through rules on the inventory data and are up to date after every scan."]
</MudText>

<MudDataGrid T="CollectionSummary" Items="_collections" Dense="true" Hover="true" SortMode="SortMode.None">
    <Columns>
        <TemplateColumn Title="@L["Name"]">
            <CellTemplate><MudLink Href="@($"computers?collection={context.Item.Collection.Id}")">@context.Item.Collection.Name</MudLink></CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@L["Type"]">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="@(context.Item.Collection.IsDynamic ? Color.Info : Color.Default)">
                    @(context.Item.Collection.IsDynamic ? L["dynamic"] : L["static"])
                </MudChip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@L["Maintenance window"]" Sortable="false">
            <CellTemplate>@(context.Item.Collection.MaintenanceWindow is { } window ? Display.Window(window) : "")</CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="c => c.Count" Title="@L["Computers"]" />
        <TemplateColumn Title="@L["Rules / description"]">
            <CellTemplate>
                @if (context.Item.Collection.IsDynamic)
                {
                    <span>@Describe(context.Item.Collection)</span>
                }
                else
                {
                    <span>@context.Item.Collection.Description</span>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn CellStyle="width: 1%; white-space: nowrap">
            <CellTemplate>
                <AdminOnly>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="@L["Edit"]" OnClick="@(() => EditAsync(context.Item.Collection, context.Item.Collection.IsDynamic))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" aria-label="@L["Delete"]" OnClick="@(() => DeleteAsync(context.Item.Collection))" />
                </AdminOnly>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudText Class="pa-4">@L["No collections yet."]</MudText>
    </NoRecordsContent>
</MudDataGrid>

@code {
    private List<CollectionSummary> _collections = [];

    protected override async Task OnInitializedAsync() => _collections = await CollectionService.ListAsync();

    private string Describe(Collection collection) =>
        string.Join(collection.MatchAll ? $" {L["AND"]} " : $" {L["OR"]} ", collection.Rules.Select(r =>
            $"{Display.Field(r.Field)} {Display.Operator(r.Operator)} „{r.Value}“" + (string.IsNullOrWhiteSpace(r.Value2) ? "" : $" (Version < {r.Value2})")));

    private async Task EditAsync(Collection? collection, bool isDynamic)
    {
        if (!await Access.DemandAdminAsync())
            return;
        var parameters = new DialogParameters<EditCollectionDialog>
        {
            { d => d.Collection, collection },
            { d => d.IsDynamic, isDynamic },
        };
        var title = collection?.Name ?? (isDynamic ? L["Dynamic collection"] : L["Static collection"]);
        var dialog = await Dialogs.ShowAsync<EditCollectionDialog>(title, parameters, new DialogOptions { FullWidth = true, MaxWidth = isDynamic ? MaxWidth.Medium : MaxWidth.Small });
        if (await dialog.Result is { Canceled: false })
            _collections = await CollectionService.ListAsync();
    }

    private async Task DeleteAsync(Collection collection)
    {
        if (!await Access.DemandAdminAsync())
            return;
        var confirmed = await Dialogs.ShowMessageBoxAsync(L["Delete collection"],
            L["Really delete \"{0}\"? The computers themselves are kept.", collection.Name], yesText: L["Delete"], cancelText: L["Cancel"]);
        if (confirmed != true)
            return;
        await CollectionService.DeleteAsync(collection.Id);
        await Audit.LogAsync(L["Collection deleted"], collection.Name);
        Snackbar.Add(L["Collection deleted."], Severity.Success);
        _collections = await CollectionService.ListAsync();
    }
}
