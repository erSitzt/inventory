@page "/virtualization"
@inject VirtualizationService Hosts
@inject HypervisorSyncService Hypervisors
@inject Auditor Audit
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> L
@inject Display Display
@inject Access Access

<PageTitle>@L["Virtualization"] – Inventory</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Wrap="Wrap.Wrap">
    <MudText Typo="Typo.h5">@L["Virtualization"]</MudText>
    <MudSpacer />
    <AdminOnly>
        <MudButton Variant="Variant.Text" Href="settings#virtualization">@L["Settings"]</MudButton>
    </AdminOnly>
</MudStack>

<MudText Typo="Typo.body2" Class="mb-2">
    @L["Physical hosts with their virtual machines: Hyper-V hosts from the inventory scan, ESXi hosts from the vCenter, XCP-ng hosts from the pool master. Each virtual machine is matched to its inventoried computer by the BIOS UUID, otherwise by its name."]
</MudText>
<div class="mb-3"></div>

<MudStack Row="true" Spacing="2" Class="mb-3" Wrap="Wrap.Wrap">
    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@L["Hosts"]: @_hosts.Count</MudChip>
    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@L["Clusters"]: @_hosts.Select(h => h.Cluster).Where(c => c is not null).Distinct(StringComparer.OrdinalIgnoreCase).Count()</MudChip>
    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@L["Virtual machines"]: @_hosts.Sum(h => h.VirtualMachines.Count)</MudChip>
    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success">@L["Inventoried"]: @_hosts.Sum(h => h.VirtualMachines.Count(v => v.GuestComputerId is not null))</MudChip>
    @if (_withoutHost.Count > 0)
    {
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" Icon="@Icons.Material.Filled.Warning">@L["Inventoried VMs without a known host"]: @_withoutHost.Count</MudChip>
    }
</MudStack>

@if (_hosts.Count == 0)
{
    <MudText Class="pa-4">@L["No hosts known yet. Hyper-V hosts appear after their next inventory scan; for VMware and XCP-ng, set up the connection under Settings."]</MudText>
}
@foreach (var platform in _hosts.GroupBy(PlatformOf).OrderBy(g => g.Key))
{
    <MudText Typo="Typo.h6" Class="mt-4 mb-2">@platform.Key</MudText>
    <MudExpansionPanels MultiExpansion="true" Elevation="0" Outlined="true">
        @foreach (var system in platform.GroupBy(h => (h.ManagerId, h.ManagerName, h.Source)).OrderBy(g => g.Key.ManagerName))
        {
            var hosts = system.ToList();
            var manager = system.Key.ManagerId is { } id ? _managers.FirstOrDefault(m => m.Id == id) : null;
            <MudExpansionPanel Expanded="true">
                <TitleContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="3">
                        <MudText Typo="Typo.subtitle1"><b>@(system.Key.ManagerName ?? "Hyper-V")</b></MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@(manager is null ? L["Hosts from the inventory scan"] : SourceName(system.Key.Source) + " · " + manager.Url)</MudText>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@L["Hosts"]: @hosts.Count</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@L["Clusters"]: @hosts.Select(h => h.Cluster).Where(c => c is not null).Distinct(StringComparer.OrdinalIgnoreCase).Count()</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@L["Virtual machines"]: @hosts.Sum(h => h.VirtualMachines.Count)</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success">@L["Inventoried"]: @hosts.Sum(h => h.VirtualMachines.Count(v => v.GuestComputerId is not null))</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@L["Cores"]: @hosts.Sum(h => h.CpuCores ?? 0)</MudChip>
                    </MudStack>
                    @if (manager?.LastRunUtc is not null)
                    {
                        <MudText Typo="Typo.caption" Class="d-block" Style="color: var(--mud-palette-text-secondary)">@L["Last run {0}: {1}", Display.LocalTime(manager.LastRunUtc), manager.LastResult ?? ""]</MudText>
                    }
                </TitleContent>
                <ChildContent>
                    @if (manager is not null)
                    {
                        <AdminOnly>
                            <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Sync" Disabled="_busy" Class="mb-2" OnClick="@(() => SyncAsync(manager))">@L["Synchronize now"]</MudButton>
                        </AdminOnly>
                    }
                    @foreach (var cluster in hosts.GroupBy(h => h.Cluster ?? "").OrderBy(g => g.Key == "").ThenBy(g => g.Key, StringComparer.OrdinalIgnoreCase))
                    {
                        <MudText Typo="Typo.subtitle2" Class="mt-2 mb-1">
                            @(cluster.Key == "" ? L["Without cluster"] : (system.Key.Source is VirtualHostSource.XcpNg or VirtualHostSource.XenOrchestra ? L["Pool {0}", cluster.Key] : L["Cluster {0}", cluster.Key]))
                            <span style="color: var(--mud-palette-text-secondary); font-weight: normal"> · @L["{0} hosts, {1} cores, {2} virtual machines", cluster.Count(), cluster.Sum(h => h.CpuCores ?? 0), cluster.Sum(h => h.VirtualMachines.Count)]</span>
                        </MudText>
                        <VirtualHostGrid Items="cluster.OrderBy(h => h.Name, StringComparer.OrdinalIgnoreCase).ToList()" />
                    }
                </ChildContent>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>
}

@if (_withoutHost.Count > 0)
{
    <MudText Typo="Typo.h6" Class="mt-6 mb-1">@L["Inventoried VMs without a known host"]</MudText>
    <MudText Typo="Typo.body2" Class="mb-2">
        @L["These computers are virtual machines, but neither a Hyper-V host nor the vCenter or XCP-ng lists them. The licence calculation cannot place them on a host."]
    </MudText>
    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
        @foreach (var computer in _withoutHost)
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Href="@($"computers/{computer.Id}")">@computer.Name</MudChip>
        }
    </MudStack>
}

@code {
    private List<VirtualHostView> _hosts = [];
    private List<Computer> _withoutHost = [];
    private List<HypervisorManager> _managers = [];
    private bool _busy;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _hosts = await Hosts.HostsAsync();
        _withoutHost = await Hosts.GuestsWithoutHostAsync();
        _managers = await Hypervisors.ListAsync();
    }

    private static string PlatformOf(VirtualHostView host) => host.Source switch
    {
        VirtualHostSource.VCenter => "VMware",
        VirtualHostSource.XcpNg or VirtualHostSource.XenOrchestra => "XCP-ng",
        _ => "Hyper-V",
    };

    private static string SourceName(VirtualHostSource source) => source switch
    {
        VirtualHostSource.VCenter => "vCenter",
        VirtualHostSource.XcpNg => "XCP-ng",
        VirtualHostSource.XenOrchestra => "Xen Orchestra",
        _ => "Hyper-V",
    };

    private async Task SyncAsync(HypervisorManager manager)
    {
        if (!await Access.DemandAdminAsync())
            return;
        _busy = true;
        try
        {
            var result = await Hypervisors.SyncAsync(manager.Id);
            await Audit.LogAsync(L["{0} synchronized", HypervisorSyncService.Name(manager.Kind)], $"{manager.Name}: {result.Hosts} hosts, {result.VirtualMachines} virtual machines, {result.Matched} matched");
            Snackbar.Add($"{manager.Name}: " + L["{0} hosts in {1} clusters, {2} virtual machines, {3} of them matched to inventoried computers.", result.Hosts, result.Clusters, result.VirtualMachines, result.Matched], Severity.Success);
        }
        catch (Inventory.Core.Abstractions.RemoteException ex)
        {
            Snackbar.Add($"{manager.Name}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
            await LoadAsync();
        }
    }
}
