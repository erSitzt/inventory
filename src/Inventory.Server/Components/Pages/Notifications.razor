@page "/notifications"
@attribute [Authorize(Policy = AccessControl.AdminPolicy)]
@inject NotificationService Channels
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject Auditor Audit
@inject Display Display
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Notifications"] – Inventory</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h5">@L["Notifications"]</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => EditAsync(null))">@L["Add"]</MudButton>
</MudStack>

<MudText Typo="Typo.body2" Class="mb-4">
    @L["Channels through which the server sends messages: e-mail to a list of recipients, or a webhook (Microsoft Teams, Slack, or any service that accepts JSON). Webhook addresses are stored encrypted and never shown again."]
</MudText>

<MudDataGrid T="NotificationChannel" Items="_channels" Dense="true" Hover="true" SortMode="SortMode.None">
    <Columns>
        <PropertyColumn Property="c => c.Name" Title="@L["Name"]" />
        <TemplateColumn Title="@L["Type"]">
            <CellTemplate>@Display.Channel(context.Item)</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@L["Target"]">
            <CellTemplate>@(context.Item.Kind == NotificationKind.Email ? context.Item.Recipients : L["(stored address)"])</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@L["Status"]">
            <CellTemplate>
                @if (!context.Item.Enabled)
                {
                    <MudChip T="string" Size="Size.Small">@L["off"]</MudChip>
                }
                else if (context.Item.LastError is not null)
                {
                    <MudTooltip Text="@context.Item.LastError">
                        <MudChip T="string" Size="Size.Small" Color="Color.Error">@L["Last attempt failed"]</MudChip>
                    </MudTooltip>
                }
                else if (context.Item.LastSentUtc is not null)
                {
                    <MudText Typo="Typo.body2">@L["Last sent {0}", Display.LocalTime(context.Item.LastSentUtc)]</MudText>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn CellStyle="width: 1%; white-space: nowrap">
            <CellTemplate>
                <MudButton Size="Size.Small" Disabled="@(_testing == context.Item.Id)" OnClick="@(() => TestAsync(context.Item))">@L["Send test"]</MudButton>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="@L["Edit"]" OnClick="@(() => EditAsync(context.Item))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" aria-label="@L["Delete"]" OnClick="@(() => DeleteAsync(context.Item))" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudText Class="pa-4">@L["No channels set up yet."]</MudText>
    </NoRecordsContent>
</MudDataGrid>

@code {
    private List<NotificationChannel> _channels = [];
    private int? _testing;

    protected override async Task OnInitializedAsync() => _channels = await Channels.ListAsync();

    private async Task EditAsync(NotificationChannel? channel)
    {
        var parameters = new DialogParameters<EditNotificationChannelDialog> { { d => d.Channel, channel } };
        var dialog = await Dialogs.ShowAsync<EditNotificationChannelDialog>(channel?.Name ?? L["Add channel"], parameters,
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
        if (await dialog.Result is { Canceled: false })
            _channels = await Channels.ListAsync();
    }

    private async Task TestAsync(NotificationChannel channel)
    {
        _testing = channel.Id;
        try
        {
            var result = await Channels.TestAsync(channel.Id);
            if (result.Error is null)
                Snackbar.Add(L["Test message sent via \"{0}\".", channel.Name], Severity.Success);
            else
                Snackbar.Add(L["Sending via \"{0}\" failed: {1}", channel.Name, result.Error], Severity.Error);
        }
        finally
        {
            _testing = null;
        }
        _channels = await Channels.ListAsync();
    }

    private async Task DeleteAsync(NotificationChannel channel)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(L["Delete channel"], L["Really delete \"{0}\"?", channel.Name],
            yesText: L["Delete"], cancelText: L["Cancel"]);
        if (confirmed != true)
            return;
        await Channels.DeleteAsync(channel.Id);
        await Audit.LogAsync(L["Notification channel deleted"], channel.Name);
        _channels = await Channels.ListAsync();
    }
}
