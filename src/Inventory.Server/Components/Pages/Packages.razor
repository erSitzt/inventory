@page "/packages"
@inject PackageService PackageService
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject Auditor Audit
@inject IStringLocalizer<SharedResource> L
@inject Display Display

<PageTitle>@L["Packages"] – Inventory</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h5">@L["Packages"]</MudText>
    <MudSpacer />
    <AdminOnly>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAsync">@L["New package"]</MudButton>
    </AdminOnly>
</MudStack>

<MudDataGrid T="Package" Items="_packages" Dense="true" Hover="true" SortMode="SortMode.Single">
    <Columns>
        <TemplateColumn Title="@L["Name"]" SortBy="p => p.Name">
            <CellTemplate><MudLink Href="@($"packages/{context.Item.Id}")">@context.Item.Name</MudLink></CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="p => p.Version" Title="@L["Version"]" />
        <TemplateColumn Title="@L["Steps"]" SortBy="p => p.Steps.Count">
            <CellTemplate>@context.Item.Steps.Count</CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="p => p.Description" Title="@L["Description"]" />
        <TemplateColumn Title="@L["Modified"]" SortBy="p => p.ModifiedUtc">
            <CellTemplate>@Display.LocalTime(context.Item.ModifiedUtc)</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Sortable="false" CellStyle="width: 1%; white-space: nowrap">
            <CellTemplate>
                <OperatorOnly>
                    <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.RocketLaunch" Disabled="@(context.Item.Steps.Count == 0)"
                               OnClick="@(() => DeployAsync(context.Item))">@L["Deploy"]</MudButton>
                </OperatorOnly>
                <AdminOnly>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" aria-label="@L["Delete"]" OnClick="@(() => DeleteAsync(context.Item))" />
                </AdminOnly>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudText Class="pa-4">@L["No packages yet. A package consists of one or more steps, e.g. installation, command and reboot."]</MudText>
    </NoRecordsContent>
</MudDataGrid>

@code {
    private List<Package> _packages = [];

    protected override async Task OnInitializedAsync() => _packages = await PackageService.ListAsync();

    private async Task CreateAsync()
    {
        var dialog = await Dialogs.ShowAsync<NameDialog>(L["New package"], new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.ExtraSmall });
        if (await dialog.Result is not { Canceled: false, Data: string name })
            return;
        try
        {
            var package = await PackageService.SaveAsync(null, name, null, null);
            Navigation.NavigateTo($"packages/{package.Id}");
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateException)
        {
            Snackbar.Add(L["A package named \"{0}\" already exists.", name.Trim()], Severity.Error);
        }
    }

    private async Task DeployAsync(Package package)
    {
        var parameters = new DialogParameters<DeployDialog> { { d => d.PackageId, package.Id } };
        await Dialogs.ShowAsync<DeployDialog>(L["Deploy \"{0}\"", package.Name], parameters, new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
    }

    private async Task DeleteAsync(Package package)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(L["Delete package"],
            L["Really delete \"{0}\" including its files? Packages that embed it lose the corresponding step. Past deployments remain in the history.", package.Name],
            yesText: L["Delete"], cancelText: L["Cancel"]);
        if (confirmed != true)
            return;
        await PackageService.DeleteAsync(package.Id);
        await Audit.LogAsync(L["Package deleted"], package.Name);
        Snackbar.Add(L["Package deleted."], Severity.Success);
        _packages = await PackageService.ListAsync();
    }
}
