@page "/tokens"
@attribute [Authorize(Policy = AccessControl.AdminPolicy)]
@inject ApiTokenService TokenService
@inject Auditor Audit
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject Display Display
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["API tokens"] – Inventory</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h5">@L["API tokens"]</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAsync">@L["New token"]</MudButton>
</MudStack>

<MudText Typo="Typo.body2" Class="mb-4">
    @L["For scripts and other programs that use the REST API without a browser login. A token has full access to the API – like a signed-in user. Example call:"]
    <code>curl -H "Authorization: Bearer inv_…" @(Navigation.BaseUri)api/computers</code>
</MudText>

@if (_created is not null)
{
    <MudAlert Severity="Severity.Success" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="@(() => _created = null)">
        <b>@L["Token created – copy it now."]</b> @L["It is shown only this once and cannot be retrieved later."]
        <pre class="run-output mt-2" style="user-select: all">@_created</pre>
    </MudAlert>
}

<MudDataGrid T="ApiToken" Items="_tokens" Dense="true" Hover="true" SortMode="SortMode.None">
    <Columns>
        <PropertyColumn Property="t => t.Name" Title="@L["Name"]" />
        <TemplateColumn Title="Token"><CellTemplate><code>@(context.Item.Prefix)…</code></CellTemplate></TemplateColumn>
        <TemplateColumn Title="@L["Role"]"><CellTemplate>@Display.Role(context.Item.Role)</CellTemplate></TemplateColumn>
        <PropertyColumn Property="t => t.CreatedBy" Title="@L["Created by"]" />
        <TemplateColumn Title="@L["Created"]"><CellTemplate>@Display.LocalTime(context.Item.CreatedUtc)</CellTemplate></TemplateColumn>
        <TemplateColumn Title="@L["Valid until"]">
            <CellTemplate>
                @if (context.Item.ExpiresUtc is null)
                {
                    <span>@L["unlimited"]</span>
                }
                else if (context.Item.ExpiresUtc < DateTime.UtcNow)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Error">@L["expired"]</MudChip>
                }
                else
                {
                    @Display.LocalTime(context.Item.ExpiresUtc)
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@L["Last used"]"><CellTemplate>@Display.LocalTime(context.Item.LastUsedUtc)</CellTemplate></TemplateColumn>
        <TemplateColumn CellStyle="width: 1%">
            <CellTemplate>
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" aria-label="@L["Revoke token"]" OnClick="@(() => DeleteAsync(context.Item))" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudText Class="pa-4">@L["No tokens yet."]</MudText>
    </NoRecordsContent>
</MudDataGrid>

@code {
    private List<ApiToken> _tokens = [];
    private string? _created;

    protected override async Task OnInitializedAsync() => _tokens = await TokenService.ListAsync();

    private async Task CreateAsync()
    {
        var dialog = await Dialogs.ShowAsync<CreateTokenDialog>(L["New API token"], new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.ExtraSmall });
        if (await dialog.Result is not { Canceled: false, Data: CreateTokenDialog.Request request })
            return;
        var expires = request.Days is { } days ? DateTime.UtcNow.AddDays(days) : (DateTime?)null;
        _created = await TokenService.CreateAsync(request.Name, await Audit.UserNameAsync(), expires, role: request.Role);
        await Audit.LogAsync(L["API token created"], $"{request.Name}, {(request.Days is null ? L["valid without limit"] : L["valid {0} days", request.Days])}");
        _tokens = await TokenService.ListAsync();
    }

    private async Task DeleteAsync(ApiToken token)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(L["Revoke token"],
            L["Really revoke \"{0}\"? Scripts using it lose access immediately.", token.Name], yesText: L["Revoke"], cancelText: L["Cancel"]);
        if (confirmed != true)
            return;
        await TokenService.DeleteAsync(token.Id);
        await Audit.LogAsync(L["API token revoked"], token.Name);
        Snackbar.Add(L["Token revoked."], Severity.Success);
        _tokens = await TokenService.ListAsync();
    }
}
