@inject BrowserTime BrowserTime

<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        @* Prüft die [Authorize]-Angaben der Seiten auch bei der Navigation innerhalb der laufenden Sitzung. *@
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                <NoPermission />
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>

@code {
    /// <summary>Zeitzone des Browsers aus dem Cookie (siehe App.razor).</summary>
    [Parameter] public string? TimeZone { get; set; }

    protected override void OnParametersSet() => BrowserTime.Set(TimeZone);
}
