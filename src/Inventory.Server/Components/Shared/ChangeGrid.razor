<MudDataGrid T="(InventoryChange Change, string Computer)" Items="Changes" Dense="true" Hover="true" SortMode="SortMode.None" RowsPerPage="50" QuickFilter="Matches">
    <Columns>
        <TemplateColumn Title="Zeit" CellStyle="white-space: nowrap">
            <CellTemplate>@Display.LocalTime(context.Item.Change.TimeUtc)</CellTemplate>
        </TemplateColumn>
        @if (ShowComputer)
        {
            <TemplateColumn Title="Rechner">
                <CellTemplate><MudLink Href="@($"computers/{context.Item.Change.ComputerId}")">@context.Item.Computer</MudLink></CellTemplate>
            </TemplateColumn>
        }
        <TemplateColumn Title="Bereich">
            <CellTemplate>@context.Item.Change.Category</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Art">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="@Display.ChangeColor(context.Item.Change.Kind)">@Display.Change(context.Item.Change.Kind)</MudChip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Eintrag">
            <CellTemplate>@context.Item.Change.Item</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Wert">
            <CellTemplate>@Display.ChangeValues(context.Item.Change)</CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="(InventoryChange Change, string Computer)" PageSizeOptions="@(new[] { 50, 100, 500 })" RowsPerPageString="Zeilen pro Seite" />
    </PagerContent>
</MudDataGrid>

@code {
    [Parameter, EditorRequired] public List<(InventoryChange Change, string Computer)> Changes { get; set; } = [];
    [Parameter] public bool ShowComputer { get; set; } = true;
    [Parameter] public string Search { get; set; } = "";

    private bool Matches((InventoryChange Change, string Computer) row) =>
        string.IsNullOrWhiteSpace(Search)
        || $"{row.Computer} {row.Change.Category} {row.Change.Item} {row.Change.OldValue} {row.Change.NewValue}".Contains(Search, StringComparison.OrdinalIgnoreCase);
}
