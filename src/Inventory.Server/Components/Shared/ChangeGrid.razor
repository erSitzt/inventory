@inject Display Display
@inject IStringLocalizer<SharedResource> L
<MudDataGrid T="(InventoryChange Change, string Computer)" Items="Changes" Dense="true" Hover="true" SortMode="SortMode.None" RowsPerPage="50" QuickFilter="Matches">
    <Columns>
        <TemplateColumn Title="@L["Time"]" CellStyle="white-space: nowrap">
            <CellTemplate>@Display.LocalTime(context.Item.Change.TimeUtc)</CellTemplate>
        </TemplateColumn>
        @if (ShowComputer)
        {
            <TemplateColumn Title="@L["Computer"]">
                <CellTemplate><MudLink Href="@($"computers/{context.Item.Change.ComputerId}")">@context.Item.Computer</MudLink></CellTemplate>
            </TemplateColumn>
        }
        <TemplateColumn Title="@L["Area"]">
            <CellTemplate>@L[context.Item.Change.Category]</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@L["Type"]">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="@Display.ChangeColor(context.Item.Change)">@Display.Change(context.Item.Change)</MudChip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@L["Item"]">
            <CellTemplate>@L[context.Item.Change.Item]</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@L["Value"]">
            <CellTemplate>@Display.ChangeValues(context.Item.Change, v => L[v])</CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="(InventoryChange Change, string Computer)" PageSizeOptions="@(new[] { 50, 100, 500 })" RowsPerPageString="@L["Rows per page"]" />
    </PagerContent>
</MudDataGrid>

@code {
    [Parameter, EditorRequired] public List<(InventoryChange Change, string Computer)> Changes { get; set; } = [];
    [Parameter] public bool ShowComputer { get; set; } = true;
    [Parameter] public string Search { get; set; } = "";

    private bool Matches((InventoryChange Change, string Computer) row) =>
        string.IsNullOrWhiteSpace(Search)
        || $"{row.Computer} {row.Change.Category} {row.Change.Item} {row.Change.OldValue} {row.Change.NewValue}".Contains(Search, StringComparison.OrdinalIgnoreCase);
}
