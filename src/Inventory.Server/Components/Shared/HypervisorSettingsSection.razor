@using Inventory.Core.Abstractions
@inject HypervisorSyncService Hypervisors
@inject Auditor Audit
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> L
@inject Display Display
@inject Access Access

@* Ein Abschnitt der Einstellungen je Virtualisierungsverwaltung (vCenter, XCP-ng): Adresse, Konto, Zertifikat, Abgleich. *@
<MudPaper id="@Anchor" Class="pa-4 mt-4" Style="max-width: 640px" Outlined="true">
    <MudStack Spacing="3">
        <MudText Typo="Typo.h6">@Title</MudText>
        <MudText Typo="Typo.body2">@Description</MudText>
        <MudSwitch T="bool" @bind-Value="_enabled" Color="Color.Primary" Label="@L["Synchronize regularly"]" />
        <MudTextField @bind-Value="_url" Label="@AddressLabel" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="@Placeholder" />
        <MudSelect T="int?" @bind-Value="_credentialId" Label="@L["Credentials"]" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" HelperText="@AccountHint">
            @foreach (var credential in Credentials)
            {
                <MudSelectItem T="int?" Value="@credential.Id">@credential.Name (@credential.Username)</MudSelectItem>
            }
        </MudSelect>
        <MudTextField @bind-Value="_thumbprint" Label="@L["Certificate thumbprint (SHA-256)"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                      HelperText="@L["Only for a certificate Windows does not trust (self-signed). The error message of a failed run shows the thumbprint of the certificate offered."]" />
        <MudNumericField T="int" @bind-Value="_intervalHours" Label="@L["Interval (hours)"]" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="168" />
        <MudStack Row="true" Wrap="Wrap.Wrap">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">@L["Save"]</MudButton>
            <MudButton Variant="Variant.Outlined" Disabled="_busy" OnClick="SyncAsync">@L["Synchronize now"]</MudButton>
            <MudButton Variant="Variant.Text" Href="virtualization">@L["Show hosts and virtual machines"]</MudButton>
        </MudStack>
        @if (_message is not null)
        {
            <MudAlert Severity="@_severity" Dense="true">@_message</MudAlert>
        }
        @if (_lastResult is not null)
        {
            <MudText Typo="Typo.caption">@L["Last run {0}: {1}", Display.LocalTime(_lastRunUtc), _lastResult]</MudText>
        }
    </MudStack>
</MudPaper>

@code {
    [Parameter, EditorRequired] public HypervisorKind Kind { get; set; }
    [Parameter, EditorRequired] public string Anchor { get; set; } = "";
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public string Description { get; set; } = "";
    [Parameter, EditorRequired] public string AddressLabel { get; set; } = "";
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? AccountHint { get; set; }
    [Parameter] public IReadOnlyList<Credential> Credentials { get; set; } = [];

    private bool _enabled;
    private string? _url;
    private int? _credentialId;
    private string? _thumbprint;
    private int _intervalHours = HypervisorSyncService.DefaultIntervalHours;
    private DateTime? _lastRunUtc;
    private string? _lastResult;
    private string? _message;
    private Severity _severity;
    private bool _busy;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var current = await Hypervisors.GetSettingsAsync(Kind);
        (_enabled, _url, _credentialId, _thumbprint, _intervalHours, _lastRunUtc, _lastResult) =
            (current.Enabled, current.Url, current.CredentialId, current.Thumbprint, current.IntervalHours, current.LastRunUtc, current.LastResult);
    }

    /// <returns>false, wenn die Eingaben ungültig sind; die Meldung steht dann unter dem Abschnitt.</returns>
    private async Task<bool> StoreAsync()
    {
        try
        {
            await Hypervisors.SaveSettingsAsync(Kind, _enabled, _url, _credentialId, _thumbprint, _intervalHours);
            return true;
        }
        catch (ArgumentException ex)
        {
            (_message, _severity) = (ex.Message, Severity.Error);
            return false;
        }
    }

    private async Task SaveAsync()
    {
        if (!await Access.DemandAdminAsync() || !await StoreAsync())
            return;
        _message = null;
        await Audit.LogAsync(L["Setting changed"], L["{0} synchronization: {1}, {2}, every {3} h", HypervisorSyncService.Name(Kind), Display.OnOff(_enabled), _url ?? "–", _intervalHours]);
        await LoadAsync();
        Snackbar.Add(L["Saved."], Severity.Success);
    }

    /// <summary>Speichert zuerst, damit der Abgleich mit den gerade angezeigten Werten läuft.</summary>
    private async Task SyncAsync()
    {
        if (!await Access.DemandAdminAsync())
            return;
        _busy = true;
        _message = null;
        try
        {
            if (!await StoreAsync())
                return;
            var result = await Hypervisors.SyncAsync(Kind);
            await Audit.LogAsync(L["{0} synchronized", HypervisorSyncService.Name(Kind)], $"{result.Hosts} hosts, {result.VirtualMachines} virtual machines, {result.Matched} matched");
            (_message, _severity) = (L["{0} hosts in {1} clusters, {2} virtual machines, {3} of them matched to inventoried computers.", result.Hosts, result.Clusters, result.VirtualMachines, result.Matched].Value
                + (result.Version is null ? "" : $" ({result.Version})"), Severity.Success);
        }
        catch (RemoteException ex)
        {
            (_message, _severity) = (ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
            await LoadAsync();
        }
    }
}
