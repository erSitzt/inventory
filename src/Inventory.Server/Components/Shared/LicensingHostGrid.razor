@using Inventory.Core.Licensing
@inject IStringLocalizer<SharedResource> L
@inject LicensingService Service

@* Hosts bzw. Server mit der gewählten Lizenzierung; aufgeklappt die Entscheidung mit Begründung, die verglichenen Varianten, die gezählten VMs
   und – eingeklappt – die nicht gezählten VMs und der Rechenweg Schritt für Schritt. *@
<MudDataGrid T="HostLicensing" Items="Items" Dense="true" Hover="true" SortMode="SortMode.Single">
    <Columns>
        <HierarchyColumn T="HostLicensing" />
        <TemplateColumn Title="@HostTitle" SortBy="h => h.Host.Name">
            <CellTemplate>
                @if (context.Item.Host.ComputerId is { } id)
                {
                    <MudLink Href="@($"computers/{id}")">@context.Item.Host.Name</MudLink>
                }
                else
                {
                    @context.Item.Host.Name
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@L["Cluster"]" SortBy="h => h.Host.Cluster"><CellTemplate>@context.Item.Host.Cluster</CellTemplate></TemplateColumn>
        <TemplateColumn Title="@L["Source"]" SortBy="h => h.Host.Source"><CellTemplate>@SourceName(context.Item.Host.Source)</CellTemplate></TemplateColumn>
        <TemplateColumn Title="@VmTitle" SortBy="h => h.VmsOnHost" CellStyle="text-align: right">
            <CellTemplate>
                @context.Item.VmsOnHost
                @if (context.Item.WindowsVms != context.Item.VmsOnHost)
                {
                    <MudTooltip Text="@L["The host is licensed for {0} VMs of its cluster, since they may move to it.", context.Item.WindowsVms]">
                        <span style="color: var(--mud-palette-text-secondary)">&nbsp;/ @context.Item.WindowsVms</span>
                    </MudTooltip>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@L["Licensed with"]" SortBy="h => h.Chosen == null ? null : h.Chosen.Product">
            <CellTemplate>
                @if (context.Item.Chosen is { } chosen)
                {
                    <span>@string.Join(" + ", chosen.Parts.Select(p => ProductName(p.Product) + ": " + L["{0} cores", p.Cores]))</span>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@(context.Item.Variants.Count == 0 && context.Item.WindowsVms == 0 ? EmptyLabel : L["not calculable"])</MudText>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@L["Cost"]" SortBy="h => h.Chosen == null ? 0 : h.Chosen.Cost" CellStyle="text-align: right">
            <CellTemplate>@(context.Item.Chosen?.Cost.ToString("N0"))</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@L["Still to buy"]" SortBy="h => h.AdditionalCost ?? 0" CellStyle="text-align: right">
            <CellTemplate>@(context.Item.AdditionalCost?.ToString("N0"))</CellTemplate>
        </TemplateColumn>
    </Columns>
    <ChildRowContent>
        @{
            var item = context.Item;
            var counted = item.Host.VirtualMachines.Where(v => v.Counts).ToList();
            var ignored = item.Host.VirtualMachines.Where(v => !v.Counts).ToList();
        }
        <div class="pa-3">
            @* Zuerst das Ergebnis und warum: das ist die Frage, mit der man aufklappt. *@
            @if (item.Chosen is { } result)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    <div><b>@L["Licensed with {0}: {1} cores, {2:N0}; still to buy {3:N0}.", Label(result), result.Cores, result.Cost, item.AdditionalCost ?? 0]</b></div>
                    @foreach (var line in item.Decision)
                    {
                        <div>@Note(line)</div>
                    }
                </MudAlert>
            }
            else if (item.Variants.Count > 0)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">@L["No variant is allowed; the reasons are in the table."]</MudAlert>
            }

            @if (item.Variants.Count > 0)
            {
                <MudText Typo="Typo.subtitle2" Class="mb-1">@L["Variants compared"]</MudText>
                <MudSimpleTable Dense="true" Elevation="0" Outlined="true" Class="mb-3">
                    <thead>
                        <tr>
                            <th>@L["Variant"]</th><th>@L["How the cores come about"]</th><th style="text-align: right">@L["Cores"]</th>
                            <th style="text-align: right">@L["Cost"]</th><th style="text-align: right">@L["Still to buy"]</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var variant in item.Variants)
                        {
                            var isChosen = variant == item.Chosen;
                            <tr style="@(isChosen ? "font-weight: 600" : variant.Allowed ? "" : "color: var(--mud-palette-text-disabled)")">
                                <td>@Label(variant)</td>
                                <td>@(variant.Formula is { } formula ? Note(formula) : "")</td>
                                <td style="text-align: right">@variant.Cores</td>
                                <td style="text-align: right">@variant.Cost.ToString("N0")</td>
                                <td style="text-align: right">@(variant.Additional?.ToString("N0") ?? "–")</td>
                                <td>
                                    @if (isChosen)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.Check">@L["chosen"]</MudChip>
                                    }
                                    else if (!variant.Allowed)
                                    {
                                        @(variant.Reason is { } reason ? Note(reason) : L["not allowed"])
                                    }
                                    else if (item.Chosen?.Plan is { } plan && variant.Plan is not null && variant.Plan != plan && item.Mobile)
                                    {
                                        @L["other way of licensing than the rest of the cluster"]
                                    }
                                    else if (variant.Additional is { } additional && item.AdditionalCost is { } chosenAdditional && additional > chosenAdditional)
                                    {
                                        @L["{0:N0} more", additional - chosenAdditional]
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }

            @if (item.Notes.Count > 0)
            {
                <ul class="mb-3" style="padding-left: 1.2em">
                    @foreach (var note in item.Notes)
                    {
                        <li><MudText Typo="Typo.body2">@Note(note)</MudText></li>
                    }
                </ul>
            }

            @if (counted.Count > 0)
            {
                <MudText Typo="Typo.subtitle2" Class="mb-1">@L["Virtual machines counted on this host ({0})", counted.Count]</MudText>
                <MudSimpleTable Dense="true" Elevation="0" Outlined="true" Class="mb-1">
                    <thead><tr><th>@L["Name"]</th><th style="text-align: right">vCPU</th><th>@L["Operating system"]</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var vm in counted.OrderBy(v => v.Name, StringComparer.OrdinalIgnoreCase))
                        {
                            <tr>
                                <td>@VmName(vm)</td>
                                <td style="text-align: right">@vm.VirtualCpus</td>
                                <td>@vm.Os</td>
                                <td>@(vm.WindowsServer is null ? L["operating system unknown – counted to be safe"] : "")</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
            @if (item.Mobile && item.WindowsVms > counted.Count && item.Host.Cluster is { } cluster)
            {
                <MudText Typo="Typo.body2" Class="mb-3" Style="color: var(--mud-palette-text-secondary)">
                    @L["Plus {0} VMs on other hosts of cluster {1}, which may move here.", item.WindowsVms - counted.Count, cluster]
                </MudText>
            }

            @if (ignored.Count > 0 || item.Steps.Count > 0)
            {
                <MudExpansionPanels MultiExpansion="true" Elevation="0" Outlined="true" Class="mt-2">
                    @if (ignored.Count > 0)
                    {
                        <MudExpansionPanel Text="@L["Not counted ({0}): switched off or not Windows Server", ignored.Count]" Dense="true">
                            <MudSimpleTable Dense="true" Elevation="0">
                                <thead><tr><th>@L["Name"]</th><th style="text-align: right">vCPU</th><th>@L["Operating system"]</th><th>@L["Why not counted"]</th></tr></thead>
                                <tbody>
                                    @foreach (var vm in ignored.OrderBy(v => v.Name, StringComparer.OrdinalIgnoreCase))
                                    {
                                        <tr>
                                            <td>@VmName(vm)</td>
                                            <td style="text-align: right">@vm.VirtualCpus</td>
                                            <td>@vm.Os</td>
                                            <td>@(vm.Running ? L["no Windows Server"] : L["switched off"])</td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        </MudExpansionPanel>
                    }
                    @if (item.Steps.Count > 0)
                    {
                        <MudExpansionPanel Text="@L["Calculation step by step"]" Dense="true">
                            <ol style="padding-left: 1.4em">
                                @foreach (var step in item.Steps)
                                {
                                    <li><MudText Typo="Typo.body2">@Note(step)</MudText></li>
                                }
                            </ol>
                        </MudExpansionPanel>
                    }
                </MudExpansionPanels>
            }
        </div>
    </ChildRowContent>
    <NoRecordsContent>
        <MudText Class="pa-4">@EmptyText</MudText>
    </NoRecordsContent>
</MudDataGrid>
@if (Items.Any(h => h.Chosen is not null))
{
    var chosen = Items.Where(h => h.Chosen is not null).ToList();
    <MudPaper Outlined="true" Class="pa-3 mt-2">
        <MudStack Row="true" Spacing="6" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.body2"><b>@L["Total"]</b></MudText>
            @foreach (var product in chosen.SelectMany(h => h.Chosen!.Parts).GroupBy(p => p.Product))
            {
                <MudText Typo="Typo.body2">@ProductName(product.Key): <b>@L["{0} cores", product.Sum(p => p.Cores)]</b> · @product.Sum(p => p.Cost).ToString("N0")</MudText>
            }
            <MudText Typo="Typo.body2">@L["Cost"]: <b>@chosen.Sum(h => h.Chosen!.Cost).ToString("N0")</b></MudText>
            <MudText Typo="Typo.body2">@L["Still to buy"]: <b>@chosen.Sum(h => h.AdditionalCost ?? 0).ToString("N0")</b></MudText>
        </MudStack>
    </MudPaper>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<HostLicensing> Items { get; set; } = [];
    [Parameter, EditorRequired] public string HostTitle { get; set; } = "";
    [Parameter, EditorRequired] public string VmTitle { get; set; } = "";
    [Parameter, EditorRequired] public string EmptyText { get; set; } = "";
    /// <summary>Text, wenn ein Eintrag nichts braucht (z. B. ein Host ohne Windows-Server-Last).</summary>
    [Parameter] public string EmptyLabel { get; set; } = "";

    private string ProductName(string key) => L[Service.Rules.Product(key)?.Name ?? key];

    private string Note(LicensingNote note) => Service.Format(note);

    /// <summary>Name der Variante; bei mehreren Teilen (Editionen) jedes Produkt mit seinen Kernen.</summary>
    private string Label(LicenseVariant variant) => string.Join(" + ", variant.Parts.Select(p => ProductName(p.Product) + (variant.Parts.Count > 1 ? $" ({p.Cores})" : "")));

    private RenderFragment VmName(LicensingVm vm) => vm.ComputerId is { } id
        ? @<MudLink Href="@($"computers/{id}")" Typo="Typo.body2">@vm.Name</MudLink>
        : @<span>@vm.Name</span>;

    private string SourceName(string source) => source switch
    {
        "physical" => L["physical server"],
        "VM" => L["VM without known host"],
        _ => source,
    };
}
