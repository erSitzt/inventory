@inherits LayoutComponentBase
@inject UpdateService Updates

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@(() => _drawerOpen = !_drawerOpen)" />
        <MudText Typo="Typo.h6">Inventory</MudText>
        <MudSpacer />
        @if (Updates.UpdateAvailable)
        {
            <MudButton Href="settings#updates" Color="Color.Inherit" Variant="Variant.Outlined" Size="Size.Small" Class="mr-4"
                       StartIcon="@Icons.Material.Filled.SystemUpdateAlt">Version @Updates.Latest!.Version verfügbar</MudButton>
        }
        <AuthorizeView>
            <Authorized>
                <MudText Typo="Typo.body2">@context.User.Identity?.Name</MudText>
                @if (context.User.HasClaim(c => c.Type == AccessControl.AccessClaim))
                {
                    @* Nur bei Sitzungs-Anmeldung; die reine Windows-Anmeldung kennt kein Abmelden. *@
                    <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" Href="logout" aria-label="Abmelden" />
                }
            </Authorized>
        </AuthorizeView>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="1">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    Ein unerwarteter Fehler ist aufgetreten.
    <a href="." class="reload">Neu laden</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
}
