@inherits LayoutComponentBase
@inject UpdateService Updates
@inject Display Display
@inject IStringLocalizer<SharedResource> L
@inject NavigationManager Navigation
@inject IJSRuntime Js
@inject GuidedTour Tour
@implements IDisposable
@inject HelpDocs Docs

<MudThemeProvider @ref="_themeProvider" Theme="Theme" IsDarkMode="_dark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudTooltip Text="@L["Show or hide the menu"]">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" aria-label="@L["Show or hide the menu"]"
                           OnClick="@(() => _drawerOpen = !_drawerOpen)" />
        </MudTooltip>
        <MudText Typo="Typo.h6">Inventory</MudText>
        <MudSpacer />
        @if (Updates.UpdateAvailable)
        {
            <MudButton Href="settings#updates" Color="Color.Inherit" Variant="Variant.Outlined" Size="Size.Small" Class="mr-4"
                       StartIcon="@Icons.Material.Filled.SystemUpdateAlt">@L["Version {0} available", Updates.Latest!.Version]</MudButton>
        }
        <MudTooltip Text="@L["Help for this page"]">
            <MudIconButton Icon="@Icons.Material.Filled.HelpOutline" Color="Color.Inherit" data-tour="help" aria-label="@L["Help for this page"]" OnClick="@(() => _helpOpen = !_helpOpen)" />
        </MudTooltip>
        <MudMenu Icon="@ThemeIcon" Color="Color.Inherit" AriaLabel="@L["Appearance"]" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <MudMenuItem Icon="@Icons.Material.Filled.BrightnessAuto" Disabled="@(_preference == "system")" OnClick="@(() => SetThemeAsync("system"))">@L["System setting"]</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.LightMode" Disabled="@(_preference == "light")" OnClick="@(() => SetThemeAsync("light"))">@L["Light"]</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.DarkMode" Disabled="@(_preference == "dark")" OnClick="@(() => SetThemeAsync("dark"))">@L["Dark"]</MudMenuItem>
        </MudMenu>
        @if (AvailableLanguages.Count > 1)
        {
            <MudMenu Icon="@Icons.Material.Filled.Translate" Color="Color.Inherit" AriaLabel="@L["Language"]" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                @foreach (var (code, name) in AvailableLanguages)
                {
                    <MudMenuItem Disabled="@(code == System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName)" OnClick="@(() => Navigation.NavigateTo($"language/{code}", forceLoad: true))">@name</MudMenuItem>
                }
            </MudMenu>
        }
        @* Unabhängig von der Anmeldeart, auch ganz ohne Anmeldung; der Download selbst ist Administratoren vorbehalten. *@
        <AuthorizeView Policy="@AccessControl.AdminPolicy">
            <Authorized>
                <MudTooltip Text="@L["Download agent setup"]">
                    <MudIconButton Icon="@Icons.Material.Filled.Download" Color="Color.Inherit" Href="/download/agent-setup" Target="_blank" aria-label="@L["Download agent setup"]" />
                </MudTooltip>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView>
            <Authorized>
                <MudText Typo="Typo.body2">@context.User.Identity?.Name</MudText>
                @if (AccessControl.RoleOf(context.User) is AccessRole.Viewer or AccessRole.Operator)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="color: inherit; border-color: currentColor">@Display.Role(AccessControl.RoleOf(context.User))</MudChip>
                }
                @if (context.User.HasClaim(c => c.Type == AccessControl.AccessClaim))
                {
                    @* Nur bei Sitzungs-Anmeldung; die reine Windows-Anmeldung kennt kein Abmelden. *@
                    <MudTooltip Text="@L["Sign out"]"><MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" Href="logout" aria-label="@L["Sign out"]" /></MudTooltip>
                }
            </Authorized>
        </AuthorizeView>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="1">
        <NavMenu />
    </MudDrawer>
    <MudDrawer @bind-Open="_helpOpen" Anchor="Anchor.End" Variant="DrawerVariant.Temporary" Width="400px" Elevation="2">
        @if (_helpOpen)
        {
            var topic = HelpTopics.For(Navigation.ToBaseRelativePath(Navigation.Uri), L);
            <div class="pa-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.HelpOutline" Color="Color.Primary" />
                    <MudText Typo="Typo.h6">@topic.Title</MudText>
                    <MudSpacer />
                    <MudTooltip Text="@L["Close"]">
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" aria-label="@L["Close"]" OnClick="@(() => _helpOpen = false)" />
                    </MudTooltip>
                </MudStack>
                <MudText Typo="Typo.body1" Class="mb-3">@topic.Intro</MudText>
                <ul class="help-tips">
                    @foreach (var tip in topic.Tips)
                    {
                        <li><MudText Typo="Typo.body2">@tip</MudText></li>
                    }
                </ul>
                <MudDivider Class="my-4" />
                <MudText Typo="Typo.subtitle2" Class="mb-1">@L["How it fits together"]</MudText>
                <MudText Typo="Typo.body2" Class="mb-2">
                    @L["Computers are scanned and grouped into collections. A package describes what to install or change; a deployment brings it to computers once, a schedule regularly."]
                </MudText>
                <MudText Typo="Typo.body2">@L["Hover over a symbol to see what it does. Most fields explain themselves in the line below them."]</MudText>
                <MudStack Row="true" Spacing="2" Class="mt-4" Wrap="Wrap.Wrap">
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Tour" OnClick="StartTourAsync">@L["Take the tour"]</MudButton>
                    <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.MenuBook" Href="@Docs.Url(topic, System.Globalization.CultureInfo.CurrentUICulture)" Target="_blank">@L["Documentation"]</MudButton>
                </MudStack>
            </div>
        }
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    @L["An unexpected error occurred."]
    <a href="." class="reload">@L["Reload"]</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    // Hilfe zur aktuellen Seite; der Inhalt richtet sich bei jedem Öffnen nach der Adresse.
    private bool _helpOpen;

    // Hell/Dunkel: Vorgabe ist die Systemeinstellung des Browsers; eine eigene Wahl bleibt im Browser gespeichert.
    private MudThemeProvider _themeProvider = default!;
    private bool _dark;
    private bool _systemDark;
    private string _preference = "system";

    private string ThemeIcon => _preference switch
    {
        "light" => Icons.Material.Filled.LightMode,
        "dark" => Icons.Material.Filled.DarkMode,
        _ => Icons.Material.Filled.BrightnessAuto,
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        _systemDark = await _themeProvider.GetSystemDarkModeAsync();
        await _themeProvider.WatchSystemDarkModeAsync(OnSystemDarkModeChanged);
        try
        {
            _preference = await Js.InvokeAsync<string?>("localStorage.getItem", "inventory.theme") ?? "system";
        }
        catch (JSException)
        {
            // Ohne localStorage (privates Fenster, gesperrte Website-Daten) gilt die Systemeinstellung.
        }
        ApplyTheme();
        StateHasChanged();
        // Neue Benutzer bekommen die Tour einmal von selbst; danach startet sie über die Hilfe.
        await Tour.StartOnceAsync();
    }

    protected override void OnInitialized() => Tour.StartRequested += StartTourFromPageAsync;

    public void Dispose() => Tour.StartRequested -= StartTourFromPageAsync;

    private Task StartTourFromPageAsync() => InvokeAsync(StartTourAsync);

    private async Task StartTourAsync()
    {
        _helpOpen = false;
        _drawerOpen = true;
        StateHasChanged();
        // Erst zeichnen lassen, damit Menü offen und Hilfe zu ist, bevor die Tour Elemente sucht.
        await Task.Delay(300);
        await Tour.StartAsync();
    }

    private Task OnSystemDarkModeChanged(bool dark)
    {
        _systemDark = dark;
        ApplyTheme();
        return InvokeAsync(StateHasChanged);
    }

    private async Task SetThemeAsync(string preference)
    {
        _preference = preference;
        ApplyTheme();
        try
        {
            if (preference == "system")
                await Js.InvokeVoidAsync("localStorage.removeItem", "inventory.theme");
            else
                await Js.InvokeVoidAsync("localStorage.setItem", "inventory.theme", preference);
        }
        catch (JSException)
        {
        }
    }

    private void ApplyTheme() => _dark = _preference switch { "dark" => true, "light" => false, _ => _systemDark };

    private static readonly IReadOnlyList<(string Code, string Name)> AvailableLanguages = Languages.Available();

    /// <summary>Etwas wärmere Farben und rundere Kanten als der MudBlazor-Standard; alle Seiten erben das.</summary>
    private static readonly MudTheme Theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#4f46e5",
            Secondary = "#0ea5e9",
            Info = "#0284c7",
            Success = "#059669",
            Warning = "#d97706",
            Error = "#dc2626",
            Background = "#f5f6fa",
            AppbarBackground = "#1e1b4b",
            DrawerBackground = "#ffffff",
            Surface = "#ffffff",
            LinesDefault = "#e5e7eb",
            TextPrimary = "#111827",
            TextSecondary = "#6b7280",
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#818cf8",
            Secondary = "#38bdf8",
            Background = "#0f172a",
            Surface = "#1e293b",
            AppbarBackground = "#1e1b4b",
            DrawerBackground = "#111827",
            LinesDefault = "#334155",
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "10px" },
        Typography = new Typography { Default = new DefaultTypography { FontFamily = ["Segoe UI", "Inter", "Roboto", "Helvetica", "Arial", "sans-serif"] } },
    };
}
