<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Inventory.Contracts\Inventory.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Localization.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\oui.txt.gz" LogicalName="Inventory.Core.oui.txt.gz" />
    <!-- Lizenzregeln liegen versioniert im Repository (rules/microsoft) und werden in die Bibliothek eingebettet. -->
    <EmbeddedResource Include="..\..\rules\microsoft\*.json" LogicalName="Inventory.Core.Rules.%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
